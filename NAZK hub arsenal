-- ==================== ESP ENGINE ====================
local function WorldToViewport(pos)
    local s, v = pcall(function()
        return Camera:WorldToViewportPoint(pos)
    end)
    return s and v or nil
end

local function GetCharacterSize(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local min, max = hrp.Position, hrp.Position
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local cframe = part.CFrame
            local size = part.Size / 2
            local corners = {
                cframe * CFrame.new(size.X, size.Y, size.Z),
                cframe * CFrame.new(-size.X, size.Y, size.Z),
                cframe * CFrame.new(size.X, -size.Y, size.Z),
                cframe * CFrame.new(-size.X, -size.Y, size.Z),
                cframe * CFrame.new(size.X, size.Y, -size.Z),
                cframe * CFrame.new(-size.X, size.Y, -size.Z),
                cframe * CFrame.new(size.X, -size.Y, -size.Z),
                cframe * CFrame.new(-size.X, -size.Y, -size.Z),
            }
            for _, corner in ipairs(corners) do
                local p = corner.Position
                min = Vector3.new(math.min(min.X, p.X), math.min(min.Y, p.Y), math.min(min.Z, p.Z))
                max = Vector3.new(math.max(max.X, p.X), math.max(max.Y, p.Y), math.max(max.Z, p.Z))
            end
        end
    end
    return min, max
end

local function CreateESPObject(plr)
    if not hasDrawing then return nil end
    local obj = {
        Player = plr,
        Box2D = {},
        Box3D = {},
        Tracer = nil,
        Skeleton = {},
        Name = nil,
        Distance = nil,
        HealthBar = {},
    }

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1.5
        line.Color = ESP.Color
        table.insert(obj.Box2D, line)
    end

    for i = 1, 12 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        line.Color = ESP.Color
        table.insert(obj.Box3D, line)
    end

    obj.Tracer = Drawing.new("Line")
    obj.Tracer.Visible = false
    obj.Tracer.Thickness = 1.2
    obj.Tracer.Color = ESP.Color

    local skeletonConnections = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }
    for _, conn in ipairs(skeletonConnections) do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1.2
        line.Color = ESP.Color
        table.insert(obj.Skeleton, {Line = line, From = conn[1], To = conn[2]})
    end

    obj.Name = Drawing.new("Text")
    obj.Name.Visible = false
    obj.Name.Size = 13
    obj.Name.Color = ESP.Color
    obj.Name.Center = true
    obj.Name.Outline = true
    obj.Name.OutlineColor = ESP.OutlineColor

    obj.Distance = Drawing.new("Text")
    obj.Distance.Visible = false
    obj.Distance.Size = 11
    obj.Distance.Color = Theme.TextDim
    obj.Distance.Center = true
    obj.Distance.Outline = true
    obj.Distance.OutlineColor = ESP.OutlineColor

    obj.HealthBar.Bg = Drawing.new("Square")
    obj.HealthBar.Bg.Visible = false
    obj.HealthBar.Bg.Filled = true
    obj.HealthBar.Bg.Color = Color3.fromRGB(30, 30, 30)
    obj.HealthBar.Bg.Thickness = 1

    obj.HealthBar.Fill = Drawing.new("Square")
    obj.HealthBar.Fill.Visible = false
    obj.HealthBar.Fill.Filled = true
    obj.HealthBar.Fill.Color = Color3.fromRGB(80, 255, 140)
    obj.HealthBar.Fill.Thickness = 1

    ESPObjects[plr] = obj
    return obj
end

local function RemoveESPObject(plr)
    local obj = ESPObjects[plr]
    if not obj then return end
    for _, line in ipairs(obj.Box2D) do pcall(function() line:Remove() end) end
    for _, line in ipairs(obj.Box3D) do pcall(function() line:Remove() end) end
    if obj.Tracer then pcall(function() obj.Tracer:Remove() end) end
    for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line:Remove() end) end
    if obj.Name then pcall(function() obj.Name:Remove() end) end
    if obj.Distance then pcall(function() obj.Distance:Remove() end) end
    if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg:Remove() end) end
    if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill:Remove() end) end
    ESPObjects[plr] = nil
end

local function GetPartPosition(char, name)
    local part = char:FindFirstChild(name)
    if part then return part.Position end
    if name == "UpperTorso" then
        part = char:FindFirstChild("Torso")
        if part then return part.Position end
    end
    if name == "LowerTorso" then
        part = char:FindFirstChild("Torso")
        if part then return part.Position end
    end
    if name == "Head" then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position + Vector3.new(0, 2, 0) end
    end
    return nil
end

local function UpdateESP()
    if not ESP.Enabled or not hasDrawing then
        for _, obj in pairs(ESPObjects) do
            for _, line in ipairs(obj.Box2D) do pcall(function() line.Visible = false end) end
            for _, line in ipairs(obj.Box3D) do pcall(function() line.Visible = false end) end
            if obj.Tracer then pcall(function() obj.Tracer.Visible = false end) end
            for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line.Visible = false end) end
            if obj.Name then pcall(function() obj.Name.Visible = false end) end
            if obj.Distance then pcall(function() obj.Distance.Visible = false end) end
            if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg.Visible = false end) end
            if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill.Visible = false end) end
        end
        return
    end

    for plr, obj in pairs(ESPObjects) do
        if plr == player then continue end
        if not plr.Character then continue end
        local char = plr.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not head or not hum then continue end

        if ESP.TeamCheck and plr.Team == player.Team then
            for _, line in ipairs(obj.Box2D) do pcall(function() line.Visible = false end) end
            for _, line in ipairs(obj.Box3D) do pcall(function() line.Visible = false end) end
            if obj.Tracer then pcall(function() obj.Tracer.Visible = false end) end
            for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line.Visible = false end) end
            if obj.Name then pcall(function() obj.Name.Visible = false end) end
            if obj.Distance then pcall(function() obj.Distance.Visible = false end) end
            if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg.Visible = false end) end
            if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill.Visible = false end) end
            continue
        end

        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
        if dist > ESP.MaxDistance then
            for _, line in ipairs(obj.Box2D) do pcall(function() line.Visible = false end) end
            for _, line in ipairs(obj.Box3D) do pcall(function() line.Visible = false end) end
            if obj.Tracer then pcall(function() obj.Tracer.Visible = false end) end
            for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line.Visible = false end) end
            if obj.Name then pcall(function() obj.Name.Visible = false end) end
            if obj.Distance then pcall(function() obj.Distance.Visible = false end) end
            if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg.Visible = false end) end
            if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill.Visible = false end) end
            continue
        end

        local headPos = WorldToViewport(head.Position + Vector3.new(0, 0.5, 0))
        local footPos = WorldToViewport(hrp.Position - Vector3.new(0, 3, 0))
        if not headPos or not footPos or headPos.Z < 0 then
            for _, line in ipairs(obj.Box2D) do pcall(function() line.Visible = false end) end
            for _, line in ipairs(obj.Box3D) do pcall(function() line.Visible = false end) end
            if obj.Tracer then pcall(function() obj.Tracer.Visible = false end) end
            for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line.Visible = false end) end
            if obj.Name then pcall(function() obj.Name.Visible = false end) end
            if obj.Distance then pcall(function() obj.Distance.Visible = false end) end
            if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg.Visible = false end) end
            if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill.Visible = false end) end
            continue
        end

        local boxHeight = math.abs(headPos.Y - footPos.Y)
        local boxWidth = boxHeight * 0.6
        local boxTop = Vector2.new(headPos.X - boxWidth / 2, headPos.Y)
        local boxBottom = Vector2.new(footPos.X - boxWidth / 2, footPos.Y)

        if ESP.Box2D then
            local lines = obj.Box2D
            lines[1].From = boxTop
            lines[1].To = boxTop + Vector2.new(boxWidth, 0)
            lines[2].From = boxTop + Vector2.new(boxWidth, 0)
            lines[2].To = boxBottom + Vector2.new(boxWidth, 0)
            lines[3].From = boxBottom + Vector2.new(boxWidth, 0)
            lines[3].To = boxBottom
            lines[4].From = boxBottom
            lines[4].To = boxTop
            for _, line in ipairs(lines) do
                pcall(function() line.Visible = true; line.Color = ESP.Color end)
            end
        else
            for _, line in ipairs(obj.Box2D) do pcall(function() line.Visible = false end) end
        end

        if ESP.Box3D then
            local min, max = GetCharacterSize(char)
            if min and max then
                local corners = {
                    Vector3.new(min.X, min.Y, min.Z), Vector3.new(max.X, min.Y, min.Z),
                    Vector3.new(max.X, max.Y, min.Z), Vector3.new(min.X, max.Y, min.Z),
                    Vector3.new(min.X, min.Y, max.Z), Vector3.new(max.X, min.Y, max.Z),
                    Vector3.new(max.X, max.Y, max.Z), Vector3.new(min.X, max.Y, max.Z),
                }
                local screenCorners = {}
                for _, corner in ipairs(corners) do
                    local sp = WorldToViewport(corner)
                    table.insert(screenCorners, sp and Vector2.new(sp.X, sp.Y) or nil)
                end
                local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
                for i, edge in ipairs(edges) do
                    local from = screenCorners[edge[1]]
                    local to = screenCorners[edge[2]]
                    if from and to then
                        pcall(function()
                            obj.Box3D[i].From = from
                            obj.Box3D[i].To = to
                            obj.Box3D[i].Visible = true
                            obj.Box3D[i].Color = ESP.Color
                        end)
                    else
                        pcall(function() obj.Box3D[i].Visible = false end)
                    end
                end
            end
        else
            for _, line in ipairs(obj.Box3D) do pcall(function() line.Visible = false end) end
        end

        if ESP.Tracers then
            local screenSize = Camera.ViewportSize
            pcall(function()
                obj.Tracer.From = Vector2.new(screenSize.X / 2, screenSize.Y)
                obj.Tracer.To = Vector2.new(footPos.X, footPos.Y)
                obj.Tracer.Visible = true
                obj.Tracer.Color = ESP.Color
            end)
        else
            if obj.Tracer then pcall(function() obj.Tracer.Visible = false end) end
        end

        if ESP.Skeleton then
            for _, skel in ipairs(obj.Skeleton) do
                local fromPos = GetPartPosition(char, skel.From)
                local toPos = GetPartPosition(char, skel.To)
                if fromPos and toPos then
                    local fromScreen = WorldToViewport(fromPos)
                    local toScreen = WorldToViewport(toPos)
                    if fromScreen and toScreen and fromScreen.Z > 0 and toScreen.Z > 0 then
                        pcall(function()
                            skel.Line.From = Vector2.new(fromScreen.X, fromScreen.Y)
                            skel.Line.To = Vector2.new(toScreen.X, toScreen.Y)
                            skel.Line.Visible = true
                            skel.Line.Color = ESP.Color
                        end)
                    else
                        pcall(function() skel.Line.Visible = false end)
                    end
                else
                    pcall(function() skel.Line.Visible = false end)
                end
            end
        else
            for _, skel in ipairs(obj.Skeleton) do pcall(function() skel.Line.Visible = false end) end
        end

        if ESP.Names then
            pcall(function()
                obj.Name.Position = Vector2.new(headPos.X, headPos.Y - 18)
                obj.Name.Text = plr.DisplayName
                obj.Name.Visible = true
                obj.Name.Color = ESP.Color
            end)
        else
            if obj.Name then pcall(function() obj.Name.Visible = false end) end
        end

        if ESP.Distance then
            pcall(function()
                obj.Distance.Position = Vector2.new(footPos.X, footPos.Y + 5)
                obj.Distance.Text = math.floor(dist) .. "m"
                obj.Distance.Visible = true
            end)
        else
            if obj.Distance then pcall(function() obj.Distance.Visible = false end) end
        end

        if ESP.Health then
            local barX = boxTop.X - 6
            local barY = boxTop.Y
            local barW = 3
            local barH = boxHeight
            local healthPercent = hum.Health / hum.MaxHealth
            pcall(function()
                obj.HealthBar.Bg.Position = Vector2.new(barX, barY)
                obj.HealthBar.Bg.Size = Vector2.new(barW, barH)
                obj.HealthBar.Bg.Visible = true
                obj.HealthBar.Fill.Position = Vector2.new(barX, barY + barH * (1 - healthPercent))
                obj.HealthBar.Fill.Size = Vector2.new(barW, barH * healthPercent)
                obj.HealthBar.Fill.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 80)
                obj.HealthBar.Fill.Visible = true
            end)
        else
            if obj.HealthBar.Bg then pcall(function() obj.HealthBar.Bg.Visible = false end) end
            if obj.HealthBar.Fill then pcall(function() obj.HealthBar.Fill.Visible = false end) end
        end
    end
end

