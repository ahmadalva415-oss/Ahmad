local function IsVisible(targetPos, ignoreList)
    if not Aimbot.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = (targetPos - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList or {player.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

local function GetAimbotTarget()
    if not Aimbot.Enabled then return nil end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestScore = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not plr.Character then continue end
        if Aimbot.TeamCheck and plr.Team == player.Team then continue end

        local char = plr.Character
        local targetPart = char:FindFirstChild(Aimbot.TargetPart)
        if not targetPart then
            if Aimbot.TargetPart == "Torso" then
                targetPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
            elseif Aimbot.TargetPart == "UpperTorso" then
                targetPart = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
            elseif Aimbot.TargetPart == "LowerTorso" then
                targetPart = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
            end
        end
        if not targetPart then continue end

        local worldPos = targetPart.Position
        local screenPos = WorldToViewport(worldPos)
        if not screenPos or screenPos.Z < 0 then continue end

        local distance = (worldPos - Camera.CFrame.Position).Magnitude
        if distance > Aimbot.MaxDistance then continue end

        local screenDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if screenDistance > Aimbot.FOV then continue end

        if Aimbot.WallCheck and not IsVisible(worldPos, {player.Character, char}) then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local health = hum and hum.Health or 100

        local score = 0
        if Aimbot.Priority == "Closest" then
            score = distance
        elseif Aimbot.Priority == "LowestHealth" then
            score = health
        elseif Aimbot.Priority == "HighestHealth" then
            score = -health
        elseif Aimbot.Priority == "ClosestToCrosshair" then
            score = screenDistance
        end

        if score < bestScore then
            bestScore = score
            bestTarget = {
                Player = plr,
                Character = char,
                Part = targetPart,
                Position = worldPos,
                ScreenPosition = screenPos,
                Distance = distance,
                Health = health,
            }
        end
    end

    return bestTarget
end

-- Core aim function - works automatically
local function DoAim(target)
    if not target or not target.Part then return end
    if not target.Part.Parent then return end

    local targetPos = target.Position
    local currentCF = Camera.CFrame
    local currentPos = currentCF.Position

    local targetDir = (targetPos - currentPos).Unit
    local smooth = math.clamp(Aimbot.Smoothness, 0.01, 1)
    local smoothFactor = 1 - smooth

    if smoothFactor >= 0.99 then
        Camera.CFrame = CFrame.new(currentPos, targetPos)
    else
        local currentDir = currentCF.LookVector
        local newDir = currentDir:Lerp(targetDir, smoothFactor)
        Camera.CFrame = CFrame.new(currentPos, currentPos + newDir)
    end
end

