-- تصغير FluentPro تلقائيًا على شاشات الهاتف
if FluentRoot and FluentRoot:IsA("GuiObject") then
    local FluentScale = Instance.new("UIScale")
    FluentScale.Name = "NAZK_ResponsiveScale"
    FluentScale.Parent = FluentRoot

    local function UpdateResponsiveScale()
        local Camera = Workspace.CurrentCamera
        if not Camera then return end
        local Viewport = Camera.ViewportSize
        FluentScale.Scale = math.clamp(math.min(Viewport.X / 800, Viewport.Y / 600), 0.72, 1)
    end

    UpdateResponsiveScale()
    local Camera = Workspace.CurrentCamera
    if Camera then
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsiveScale)
    end
end

