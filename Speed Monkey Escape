end

local function StartAntiFling()

    if AntiFlingConnection then
        AntiFlingConnection:Disconnect()
    end

    AntiFlingEnabled = true

    AntiFlingConnection =
        RunService.Heartbeat:Connect(function()

            if not AntiFlingEnabled then
                return
            end

            local Character =
                LocalPlayer.Character

            if not Character then
                return
            end

            local Root =
                Character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not Root then
                return
            end

            for _, Obj in ipairs(Root:GetChildren()) do

                if Obj:IsA("BodyVelocity")
                    or Obj:IsA("BodyAngularVelocity")
                    or Obj:IsA("BodyGyro")
                    or Obj:IsA("BodyForce")
                    or Obj:IsA("BodyThrust") then

                    Obj:Destroy()
                end
            end

            if Root.AssemblyAngularVelocity.Magnitude > 50
                or Root.AssemblyLinearVelocity.Magnitude > 100 then

                Root.AssemblyAngularVelocity =
                    Vector3.zero

                Root.AssemblyLinearVelocity =
                    Vector3.zero
            end
        end)
end

local function StopAntiFling()

    AntiFlingEnabled = false

    if AntiFlingConnection then
        AntiFlingConnection:Disconnect()
        AntiFlingConnection = nil
    end
end

local function StartNoClip()

    if NoClipConnection then
        NoClipConnection:Disconnect()
    end

    NoClipEnabled = true

    NoClipConnection =
        RunService.Stepped:Connect(function()

            if not NoClipEnabled then
                return
            end

            local Character =
                LocalPlayer.Character

            if not Character then
                return
            end

            for _, Part in ipairs(Character:GetDescendants()) do

                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
        end)
end

local function StopNoClip()

    NoClipEnabled = false

    if NoClipConnection then
        NoClipConnection:Disconnect()
        NoClipConnection = nil
    end

    local Character =
        LocalPlayer.Character

    if Character then

        for _, Part in ipairs(Character:GetDescendants()) do

            if Part:IsA("BasePart") then
                Part.CanCollide = true
            end
        end
    end
end

local function StartAntiLag()

    AntiLagEnabled = true

    for _, Obj in ipairs(Workspace:GetDescendants()) do

        if Obj:IsA("ParticleEmitter")
            or Obj:IsA("Trail") then

            Obj.Enabled = false
        end

        if Obj:IsA("BasePart")
            and Obj.Material == Enum.Material.Water then

            Obj.Transparency = 1
        end

        if Obj:IsA("Decal")
            or Obj:IsA("Texture") then

            Obj.Transparency = 1
        end

        if Obj:IsA("Sound") then
            Obj.Volume = 0
        end
    end

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.Brightness = 2

    for _, Effect in ipairs(Lighting:GetChildren()) do

        if Effect:IsA("BlurEffect")
            or Effect:IsA("BloomEffect")
            or Effect:IsA("SunRaysEffect")
            or Effect:IsA("ColorCorrectionEffect") then

            Effect.Enabled = false
        end
    end

    settings().Rendering.QualityLevel =
        Enum.QualityLevel.Level01
end

local function StopAntiLag()

    AntiLagEnabled = false

    for _, Obj in ipairs(Workspace:GetDescendants()) do

        if Obj:IsA("ParticleEmitter")
            or Obj:IsA("Trail") then

            Obj.Enabled = true
        end

        if Obj:IsA("BasePart")
            and Obj.Material == Enum.Material.Water then

            Obj.Transparency = 0
        end

        if Obj:IsA("Decal")
            or Obj:IsA("Texture") then

            Obj.Transparency = 0
        end

        if Obj:IsA("Sound") then
            Obj.Volume = 0.5
        end
    end

    Lighting.GlobalShadows = true
    Lighting.FogEnd = 10000
    Lighting.Brightness = 1

    for _, Effect in ipairs(Lighting:GetChildren()) do

        if Effect:IsA("BlurEffect")
            or Effect:IsA("BloomEffect")
            or Effect:IsA("SunRaysEffect")
            or Effect:IsA("ColorCorrectionEffect") then

            Effect.Enabled = true
        end
    end

    settings().Rendering.QualityLevel =
        Enum.QualityLevel.Level10
end



