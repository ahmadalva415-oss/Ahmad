-- AUTO WIN FUNCTIONS
--========================================================--

local function StartAutoWin(WorldIndex)

    if AutoWinConnections[WorldIndex] then
        AutoWinConnections[WorldIndex]:Disconnect()
        AutoWinConnections[WorldIndex] = nil
    end

    AutoWinEnabled[WorldIndex] = true

    AutoWinConnections[WorldIndex] =
        RunService.Heartbeat:Connect(function()

            if not AutoWinEnabled[WorldIndex] then
                return
            end

            local Root = GetRoot()
            if not Root then
                return
            end

            local TargetPos = WorldPositions[WorldIndex]
            if not TargetPos then
                return
            end

            local Time = tick()
            -- math.sin goes from -1 to 1, so YOffset goes from -Amplitude to +Amplitude
            -- Amplitude = 5 means: UP 5 studs, DOWN 5 studs from target Y
            local YOffset = math.sin(Time * AutoWinYSpeed) * AutoWinYAmplitude

            Root.CFrame = CFrame.new(
                TargetPos.X,
                TargetPos.Y + YOffset,
                TargetPos.Z
            )
        end)
end

local function StopAutoWin(WorldIndex)

    AutoWinEnabled[WorldIndex] = false

    if AutoWinConnections[WorldIndex] then
        AutoWinConnections[WorldIndex]:Disconnect()
        AutoWinConnections[WorldIndex] = nil
    end
end

local function StopAllAutoWin()
    for i = 1, 5 do
        StopAutoWin(i)
    end
end

local function SetGravity(Value)

    CurrentGravity = Value
    Workspace.Gravity = Value
end


--========================================================--
-- SETTINGS SAVE / LOAD
--========================================================--

local SettingsFile = "NAZK_HUB_Settings.json"

local function SaveSettings()
    if type(writefile) ~= "function" then
        return false
    end

    local Data = {
        DashPower = DashPower,
        DashDuration = DashDuration,
        DashCooldown = DashCooldown,
        Gravity = CurrentGravity,
        ThemeName = CurrentThemeName,
    }

    local Success = pcall(function()
        writefile(SettingsFile, HttpService:JSONEncode(Data))
    end)
    return Success
end

local function LoadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return
    end
    if not isfile(SettingsFile) then
        return
    end

    pcall(function()
        local Data = HttpService:JSONDecode(readfile(SettingsFile))
        if type(Data) ~= "table" then return end
        if type(Data.DashPower) == "number" then DashPower = Data.DashPower end
        if type(Data.DashDuration) == "number" then DashDuration = Data.DashDuration end
        if type(Data.DashCooldown) == "number" then DashCooldown = Data.DashCooldown end
        if type(Data.Gravity) == "number" then
            CurrentGravity = Data.Gravity
            Workspace.Gravity = CurrentGravity
        end
        if type(Data.ThemeName) == "string" and ThemeColors[Data.ThemeName] then
            CurrentThemeName = Data.ThemeName
        end
    end)
end

LoadSettings()


