-- ============================================================
-- COIN FARM LOGIC - CLEAN NO-LAG EDITION
-- ============================================================
local Coin_Running = false
local Coin_CurrentTween = nil
local visitedCoins = {}

local function GetCoins()
    local coins = {}
    pcall(function()
        local folder = workspace:FindFirstChild("Factory") and workspace.Factory:FindFirstChild("CoinContainer")
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    if obj.Name:find("Coin") or obj.Name:find("coin") then
                        table.insert(coins, obj)
                    end
                end
            end
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart")) and (obj.Name:find("Coin") or obj.Name:find("coin")) then
                    local char = player.Character
                    if char and not obj:IsDescendantOf(char) then
                        table.insert(coins, obj)
                    end
                end
            end
        end
    end)
    return coins
end

local function GetCoinPosition(coin)
    if not coin then return nil end
    local pos = nil
    pcall(function()
        if coin:IsA("BasePart") then
            pos = coin.Position
        elseif coin:IsA("Model") then
            if coin.PrimaryPart then
                pos = coin.PrimaryPart.Position
            else
                for _, part in ipairs(coin:GetDescendants()) do
                    if part:IsA("BasePart") then
                        pos = part.Position
                        break
                    end
                end
            end
        end
    end)
    return pos
end

local function GetHorizontalCFrame(pos, lookDir)
    lookDir = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
    if lookDir.Magnitude < 0.01 then
        lookDir = Vector3.new(0, 0, 1)
    end
    return CFrame.lookAt(pos, pos + lookDir) * CFrame.Angles(math.pi / 2, 0, 0)
end

-- Fly to coin and WAIT for tween to finish (clean yield, no lag)
local function FlyToCoin(targetPos)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if Coin_CurrentTween then
        pcall(function() Coin_CurrentTween:Cancel() end)
        Coin_CurrentTween = nil
    end

    local undergroundY = targetPos.Y - Coin_Config.UndergroundOffset
    local endPos = Vector3.new(targetPos.X, undergroundY, targetPos.Z)
    local startPos = hrp.Position
    local flatDist = (Vector3.new(startPos.X, 0, startPos.Z) - Vector3.new(endPos.X, 0, endPos.Z)).Magnitude

    if flatDist < 3 then
        local flyDir = (endPos - startPos).Unit
        flyDir = Vector3.new(flyDir.X, 0, flyDir.Z).Unit
        if flyDir.Magnitude < 0.01 then flyDir = Vector3.new(0, 0, 1) end
        pcall(function()
            hrp.CFrame = GetHorizontalCFrame(endPos, flyDir)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        return
    end

    local duration = math.max(flatDist / Coin_Config.Speed, 0.08)
    local flyDir = (endPos - startPos).Unit
    flyDir = Vector3.new(flyDir.X, 0, flyDir.Z).Unit
    if flyDir.Magnitude < 0.01 then flyDir = Vector3.new(0, 0, 1) end

    local targetCFrame = GetHorizontalCFrame(endPos, flyDir)

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tween = nil
    pcall(function()
        tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    end)
    if not tween then return end
    Coin_CurrentTween = tween

    local completed = false

    tween.Completed:Connect(function()
        completed = true
        pcall(function()
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end)

    tween:Play()

    repeat
        task.wait(0.05)
    until completed or not Coin_Running
end

function StartCoinFarm()
    if Coin_Running then return end
    Coin_Running = true
    visitedCoins = {}

    task.spawn(function()
        while Coin_Running and Coin_Config.Enabled do
            local ok, err = pcall(function()
                local char = player.Character
                if not char then
                    task.wait(0.3)
                    return
                end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if not hrp or not hum or hum.Health <= 0 then
                    task.wait(0.3)
                    return
                end

                local coins = GetCoins()
                if #coins == 0 then
                    task.wait(0.3)
                    return
                end

                local bestCoin = nil
                local bestDist = math.huge

                for _, coin in ipairs(coins) do
                    local pos = GetCoinPosition(coin)
                    if pos and not visitedCoins[coin] then
                        local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestCoin = coin
                        end
                    end
                end

                if not bestCoin then
                    visitedCoins = {}
                    for _, coin in ipairs(coins) do
                        local pos = GetCoinPosition(coin)
                        if pos then
                            local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestCoin = coin
                            end
                        end
                    end
                end

                if not bestCoin then
                    task.wait(0.3)
                    return
                end

                local pos = GetCoinPosition(bestCoin)
                if pos then
                    visitedCoins[bestCoin] = true
                    FlyToCoin(pos)
                else
                    task.wait(0.2)
                end
            end)

            if not ok then
                warn("[NAZK] Coin Farm Error: " .. tostring(err))
                task.wait(0.5)
            end
        end
    end)
end

function StopCoinFarm()
    Coin_Running = false
    visitedCoins = {}
    if Coin_CurrentTween then
        pcall(function() Coin_CurrentTween:Cancel() end)
        Coin_CurrentTween = nil
    end
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = true
    end
end

