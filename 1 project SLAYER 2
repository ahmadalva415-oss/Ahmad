NButton.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
        IsDragging = true
        Moved = false
        DragStart = Input.Position
        StartPos = NButton.Position
    end
end)

NButton.InputChanged:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then
        DragInput = Input
    end
end)

NButton.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
        IsDragging = false
        if not Moved then
            MenuVisible = not MenuVisible
            if FluentRoot and FluentRoot:IsA("GuiObject") then
                FluentRoot.Visible = MenuVisible
            end
        end
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Input == DragInput and IsDragging then
        local Delta = Input.Position - DragStart
        if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then
            Moved = true
        end
        NButton.Position = UDim2.new(
            StartPos.X.Scale, StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y
        )
    end
end)

