-- COMBO
--========================================================--
local function RunAttackSequence()
    if AttackSequenceRunning then return end
    AttackSequenceRunning = true

    task.spawn(function()
        for _, Move in ipairs(ComboMoves) do
            if not AutoFarmEnabled then break end
            FireSignal("Combat_Service", SelectedWeapon, Move[1], Move[2], Move[3], Move[4])
            local WaitTime = math.abs(Move[3])
            if WaitTime < 0.05 then WaitTime = 0.15 end
            task.wait(WaitTime)
        end
        AttackSequenceRunning = false
    end)
end

--========================================================--
-- MAIN LOOP
--========================================================--
local function StartAutoFarm()
    if AutoFarmConnection then AutoFarmConnection:Disconnect() end

    AutoFarmEnabled = true
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    CurrentQuestType = nil
    CurrentRegion = nil

    RefreshEnemyCache()
    UpdateLevel()

    TakeQuest()
    task.wait(0.5)

    AutoFarmConnection = RunService.Heartbeat:Connect(function(dt)
        if not AutoFarmEnabled then return end

        local MyRoot = GetRoot()
        if not MyRoot then return end

        local hasQuest, questType, progress, max = GetQuestInfo()
        if hasQuest then
            CurrentQuestType = questType
        end

        -- ما فيه مهمة → ياخذ
        if not hasQuest then
            if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                print("[Auto Farm] ⏱ ما فيه مهمة → ياخذ جديدة")
                TakeQuest()
                LastQuestTime = tick()
            end
            return
        end

        -- المهمة خلصت → ياخذ جديدة
        if IsQuestComplete() then
            if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                print("[Auto Farm] ✅ Quest Complete! (" .. (questType or "?") .. ")")
                CurrentTarget = nil
                IsLocked = false
                IsApproaching = false
                CancelCurrentTween()
                TakeQuest()
                LastQuestTime = tick()
            end
            return
        end

        -- 🧠 فحص التحوّل التلقائي حسب المستوى
        if not QuestInProgress and tick() - LastQuestTime > QuestCheckInterval then
            UpdateLevel()
            RefreshEnemyCache()

            local needsChange = false

            -- 1-6 + عنده مهمة بوس → يرجع للبانديتس
            if PlayerLevel <= BANDIT_REGULAR_MAX
                and CurrentQuestType == "banditboss" then
                print("[Auto Farm] ⬇️ Level " .. PlayerLevel .. " → يرجع للبانديتس")
                needsChange = true
            end

            -- 7-10 + عنده مهمة بانديتس عادي → يحول للبوس
            if PlayerLevel >= BANDIT_BOSS_MIN
                and PlayerLevel <= BANDIT_BOSS_MAX
                and CurrentQuestType == "bandit" then
                print("[Auto Farm] 🗡️ Level " .. PlayerLevel .. " → Zuko Boss")
                needsChange = true
            end

            -- 11+ + عنده مهمة بانديتس → يحول للدببة
            if PlayerLevel >= BEAR_MIN_LEVEL
                and (CurrentQuestType == "bandit" or CurrentQuestType == "banditboss") then
                print("[Auto Farm] 🐻 Level " .. PlayerLevel .. " → منطقة الدببة")
                needsChange = true
            end

            -- 18+ + عنده Cubs و البوس رجع → يحول للبوس
            if CurrentQuestType == "bearcub"
                and PlayerLevel >= BEAR_BOSS_LEVEL
                and IsMotherBearAlive() then
                print("[Auto Farm] 🎯 Mother Bear رجع → Boss")
                needsChange = true
            end

            if needsChange then
                CurrentTarget = nil
                IsLocked = false
                IsApproaching = false
                CancelCurrentTween()
                TakeQuest()
                LastQuestTime = tick()
                return
            end
        end

        local Target = FindTargetEnemy()
        if not Target then
            CurrentTarget = nil
            IsLocked = false
            IsApproaching = false
            return
        end

        if Target ~= CurrentTarget then
            CurrentTarget = Target
            IsLocked = false
            ApproachEnemy(Target)
        end

        if IsLocked and CurrentTarget and CurrentTarget.Parent then
            local ProneCF = GetProneCFrame(CurrentTarget)
            if ProneCF then
                MyRoot.CFrame = ProneCF
                if not AttackSequenceRunning then
                    if tick() - LastAttackTime > 0.5 then
                        RunAttackSequence()
                        LastAttackTime = tick()
                    end
                end
            end
        end
    end)
end

local function StopAutoFarm()
    AutoFarmEnabled = false
    AttackSequenceRunning = false
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    QuestInProgress = false
    CurrentQuestType = nil
    CurrentRegion = nil
    CancelCurrentTween()
    if AutoFarmConnection then
        AutoFarmConnection:Disconnect()
        AutoFarmConnection = nil
    end
end

