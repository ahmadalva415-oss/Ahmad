-- MAIN LOOP
--========================================================--
local function StartAutoFarm()
    if AutoFarmConnection then AutoFarmConnection:Disconnect() end

    AutoFarmEnabled = true
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    CurrentQuestType = nil
    CurrentRegion = nil
    LastHeavyCheck = 0
    LastBossSwitchAttempt = 0
    LastLevelUpdate = 0
    PendingBossQuest = nil
    CachedHasQuest = false
    CachedQuestType = nil
    CachedProgress = 0
    CachedMax = 0

    RefreshEnemyCache()
    UpdateLevel()

    TakeQuest()
    task.wait(0.5)

    AutoFarmConnection = RunService.Heartbeat:Connect(function(dt)
        if not AutoFarmEnabled then return end

        local MyRoot = GetRoot()
        if not MyRoot then return end

        if tick() - LastLevelUpdate > LevelUpdateInterval then
            LastLevelUpdate = tick()
            UpdateLevel()
        end

        if PlayerLevel >= KAIDEN_MIN_LEVEL and PlayerLevel < KAIDEN_BOSS_LEVEL then
            if CachedHasQuest and CurrentQuestType ~= "kaiden" then
                if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                    print("[Auto Farm] 🛡️ Lv " .. PlayerLevel .. " → فرض Kaiden Subordinate")
                    CurrentTarget = nil
                    IsLocked = false
                    IsApproaching = false
                    CancelCurrentTween()
                    PendingBossQuest = nil
                    TakeQuest("kaiden")
                    LastQuestTime = tick()
                end
                return
            end
        end

        if CachedHasQuest
            and not QuestInProgress
            and tick() - LastBossSwitchAttempt > BossSwitchDelay then

            if CurrentQuestType == "bearcub"
                and PlayerLevel >= BEAR_BOSS_LEVEL
                and PlayerLevel < KAIDEN_MIN_LEVEL then
                RefreshEnemyCache()
                if IsMotherBearAlive() then
                    if not PendingBossQuest then
                        print("[Auto Farm] 🎯 Mother Bear ظهر! → نكمل الـCubs ثم نأخذ البوس")
                        PendingBossQuest = "bearboss"
                    end
                    LastBossSwitchAttempt = tick()
                end
            end

            if CurrentQuestType == "kaiden"
                and PlayerLevel >= KAIDEN_BOSS_LEVEL then
                RefreshEnemyCache()
                if IsKaidenAlive() then
                    if not PendingBossQuest then
                        print("[Auto Farm] ⚔️ Kaiden ظهر! → نكمل الـSubordinate ثم نأخذ البوس")
                        PendingBossQuest = "kaidenboss"
                    end
                    LastBossSwitchAttempt = tick()
                end
            end
        end

        if tick() - LastHeavyCheck >= HeavyCheckInterval then
            LastHeavyCheck = tick()

            local hasQuest, questType, progress, max = GetQuestInfo()
            CachedHasQuest = hasQuest
            CachedQuestType = questType
            CachedProgress = progress
            CachedMax = max

            if hasQuest then
                CurrentQuestType = questType
            end

            if PendingBossQuest == "bearboss" and not IsMotherBearAlive() then
                print("[Auto Farm] 🧹 Mother Bear مات → إلغاء Pending")
                PendingBossQuest = nil
            end
            if PendingBossQuest == "kaidenboss" and not IsKaidenAlive() then
                print("[Auto Farm] 🧹 Kaiden مات → إلغاء Pending")
                PendingBossQuest = nil
            end

            if not hasQuest then
                if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                    if PendingBossQuest then
                        print("[Auto Farm] 🎯 ما فيه مهمة → نأخذ البوس: " .. PendingBossQuest)
                        local pending = PendingBossQuest
                        PendingBossQuest = nil
                        TakeQuest(pending)
                    else
                        print("[Auto Farm] ⏱ ما فيه مهمة → ياخذ جديدة")
                        TakeQuest()
                    end
                    LastQuestTime = tick()
                end

            elseif max > 0 and progress >= max then
                if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                    print("[Auto Farm] ✅ Quest Complete! (" .. (questType or "?") .. ")")
                    CurrentTarget = nil
                    IsLocked = false
                    IsApproaching = false
                    CancelCurrentTween()

                    if PendingBossQuest then
                        print("[Auto Farm] 🎯 نأخذ مهمة البوس المعلّقة: " .. PendingBossQuest)
                        local pending = PendingBossQuest
                        PendingBossQuest = nil
                        TakeQuest(pending)
                    else
                        TakeQuest()
                    end
                    LastQuestTime = tick()
                end
            end
        end

        if not CachedHasQuest then return end
        if CachedMax > 0 and CachedProgress >= CachedMax then return end

        local Target = FindTargetEnemy()
        if not Target then
            CurrentTarget = nil
            IsLocked = false
            IsApproaching = false
            return
        end

        if Target ~= CurrentTarget then
            CurrentTarget = Target
            IsLocked = false
            ApproachEnemy(Target)
        end

        if IsLocked and CurrentTarget and CurrentTarget.Parent then
            local ProneCF = GetProneCFrame(CurrentTarget)
            if ProneCF then
                MyRoot.CFrame = ProneCF
                if not AttackSequenceRunning then
                    if tick() - LastAttackTime > 0.5 then
                        RunAttackSequence()
                        LastAttackTime = tick()
                    end
                end
            end
        end
    end)
end

local function StopAutoFarm()
    AutoFarmEnabled = false
    AttackSequenceRunning = false
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    QuestInProgress = false
    CurrentQuestType = nil
    CurrentRegion = nil
    PendingBossQuest = nil
    CancelCurrentTween()
    if AutoFarmConnection then
        AutoFarmConnection:Disconnect()
        AutoFarmConnection = nil
    end
end

