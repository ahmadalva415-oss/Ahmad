-- TAKE QUEST
--========================================================--
local function TakeQuest(forceType)
    if QuestInProgress then return end
    QuestInProgress = true

    task.spawn(function()
        UpdateLevel()

        local questType = forceType

        if not questType and PlayerLevel >= HOYUZO_MIN_LEVEL and PlayerLevel >= HOYUZO_BOSS_LEVEL then
            print("[Auto Quest] Checking Hoyuzo Boss...")
            local bossAlive = CheckHoyuzoBossAlive()
            if bossAlive then
                print("[Auto Quest] Hoyuzo Found -> Boss Quest")
                questType = "hoyuzoboss"
            else
                print("[Auto Quest] Hoyuzo Not Found -> Guards Quest")
                questType = "hoyuzo"
            end
        end

        if not questType then
            questType = DecideRegionAndQuest()
        end

        if questType == "hoyuzo" or questType == "hoyuzoboss" then
            CurrentRegion = "hoyuzo"
            CurrentQuestCoords = HoyuzoCoords
        elseif questType == "kaiden" or questType == "kaidenboss" then
            CurrentRegion = "kaiden"
            CurrentQuestCoords = KaidenCoords
        elseif questType == "bearcub" or questType == "bearboss" then
            CurrentRegion = "bear"
            CurrentQuestCoords = BearCoords
        elseif questType == "bandit" or questType == "banditboss" then
            CurrentRegion = "bandit"
            CurrentQuestCoords = BanditCoords
        end

        local coords = CurrentQuestCoords

        local ok = TeleportToQuest(coords)
        if not ok then
            print("[Auto Quest] Failed to reach coordinates")
        end

        task.wait(0.4)

        local MyRoot = GetRoot()
        if MyRoot then
            pcall(function()
                MyRoot.AssemblyLinearVelocity = Vector3.zero
                MyRoot.AssemblyAngularVelocity = Vector3.zero
            end)
            MyRoot.CFrame = CFrame.new(coords)
        end
        task.wait(0.1)

        if questType == "banditboss" then
            FireSignal("AddQuest", "Ill take the bandit boss(Lv 7)")
            CurrentQuestType = "banditboss"
        elseif questType == "bandit" then
            FireSignal("AddQuest", "Ill take 3 bandits")
            CurrentQuestType = "bandit"
        elseif questType == "bearboss" then
            FireSignal("AddQuest", "Ill fell the Mother Bear(Lv 18)")
            CurrentQuestType = "bearboss"
        elseif questType == "bearcub" then
            FireSignal("AddQuest", "Ill drive the bears back(Lv 10)")
            CurrentQuestType = "bearcub"
        elseif questType == "kaiden" then
            FireSignal("AddQuest", "Ill clear out his subordinates(Lv 26)")
            CurrentQuestType = "kaiden"
        elseif questType == "kaidenboss" then
            FireSignal("AddQuest", "Ill deal with Kaiden(Lv 34)")
            CurrentQuestType = "kaidenboss"
        elseif questType == "hoyuzo" then
            FireSignal("AddQuest", "I will clear out his guards(Lv 40)")
