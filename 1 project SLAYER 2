--========================================================--
-- HELPERS
--========================================================--
local function GetRoot()
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return Char and Char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return Char and Char:FindFirstChildOfClass("Humanoid")
end

local function GetSignalEvent()
    local Comm = ReplicatedStorage:FindFirstChild("Communication")
    if not Comm then return nil end
    local SC = Comm:FindFirstChild("ServerAndClient")
    if not SC then return nil end
    local Signals = SC:FindFirstChild("Signals")
    if not Signals then return nil end
    return Signals:FindFirstChild("SignalEvent")
end

local function FireSignal(...)
    local SignalEvent = GetSignalEvent()
    if not SignalEvent then return false end
    local args = {...}
    return pcall(function()
        if SignalEvent:FindFirstChild("Event") then
            SignalEvent.Event:FireServer(table.unpack(args))
        else
            SignalEvent:FireServer(table.unpack(args))
        end
    end)
end

--========================================================--
-- ⚡ ANTI-LAG SYSTEM
--========================================================--
local function SaveLighting()
    if OriginalLighting.Saved then return end
    OriginalLighting.FogEnd = Lighting.FogEnd
    OriginalLighting.FogStart = Lighting.FogStart
    OriginalLighting.Brightness = Lighting.Brightness
    OriginalLighting.GlobalShadows = Lighting.GlobalShadows
    OriginalLighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    OriginalLighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    OriginalLighting.Ambient = Lighting.Ambient
    OriginalLighting.OutdoorAmbient = Lighting.OutdoorAmbient
    OriginalLighting.Saved = true
end

local function RestoreLighting()
    if not OriginalLighting.Saved then return end
    Lighting.FogEnd = OriginalLighting.FogEnd
    Lighting.FogStart = OriginalLighting.FogStart
    Lighting.Brightness = OriginalLighting.Brightness
    Lighting.GlobalShadows = OriginalLighting.GlobalShadows
    Lighting.EnvironmentDiffuseScale = OriginalLighting.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = OriginalLighting.EnvironmentSpecularScale
    Lighting.Ambient = OriginalLighting.Ambient
    Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
end

local function RemoveEffects()
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BloomEffect")
            or v:IsA("BlurEffect")
            or v:IsA("ColorCorrectionEffect")
            or v:IsA("SunRaysEffect")
            or v:IsA("DepthOfFieldEffect") then
            if not AntiLagCache[v] then
                AntiLagCache[v] = v.Enabled
                v.Enabled = false
            end
        end
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter")
            or v:IsA("Trail")
            or v:IsA("Beam")
            or v:IsA("Fire")
            or v:IsA("Smoke")
            or v:IsA("Sparkles")
            or v:IsA("Explosion")
            or v:IsA("PointLight")
            or v:IsA("SpotLight")
            or v:IsA("SurfaceLight") then
            pcall(function()
                if not AntiLagCache[v] then
                    AntiLagCache[v] = true
                    v:Destroy()
                end
            end)
        end
    end

    pcall(function()
        if Terrain then
            Terrain.Decoration = false
        end
    end)
end

local function ApplyLightingTweaks()
    pcall(function()
        Lighting.FogEnd = 300
        Lighting.FogStart = 0
        Lighting.Brightness = 1
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Ambient = Color3.fromRGB(120, 120, 120)
        Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
    end)
end

local function LowerRenderQuality()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01

        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = 0
                v.Haze = 0
                v.Glare = 0
            end
        end
    end)
end

local function RunAntiLagPass()
    if not AntiLagEnabled then return end
    RemoveEffects()
    ApplyLightingTweaks()
end

local function EnableAntiLag()
    if AntiLagEnabled then return end
    AntiLagEnabled = true
    AntiLagCache = {}
    SaveLighting()

    LowerRenderQuality()
    RunAntiLagPass()

    AntiLagLoop = task.spawn(function()
        while AntiLagEnabled do
            task.wait(3)
            RunAntiLagPass()
        end
    end)

    print("[Anti-Lag] ✅ مفعّل")
end

local function DisableAntiLag()
    if not AntiLagEnabled then return end
    AntiLagEnabled = false
    if AntiLagLoop then
        task.cancel(AntiLagLoop)
        AntiLagLoop = nil
    end

    RestoreLighting()

    for obj, state in pairs(AntiLagCache) do
        if typeof(obj) == "Instance" and obj.Parent then
            pcall(function()
                if obj:IsA("PostEffect") then
                    obj.Enabled = state
                end
            end)
        end
    end
    AntiLagCache = {}

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        if Terrain then
            Terrain.Decoration = true
        end
    end)

    print("[Anti-Lag] ❌ متوقف")
end

--========================================================--
-- LEVEL READER
--========================================================--
local function FindLevelData()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local lvMatch = obj.Text:match("Lv%s*(%d+)")
                if lvMatch then
                    local Level = tonumber(lvMatch)
                    local Exp, MaxExp = 0, 0
                    local parent = obj.Parent
                    if parent then
                        for _, sib in ipairs(parent:GetDescendants()) do
                            if sib:IsA("TextLabel") and sib ~= obj then
                                local xp, mxp = sib.Text:match("(%d+)%s*/%s*(%d+)")
                                if xp and mxp then
                                    Exp = tonumber(xp)
                                    MaxExp = tonumber(mxp)
                                    break
                                end
                            end
                        end
                    end
                    return Level, Exp, MaxExp
                end
            end
        end
    end

    for name, value in pairs(LocalPlayer:GetAttributes()) do
        if typeof(value) == "number" then
            local n = string.lower(name)
            if n:find("level") or n == "lv" then
                return value, 0, 0
            end
        end
    end
    return 0, 0, 0
end

local function UpdateLevel()
    local lv, exp, max = FindLevelData()
    PlayerLevel = lv
    PlayerExp = exp
    PlayerMaxExp = max
end

--========================================================--
-- QUEST DETECTION
--========================================================--
local function IsQuestAbandoned()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
            if obj.Text:find("Abandoned Quest") then
                return true
            end
        end
    end
    return false
end

local function GetQuestInfo()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, nil, 0, 0 end

    if IsQuestAbandoned() then
        return false, nil, 0, 0
    end

    local hasQuest = false
    local questType = nil
    local progress = 0
    local max = 0

    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            local text = obj.Text

            -- ============ BEARS ============
            if text:find("Hunt the Bears") or text:find("Mother Bear") then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "bearboss"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if text:find("Bear Cubs hunted") then
                if not hasQuest then
                    local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                    if cur then
                        hasQuest = true
                        questType = "bearcub"
                        progress = tonumber(cur)
                        max = tonumber(mx)
                    end
                end
            end

            -- ============ BANDITS ============
            if text:find("Defeat The Bandit Boss") or text:find("Defeat Zuko") then
                if not hasQuest then
                    local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                    if cur then
                        hasQuest = true
                        questType = "banditboss"
                        progress = tonumber(cur)
                        max = tonumber(mx)
                    end
                end
            end

            if text:find("Defeat 3 bandits") or text:find("Bandits remaining") then
                if not hasQuest then
                    local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                    if cur then
                        hasQuest = true
                        questType = "bandit"
                        progress = tonumber(cur)
                        max = tonumber(mx)
                    end
                end
            end
        end
    end

    return hasQuest, questType, progress, max
end

local function HasActiveQuest()
    return (GetQuestInfo())
end

local function IsQuestComplete()
    local hasQuest, questType, progress, max = GetQuestInfo()
    if not hasQuest then return false end
    if max <= 0 then return false end
    return progress >= max
end

--========================================================--
-- ENEMY CACHE
--========================================================--
local function RefreshEnemyCache()
    CachedEnemies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Bear Cub"
            or obj.Name == "Mother Bear"
            or obj.Name == "Bandit"
            or obj.Name == "Zuko" then
            local Hum = obj:FindFirstChildOfClass("Humanoid")
            local Root = obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("Torso")
            if Hum or Root then
                table.insert(CachedEnemies, obj)
            end
        end
    end
    CacheTime = tick()
end

local function GetCachedEnemies()
    if tick() - CacheTime > CACHE_INTERVAL then
        RefreshEnemyCache()
    end
    return CachedEnemies
end

local function GetEnemyRoot(Enemy)
    if not Enemy then return nil end
    return Enemy:FindFirstChild("HumanoidRootPart")
        or Enemy:FindFirstChild("UpperTorso")
        or Enemy:FindFirstChild("Torso")
        or Enemy:FindFirstChildWhichIsA("BasePart")
end

local function IsEnemyAlive(Enemy)
    if not Enemy or not Enemy.Parent then return false end
    local Hum = Enemy:FindFirstChildOfClass("Humanoid")
    if Hum then return Hum.Health > 0 end
    return GetEnemyRoot(Enemy) ~= nil
end

local function IsZukoAlive()
    for _, Enemy in ipairs(GetCachedEnemies()) do
        if Enemy.Name == "Zuko" and IsEnemyAlive(Enemy) then
            return true
        end
    end
    return false
end

local function IsMotherBearAlive()
    for _, Enemy in ipairs(GetCachedEnemies()) do
        if Enemy.Name == "Mother Bear" and IsEnemyAlive(Enemy) then
            return true
        end
    end
    return false
end

--========================================================--
-- PRONE CFrame
--========================================================--
local function GetProneCFrame(Enemy)
    if not Enemy then return nil end
    local Head = Enemy:FindFirstChild("Head")
    if not Head then return nil end
    local AbovePos = Head.Position + Vector3.new(0, AboveHeadHeight, 0)
    return CFrame.new(AbovePos) * CFrame.Angles(math.rad(-ProneAngle), 0, 0)
end

--========================================================--
-- TELEPORT TO QUEST NPC
--========================================================--
local function TeleportToQuest(coords)
    local target = CFrame.new(coords)
    local attempts = 0

    while attempts < TeleportMaxAttempts do
        if not AutoFarmEnabled and attempts > 0 then
            return false
        end

        local MyRoot = GetRoot()
        local Hum = GetHumanoid()
        if not MyRoot or not Hum then
            task.wait(0.1)
            attempts = attempts + 1
            continue
        end

        pcall(function()
            MyRoot.AssemblyLinearVelocity = Vector3.zero
            MyRoot.AssemblyAngularVelocity = Vector3.zero
        end)

        MyRoot.CFrame = target

        local dist = (MyRoot.Position - coords).Magnitude
        if dist <= TeleportDistance then
            MyRoot.CFrame = target
            return true
        end

        task.wait(0.08)
        attempts = attempts + 1
    end

    local MyRoot = GetRoot()
    if MyRoot then
        return (MyRoot.Position - coords).Magnitude <= TeleportDistance
    end
    return false
end

--========================================================--
-- 🧠 DECIDE REGION + QUEST TYPE (Automatic by Level)
--========================================================--
local function DecideRegionAndQuest()
    UpdateLevel()
    RefreshEnemyCache()

    -- ─────────────────────────────────────
    -- Level 1-6 → 3 Bandits
    -- ─────────────────────────────────────
    if PlayerLevel <= BANDIT_REGULAR_MAX then
        CurrentRegion = "bandit"
        CurrentQuestCoords = BanditCoords
        print("[Logic] Lv " .. PlayerLevel .. " (1-6) → 3 Bandits")
        return "bandit"
    end

    -- ─────────────────────────────────────
    -- Level 7-10 → Zuko Boss
    -- ─────────────────────────────────────
    if PlayerLevel >= BANDIT_BOSS_MIN and PlayerLevel <= BANDIT_BOSS_MAX then
        CurrentRegion = "bandit"
        CurrentQuestCoords = BanditCoords
        print("[Logic] Lv " .. PlayerLevel .. " (7-10) → Zuko Boss")
        return "banditboss"
    end

    -- ─────────────────────────────────────
    -- Level 11-17 → Bear Cubs
    -- ─────────────────────────────────────
    if PlayerLevel >= BEAR_MIN_LEVEL and PlayerLevel < BEAR_BOSS_LEVEL then
        CurrentRegion = "bear"
        CurrentQuestCoords = BearCoords
        print("[Logic] Lv " .. PlayerLevel .. " (11-17) → Bear Cubs")
        return "bearcub"
    end

    -- ─────────────────────────────────────
    -- Level 18+ → Mother Bear
    -- ─────────────────────────────────────
    if PlayerLevel >= BEAR_BOSS_LEVEL then
        CurrentRegion = "bear"
        CurrentQuestCoords = BearCoords
        if IsMotherBearAlive() then
            print("[Logic] Lv " .. PlayerLevel .. " (18+) → Mother Bear Boss")
            return "bearboss"
        else
            print("[Logic] Lv " .. PlayerLevel .. " (18+) → Cubs (البوس مو موجود)")
            return "bearcub"
        end
    end

    CurrentRegion = "bandit"
    CurrentQuestCoords = BanditCoords
    return "bandit"
end

--========================================================--
-- TAKE QUEST
--========================================================--
local function TakeQuest(forceType)
    if QuestInProgress then return end
    QuestInProgress = true

    task.spawn(function()
        UpdateLevel()

        local questType = forceType or DecideRegionAndQuest()
        local coords = CurrentQuestCoords

        local ok = TeleportToQuest(coords)
        if not ok then
            print("[Auto Quest] ⚠ ما قدر يوصل للإحداثيات")
        end

        task.wait(0.4)

        local MyRoot = GetRoot()
        if MyRoot then
            pcall(function()
                MyRoot.AssemblyLinearVelocity = Vector3.zero
                MyRoot.AssemblyAngularVelocity = Vector3.zero
            end)
            MyRoot.CFrame = CFrame.new(coords)
        end
        task.wait(0.1)

        if questType == "banditboss" then
            FireSignal("AddQuest", "Ill take the bandit boss(Lv 7)")
            CurrentQuestType = "banditboss"
            print("[Auto Quest] → Bandit Boss (Zuko)")

        elseif questType == "bandit" then
            FireSignal("AddQuest", "Ill take 3 bandits")
            CurrentQuestType = "bandit"
            print("[Auto Quest] → 3 Bandits")

        elseif questType == "bearboss" then
            FireSignal("AddQuest", "Ill fell the Mother Bear(Lv 18)")
            CurrentQuestType = "bearboss"
            print("[Auto Quest] → Mother Bear Boss")

        elseif questType == "bearcub" then
            FireSignal("AddQuest", "Ill drive the bears back(Lv 10)")
            CurrentQuestType = "bearcub"
            print("[Auto Quest] → Bear Cubs")
        end

        task.wait(0.3)
        QuestInProgress = false
        LastQuestTime = tick()
    end)
end

--========================================================--
-- FIND TARGET
--========================================================--
local function FindTargetEnemy()
    local MyRoot = GetRoot()
    if not MyRoot then return nil end

    local Enemies = GetCachedEnemies()
    local Nearest = nil
    local ShortestDist = math.huge

    -- Bandit Boss → Zuko
    if CurrentQuestType == "banditboss" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Zuko" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        if not Nearest then
            for _, Enemy in ipairs(Enemies) do
                if Enemy.Name == "Bandit" and IsEnemyAlive(Enemy) then
                    local ERoot = GetEnemyRoot(Enemy)
                    if ERoot then
                        local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                        if Dist < ShortestDist then
                            ShortestDist = Dist
                            Nearest = Enemy
                        end
                    end
                end
            end
        end
        return Nearest
    end

    -- 3 Bandits
    if CurrentQuestType == "bandit" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Bandit" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        return Nearest
    end

    -- Mother Bear Boss
    if CurrentQuestType == "bearboss" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Mother Bear" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        if not Nearest then
            for _, Enemy in ipairs(Enemies) do
                if Enemy.Name == "Bear Cub" and IsEnemyAlive(Enemy) then
                    local ERoot = GetEnemyRoot(Enemy)
                    if ERoot then
                        local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                        if Dist < ShortestDist then
                            ShortestDist = Dist
                            Nearest = Enemy
                        end
                    end
                end
            end
        end
        return Nearest
    end

    -- Bear Cubs
    if CurrentQuestType == "bearcub" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Bear Cub" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        return Nearest
    end

    return nil
end

--========================================================--
-- APPROACH
--========================================================--
local function CancelCurrentTween()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
end

local function ApproachEnemy(Enemy)
    if not Enemy or IsApproaching then return end
    IsApproaching = true
    IsLocked = false

    task.spawn(function()
        local MyRoot = GetRoot()
        if not MyRoot then IsApproaching = false return end

        local TargetCF = GetProneCFrame(Enemy)
        if not TargetCF then IsApproaching = false return end

        local MyPos = MyRoot.Position
        local TargetPos = TargetCF.Position
        local HorizDist = (Vector3.new(MyPos.X, 0, MyPos.Z) - Vector3.new(TargetPos.X, 0, TargetPos.Z)).Magnitude

        if HorizDist > 0.3 then
            local Duration = math.max(HorizDist / TweenSpeed, 0.15)
            local HorizCF = CFrame.new(
                Vector3.new(TargetPos.X, MyPos.Y, TargetPos.Z)
            ) * CFrame.Angles(math.rad(-ProneAngle), 0, 0)

            CancelCurrentTween()
            CurrentTween = TweenService:Create(MyRoot, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { CFrame = HorizCF })

            local Done = false
            local Conn = CurrentTween.Completed:Connect(function() Done = true end)
            CurrentTween:Play()

            local Elapsed = 0
            while not Done and Elapsed < Duration + 0.3 do
                task.wait(0.03)
                Elapsed = Elapsed + 0.03
                if not AutoFarmEnabled then
                    CancelCurrentTween()
                    if Conn then Conn:Disconnect() end
                    IsApproaching = false
                    return
                end
            end
            if Conn then Conn:Disconnect() end
        end

        MyRoot = GetRoot()
        if not MyRoot then IsApproaching = false return end

        local VertDist = TargetPos.Y - MyRoot.Position.Y
        if math.abs(VertDist) > 0.3 then
            local Duration = math.max(math.abs(VertDist) / TweenSpeed, 0.1)
            CancelCurrentTween()
            CurrentTween = TweenService:Create(MyRoot, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { CFrame = TargetCF })

            local Done = false
            local Conn = CurrentTween.Completed:Connect(function() Done = true end)
            CurrentTween:Play()

            local Elapsed = 0
            while not Done and Elapsed < Duration + 0.3 do
                task.wait(0.03)
                Elapsed = Elapsed + 0.03
                if not AutoFarmEnabled then
                    CancelCurrentTween()
                    if Conn then Conn:Disconnect() end
                    IsApproaching = false
                    return
                end
            end
            if Conn then Conn:Disconnect() end
        end

        IsLocked = true
        IsApproaching = false
    end)
end

