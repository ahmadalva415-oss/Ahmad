    if not Panel then return false, nil, 0, 0 end

    if IsQuestAbandoned() then
        return false, nil, 0, 0
    end

    local hasQuest = false
    local questType = nil
    local progress = 0
    local max = 0

    for _, obj in ipairs(Panel:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            local text = obj.Text

            if (text:find("Defeat Hoyuzo") or text:find("take care of Hoyuzo")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "hoyuzoboss"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Clear Hoyuzo") or text:find("Guards defeated")
                or text:find("Hoyuzo's Guard")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "hoyuzo"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Defeat Kaiden") or text:find("at Kaiden")
                or text:find("Ill deal with Kaiden")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "kaidenboss"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Clear Kaiden") or text:find("Subordinates defeated")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "kaiden"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Hunt the Bears") or text:find("Mother Bear")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "bearboss"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if text:find("Bear Cubs hunted") and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "bearcub"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Defeat The Bandit Boss") or text:find("Defeat Zuko")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "banditboss"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            if (text:find("Defeat 3 bandits") or text:find("Bandits remaining")) and not hasQuest then
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    hasQuest = true
                    questType = "bandit"
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end
        end
    end

    return hasQuest, questType, progress, max
end

local function IsQuestComplete()
    local hasQuest, questType, progress, max = GetQuestInfo()
    if not hasQuest then return false end
    if max <= 0 then return false end
    return progress >= max
end

