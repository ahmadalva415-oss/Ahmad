local function StartAutoFarm()
    if AutoFarmConn then AutoFarmConn:Disconnect() end
    Config.AutoFarm = true
    State.CurrentTarget = nil
    State.IsApproaching = false
    State.IsLocked = false
    State.CurrentQuestType = nil
    State.CurrentRegion = nil
    State.PendingBossQuest = nil
    State.CachedHasQuest = false
    State.QuestInProgress = false
    State.LastHeavyCheck = 0
    State.LastBossSwitch = 0
    State.LastLevelUpdate = 0
    State.LastRegionFromLevel = nil

    RefreshEnemyCache()
    UpdateLevel()
    TakeQuest()

    AutoFarmConn = RunService.Heartbeat:Connect(function()
        if not Config.AutoFarm then return end
        local root = GetRoot()
        if not root then return end

        -- Level update + region detection
        if tick() - State.LastLevelUpdate > Config.LevelUpdateInterval then
            State.LastLevelUpdate = tick()
            local oldLevel = State.PlayerLevel
            UpdateLevel()

            local newRegion
            if State.PlayerLevel >= LVL.HOYUZO_MIN then newRegion = "hoyuzo"
            elseif State.PlayerLevel >= LVL.KAIDEN_MIN then newRegion = "kaiden"
            elseif State.PlayerLevel >= LVL.BEAR_MIN then newRegion = "bear"
            else newRegion = "bandit" end

            if State.LastRegionFromLevel == nil then
                State.LastRegionFromLevel = newRegion
            elseif newRegion ~= State.LastRegionFromLevel then
                print(("[Auto Farm] Level %d -> %d | Region %s -> %s")
                    :format(oldLevel, State.PlayerLevel, State.LastRegionFromLevel, newRegion))
                State.LastRegionFromLevel = newRegion

                if not State.QuestInProgress then
                    State.CurrentTarget = nil
                    State.IsLocked = false
                    State.IsApproaching = false
                    CancelTween()
                    State.PendingBossQuest = nil
                    State.CachedHasQuest = false
                    State.CurrentQuestType = nil
                    State.CurrentRegion = nil
                    State.LastQuestTime = 0
                    task.spawn(function()
                        task.wait(0.5)
                        if Config.AutoFarm then TakeQuest() end
                    end)
                end
            end
        end

        -- Hoyuzo guards override
        if State.PlayerLevel >= LVL.HOYUZO_MIN and State.PlayerLevel < LVL.HOYUZO_BOSS then
            if State.CachedHasQuest and State.CurrentQuestType ~= "hoyuzo"
               and tick() - State.LastQuestTime > Config.QuestCheckInterval
               and not State.QuestInProgress then
                State.CurrentTarget = nil
                State.IsLocked = false
                State.IsApproaching = false
                CancelTween()
                State.PendingBossQuest = nil
                TakeQuest("hoyuzo")
                State.LastQuestTime = tick()
                return
            end
        end

        -- Kaiden sub override
        if State.PlayerLevel >= LVL.KAIDEN_MIN and State.PlayerLevel < LVL.KAIDEN_BOSS then
            if State.CachedHasQuest and State.CurrentQuestType ~= "kaiden"
               and tick() - State.LastQuestTime > Config.QuestCheckInterval
               and not State.QuestInProgress then
                State.CurrentTarget = nil
                State.IsLocked = false
                State.IsApproaching = false
                CancelTween()
                State.PendingBossQuest = nil
                TakeQuest("kaiden")
                State.LastQuestTime = tick()
                return
            end
        end

        -- Boss pending detection
        if State.CachedHasQuest and not State.QuestInProgress
           and tick() - State.LastBossSwitch > Config.BossSwitchDelay then
            if State.CurrentQuestType == "bearcub"
               and State.PlayerLevel >= LVL.BEAR_BOSS
               and State.PlayerLevel < LVL.KAIDEN_MIN then
                RefreshEnemyCache()
                if BossAlive("Mother Bear") and not State.PendingBossQuest then
                    State.PendingBossQuest = "bearboss"
                    State.LastBossSwitch = tick()
                end
            end
            if State.CurrentQuestType == "kaiden"
               and State.PlayerLevel >= LVL.KAIDEN_BOSS
               and State.PlayerLevel < LVL.HOYUZO_MIN then
                RefreshEnemyCache()
                if BossAlive("Kaiden") and not State.PendingBossQuest then
                    State.PendingBossQuest = "kaidenboss"
                    State.LastBossSwitch = tick()
                end
            end
        end

        -- Heavy check
        if tick() - State.LastHeavyCheck >= Config.HeavyCheckInterval then
            State.LastHeavyCheck = tick()
            local hasQuest, questType, progress, max = GetQuestInfo()
            State.CachedHasQuest = hasQuest
            State.CachedQuestType = questType
            State.CachedProgress = progress
            State.CachedMax = max

            if hasQuest then State.CurrentQuestType = questType end

            if State.PendingBossQuest == "bearboss" and not BossAlive("Mother Bear") then
                State.PendingBossQuest = nil
            end
            if State.PendingBossQuest == "kaidenboss" and not BossAlive("Kaiden") then
                State.PendingBossQuest = nil
            end

            if not hasQuest then
                if tick() - State.LastQuestTime > Config.QuestCheckInterval
                   and not State.QuestInProgress then
                    local pending = State.PendingBossQuest
                    State.PendingBossQuest = nil
                    TakeQuest(pending)
                    State.LastQuestTime = tick()
                end
            elseif max > 0 and progress >= max then
                if tick() - State.LastQuestTime > Config.QuestCheckInterval
                   and not State.QuestInProgress then
                    print("[Auto Farm] Quest Complete (" .. (questType or "?") .. ")")
                    State.CurrentTarget = nil
                    State.IsLocked = false
                    State.IsApproaching = false
                    CancelTween()
                    local pending = State.PendingBossQuest
                    State.PendingBossQuest = nil
                    TakeQuest(pending)
                    State.LastQuestTime = tick()
                end
            end
        end

        if not State.CachedHasQuest then return end
        if State.CachedMax > 0 and State.CachedProgress >= State.CachedMax then return end

        local target = FindTargetEnemy()
        if not target then
            State.CurrentTarget = nil
            State.IsLocked = false
            State.IsApproaching = false
            return
        end

        if target ~= State.CurrentTarget then
            State.CurrentTarget = target
            State.IsLocked = false
            ApproachEnemy(target)
        end

        if State.IsLocked and State.CurrentTarget and State.CurrentTarget.Parent then
            local attackCF = GetAttackCFrame(State.CurrentTarget)
            if attackCF then
                root.CFrame = attackCF
                if not State.AttackSequenceRunning
                   and tick() - State.LastAttackTime > 0.5 then
                    RunAttackSequence()
                    State.LastAttackTime = tick()
                end
            end
        end
    end)
end

local function StopAutoFarm()
    Config.AutoFarm = false
    State.AttackSequenceRunning = false
    State.CurrentTarget = nil
    State.IsApproaching = false
    State.IsLocked = false
    State.QuestInProgress = false
    State.CurrentQuestType = nil
    State.CurrentRegion = nil
    State.PendingBossQuest = nil
    CancelTween()
    if AutoFarmConn then AutoFarmConn:Disconnect() AutoFarmConn = nil end
    print("[Auto Farm] Stopped")
end

