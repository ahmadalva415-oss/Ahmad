-- COMBO
--========================================================--
local function RunAttackSequence()
    if AttackSequenceRunning then return end
    AttackSequenceRunning = true

    task.spawn(function()
        for _, Move in ipairs(ComboMoves) do
            if not AutoFarmEnabled then break end
            FireSignal("Combat_Service", SelectedWeapon, Move[1], Move[2], Move[3], Move[4])
            local WaitTime = math.abs(Move[3])
            if WaitTime < 0.05 then WaitTime = 0.15 end
            task.wait(WaitTime)
        end
        AttackSequenceRunning = false
    end)
end

--========================================================--
-- MAIN LOOP
--========================================================--
local function StartAutoFarm()
    if AutoFarmConnection then AutoFarmConnection:Disconnect() end

    AutoFarmEnabled = true
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    CurrentQuestType = nil
    CurrentRegion = nil
    LastHeavyCheck = 0
    LastBossSwitchAttempt = 0
    LastLevelUpdate = 0
    PendingBossQuest = nil
    CachedHasQuest = false
    CachedQuestType = nil
    CachedProgress = 0
    CachedMax = 0

    RefreshEnemyCache()
    UpdateLevel()

    TakeQuest()
    task.wait(0.5)

    AutoFarmConnection = RunService.Heartbeat:Connect(function(dt)
        if not AutoFarmEnabled then return end

        local MyRoot = GetRoot()
        if not MyRoot then return end

        if tick() - LastLevelUpdate > LevelUpdateInterval then
            LastLevelUpdate = tick()
            UpdateLevel()
        end

        if PlayerLevel >= HOYUZO_MIN_LEVEL then
            if CachedHasQuest then
                if PlayerLevel >= HOYUZO_BOSS_LEVEL then
                    if CurrentQuestType ~= "hoyuzo" and CurrentQuestType ~= "hoyuzoboss" then
                        if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                            CurrentTarget = nil IsLocked = false IsApproaching = false
                            CancelCurrentTween() PendingBossQuest = nil
                            TakeQuest() LastQuestTime = tick()
                        end
                        return
                    end
                else
                    if CurrentQuestType ~= "hoyuzo" then
                        if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                            CurrentTarget = nil IsLocked = false IsApproaching = false
                            CancelCurrentTween() PendingBossQuest = nil
                            TakeQuest("hoyuzo") LastQuestTime = tick()
                        end
                        return
                    end
                end
            end
        elseif PlayerLevel >= KAIDEN_MIN_LEVEL then
            if PlayerLevel < KAIDEN_BOSS_LEVEL then
                if CachedHasQuest and CurrentQuestType ~= "kaiden" then
                    if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                        CurrentTarget = nil IsLocked = false IsApproaching = false
                        CancelCurrentTween() PendingBossQuest = nil
                        TakeQuest("kaiden") LastQuestTime = tick()
                    end
                    return
                end
            end
        end

        if CachedHasQuest and not QuestInProgress
            and tick() - LastBossSwitchAttempt > BossSwitchDelay then

            if CurrentQuestType == "bearcub"
                and PlayerLevel >= BEAR_BOSS_LEVEL
                and PlayerLevel < KAIDEN_MIN_LEVEL then
                RefreshEnemyCache()
                if IsMotherBearAlive() and not PendingBossQuest then
                    PendingBossQuest = "bearboss"
                    LastBossSwitchAttempt = tick()
                end
            end

            if CurrentQuestType == "kaiden"
                and PlayerLevel >= KAIDEN_BOSS_LEVEL
                and PlayerLevel < HOYUZO_MIN_LEVEL then
                RefreshEnemyCache()
                if IsKaidenAlive() and not PendingBossQuest then
                    PendingBossQuest = "kaidenboss"
                    LastBossSwitchAttempt = tick()
                end
            end
        end

        if tick() - LastHeavyCheck >= HeavyCheckInterval then
            LastHeavyCheck = tick()

            local hasQuest, questType, progress, max = GetQuestInfo()
            CachedHasQuest = hasQuest
            CachedQuestType = questType
            CachedProgress = progress
            CachedMax = max

            if hasQuest then
                CurrentQuestType = questType
            end

            if PendingBossQuest == "bearboss" and not IsMotherBearAlive() then PendingBossQuest = nil end
            if PendingBossQuest == "kaidenboss" and not IsKaidenAlive() then PendingBossQuest = nil end

            if not hasQuest then
                if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                    if PendingBossQuest then
                        local pending = PendingBossQuest
                        PendingBossQuest = nil
                        TakeQuest(pending)
                    else
                        TakeQuest()
                    end
                    LastQuestTime = tick()
                end
            elseif max > 0 and progress >= max then
                if tick() - LastQuestTime > QuestCheckInterval and not QuestInProgress then
                    print("[Auto Farm] Quest Complete! (" .. (questType or "?") .. ")")
                    CurrentTarget = nil IsLocked = false IsApproaching = false
                    CancelCurrentTween()

                    if PendingBossQuest then
                        local pending = PendingBossQuest
                        PendingBossQuest = nil
                        TakeQuest(pending)
                    else
                        TakeQuest()
                    end
                    LastQuestTime = tick()
                end
            end
        end

        if not CachedHasQuest then return end
        if CachedMax > 0 and CachedProgress >= CachedMax then return end

        local Target = FindTargetEnemy()
        if not Target then
            CurrentTarget = nil IsLocked = false IsApproaching = false
            return
        end

        if Target ~= CurrentTarget then
            CurrentTarget = Target
            IsLocked = false
            ApproachEnemy(Target)
        end

        if IsLocked and CurrentTarget and CurrentTarget.Parent then
            local AttackCF = GetAttackCFrame(CurrentTarget)
            if AttackCF then
                MyRoot.CFrame = AttackCF
                if not AttackSequenceRunning then
                    if tick() - LastAttackTime > 0.5 then
                        RunAttackSequence()
                        LastAttackTime = tick()
                    end
                end
            end
        end
    end)
end

local function StopAutoFarm()
    AutoFarmEnabled = false
    AttackSequenceRunning = false
    CurrentTarget = nil IsApproaching = false IsLocked = false
    QuestInProgress = false CurrentQuestType = nil CurrentRegion = nil
    PendingBossQuest = nil
    CancelCurrentTween()
    if AutoFarmConnection then
        AutoFarmConnection:Disconnect()
        AutoFarmConnection = nil
    end
end

