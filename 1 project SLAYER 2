-- ============================================================
-- Anti-Lag
-- ============================================================
local function SaveLighting()
    if SavedLighting.Saved then return end
    SavedLighting.FogEnd = Lighting.FogEnd
    SavedLighting.FogStart = Lighting.FogStart
    SavedLighting.Brightness = Lighting.Brightness
    SavedLighting.GlobalShadows = Lighting.GlobalShadows
    SavedLighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    SavedLighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    SavedLighting.Ambient = Lighting.Ambient
    SavedLighting.OutdoorAmbient = Lighting.OutdoorAmbient
    SavedLighting.Saved = true
end

local function RestoreLighting()
    if not SavedLighting.Saved then return end
    for k, v in pairs(SavedLighting) do
        if k ~= "Saved" then
            pcall(function() Lighting[k] = v end)
        end
    end
end

local function RunAntiLagPass()
    if not Config.AntiLag then return end
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            if not AntiLagCache[v] then
                AntiLagCache[v] = v.Enabled
                v.Enabled = false
            end
        end
    end
    local scan = Workspace:FindFirstChild("Regions") or Workspace
    for _, v in ipairs(scan:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
           or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")
           or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
            if not AntiLagCache[v] then
                AntiLagCache[v] = true
                pcall(function() v:Destroy() end)
            end
        end
    end
    pcall(function()
        Lighting.FogEnd = 300
        Lighting.FogStart = 0
        Lighting.Brightness = 1
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Ambient = Color3.fromRGB(120, 120, 120)
        Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
        if Terrain then Terrain.Decoration = false end
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") then
                v.Density = 0; v.Haze = 0; v.Glare = 0
            end
        end
    end)
end

local function EnableAntiLag()
    if Config.AntiLag then return end
    Config.AntiLag = true
    AntiLagCache = {}
    SaveLighting()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end)
    RunAntiLagPass()
    AntiLagThread = task.spawn(function()
        while Config.AntiLag do
            task.wait(3)
            RunAntiLagPass()
        end
    end)
    print("[Anti-Lag] Enabled")
end

local function DisableAntiLag()
    if not Config.AntiLag then return end
    Config.AntiLag = false
    if AntiLagThread then
        pcall(function() task.cancel(AntiLagThread) end)
        AntiLagThread = nil
    end
    RestoreLighting()
    for obj, state in pairs(AntiLagCache) do
        if typeof(obj) == "Instance" and obj.Parent then
            pcall(function()
                if obj:IsA("PostEffect") then obj.Enabled = state end
            end)
        end
    end
    AntiLagCache = {}
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        if Terrain then Terrain.Decoration = true end
    end)
    print("[Anti-Lag] Disabled")
end

