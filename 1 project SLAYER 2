--========================================================--
-- HELPERS
--========================================================--
local function GetRoot()
    local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return Char and Char:FindFirstChild("HumanoidRootPart")
end

local function GetSignalEvent()
    local Comm = ReplicatedStorage:FindFirstChild("Communication")
    if not Comm then return nil end
    local SC = Comm:FindFirstChild("ServerAndClient")
    if not SC then return nil end
    local Signals = SC:FindFirstChild("Signals")
    if not Signals then return nil end
    return Signals:FindFirstChild("SignalEvent")
end

local function FireSignal(...)
    local SignalEvent = GetSignalEvent()
    if not SignalEvent then return false end
    local args = {...}
    return pcall(function()
        if SignalEvent:FindFirstChild("Event") then
            SignalEvent.Event:FireServer(table.unpack(args))
        else
            SignalEvent:FireServer(table.unpack(args))
        end
    end)
end

--========================================================--
-- LEVEL READER
--========================================================--
local function FindLevelData()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local lvMatch = obj.Text:match("Lv%s*(%d+)")
                if lvMatch then
                    local Level = tonumber(lvMatch)
                    local Exp, MaxExp = 0, 0
                    local parent = obj.Parent
                    if parent then
                        for _, sib in ipairs(parent:GetDescendants()) do
                            if sib:IsA("TextLabel") and sib ~= obj then
                                local xp, mxp = sib.Text:match("(%d+)%s*/%s*(%d+)")
                                if xp and mxp then
                                    Exp = tonumber(xp)
                                    MaxExp = tonumber(mxp)
                                    break
                                end
                            end
                        end
                    end
                    return Level, Exp, MaxExp
                end
            end
        end
    end
    for name, value in pairs(LocalPlayer:GetAttributes()) do
        if typeof(value) == "number" then
            local n = string.lower(name)
            if n:find("level") or n == "lv" then return value, 0, 0 end
        end
    end
    return 0, 0, 0
end

local function UpdateLevel()
    local lv, exp, max = FindLevelData()
    PlayerLevel = lv
    PlayerExp = exp
    PlayerMaxExp = max
end

--========================================================--
-- QUEST DETECTION
--========================================================--
local function GetQuestInfo()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, nil, 0, 0 end

    local hasQuest = false
    local questType = nil
    local progress = 0
    local max = 0

    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            local text = obj.Text

            -- Boss Quest
            if text:find("Defeat The Bandit Boss") or text:find("Defeat Zuko") then
                hasQuest = true
                questType = "boss"
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end

            -- Bandit Quest
            if text:find("Defeat 3 bandits") or text:find("Bandits remaining") then
                if not hasQuest then
                    hasQuest = true
                    questType = "bandit"
                end
                local cur, mx = text:match("(%d+)%s*/%s*(%d+)")
                if cur then
                    progress = tonumber(cur)
                    max = tonumber(mx)
                end
            end
        end
    end

    return hasQuest, questType, progress, max
end

local function HasActiveQuest()
    local hasQuest = GetQuestInfo()
    return hasQuest
end

-- ✅ الإصلاح: خلصت فقط لما نصل للهدف (بدون progress == 0)
local function IsQuestComplete()
    local hasQuest, questType, progress, max = GetQuestInfo()
    if not hasQuest then return false end
    if max <= 0 then return false end
    return progress >= max
end

--========================================================--
-- ENEMY CACHE
--========================================================--
local function RefreshEnemyCache()
    CachedEnemies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Bandit" or obj.Name == "Zuko" then
            local Hum = obj:FindFirstChildOfClass("Humanoid")
            local Root = obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("Torso")
            if Hum or Root then
                table.insert(CachedEnemies, obj)
            end
        end
    end
    CacheTime = tick()
end

local function GetCachedEnemies()
    if tick() - CacheTime > CACHE_INTERVAL then
        RefreshEnemyCache()
    end
    return CachedEnemies
end

local function GetEnemyRoot(Enemy)
    if not Enemy then return nil end
    return Enemy:FindFirstChild("HumanoidRootPart")
        or Enemy:FindFirstChild("UpperTorso")
        or Enemy:FindFirstChild("Torso")
        or Enemy:FindFirstChildWhichIsA("BasePart")
end

local function IsEnemyAlive(Enemy)
    if not Enemy or not Enemy.Parent then return false end
    local Hum = Enemy:FindFirstChildOfClass("Humanoid")
    if Hum then return Hum.Health > 0 end
    return GetEnemyRoot(Enemy) ~= nil
end

local function IsZukoAlive()
    for _, Enemy in ipairs(GetCachedEnemies()) do
        if Enemy.Name == "Zuko" and IsEnemyAlive(Enemy) then
            return true
        end
    end
    return false
end

--========================================================--
-- PRONE CFrame
--========================================================--
local function GetProneCFrame(Enemy)
    if not Enemy then return nil end
    local Head = Enemy:FindFirstChild("Head")
    if not Head then return nil end
    local AbovePos = Head.Position + Vector3.new(0, AboveHeadHeight, 0)
    return CFrame.new(AbovePos) * CFrame.Angles(math.rad(-ProneAngle), 0, 0)
end

--========================================================--
-- TAKE QUEST
--========================================================--
local function TakeQuest(questType)
    if QuestInProgress then return end
    QuestInProgress = true

    task.spawn(function()
        UpdateLevel()

        -- 1. نروح للأحداثيات
        local MyRoot = GetRoot()
        if MyRoot then
            MyRoot.CFrame = CFrame.new(QuestCoords)
            task.wait(0.3)
        end

        -- 2. نرسل الريموت
        if questType == "boss" then
            FireSignal("AddQuest", "Ill take the bandit boss(Lv 7)")
            CurrentQuestType = "boss"
            print("[Auto Quest] → Boss Quest")
        elseif questType == "bandit" then
            FireSignal("AddQuest", "Ill take 3 bandits")
            CurrentQuestType = "bandit"
            print("[Auto Quest] → Bandit Quest")
        else
            -- auto حسب Zuko والفل
            if PlayerLevel >= MIN_LEVEL and IsZukoAlive() then
                FireSignal("AddQuest", "Ill take the bandit boss(Lv 7)")
                CurrentQuestType = "boss"
                print("[Auto Quest] Zuko موجود → Boss")
            else
                FireSignal("AddQuest", "Ill take 3 bandits")
                CurrentQuestType = "bandit"
                print("[Auto Quest] → Bandits")
            end
        end

        task.wait(0.3)
        QuestInProgress = false
        LastQuestTime = tick()
    end)
end

--========================================================--
-- FIND TARGET
--========================================================--
local function FindTargetEnemy()
    local MyRoot = GetRoot()
    if not MyRoot then return nil end

    local Enemies = GetCachedEnemies()
    local Nearest = nil
    local ShortestDist = math.huge

    if CurrentQuestType == "boss" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Zuko" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        if not Nearest then
            for _, Enemy in ipairs(Enemies) do
                if Enemy.Name == "Bandit" and IsEnemyAlive(Enemy) then
                    local ERoot = GetEnemyRoot(Enemy)
                    if ERoot then
                        local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                        if Dist < ShortestDist then
                            ShortestDist = Dist
                            Nearest = Enemy
                        end
                    end
                end
            end
        end
        return Nearest
    end

    if CurrentQuestType == "bandit" then
        for _, Enemy in ipairs(Enemies) do
            if Enemy.Name == "Bandit" and IsEnemyAlive(Enemy) then
                local ERoot = GetEnemyRoot(Enemy)
                if ERoot then
                    local Dist = (MyRoot.Position - ERoot.Position).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Nearest = Enemy
                    end
                end
            end
        end
        return Nearest
    end

    return nil
end

--========================================================--
-- APPROACH
--========================================================--
local function CancelCurrentTween()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
end

local function ApproachEnemy(Enemy)
    if not Enemy or IsApproaching then return end
    IsApproaching = true
    IsLocked = false

    task.spawn(function()
        local MyRoot = GetRoot()
        if not MyRoot then IsApproaching = false return end

        local TargetCF = GetProneCFrame(Enemy)
        if not TargetCF then IsApproaching = false return end

        local MyPos = MyRoot.Position
        local TargetPos = TargetCF.Position
        local HorizDist = (Vector3.new(MyPos.X, 0, MyPos.Z)
            - Vector3.new(TargetPos.X, 0, TargetPos.Z)).Magnitude

        if HorizDist > 0.3 then
            local Duration = math.max(HorizDist / TweenSpeed, 0.15)
            local HorizCF = CFrame.new(
                Vector3.new(TargetPos.X, MyPos.Y, TargetPos.Z)
            ) * CFrame.Angles(math.rad(-ProneAngle), 0, 0)

            CancelCurrentTween()
            CurrentTween = TweenService:Create(MyRoot,
                TweenInfo.new(Duration, Enum.EasingStyle.Linear),
                { CFrame = HorizCF })

            local Done = false
            local Conn = CurrentTween.Completed:Connect(function() Done = true end)
            CurrentTween:Play()

            local Elapsed = 0
            while not Done and Elapsed < Duration + 0.3 do
                task.wait(0.03)
                Elapsed = Elapsed + 0.03
                if not AutoFarmEnabled then
                    CancelCurrentTween()
                    if Conn then Conn:Disconnect() end
                    IsApproaching = false
                    return
                end
            end
            if Conn then Conn:Disconnect() end
        end

        MyRoot = GetRoot()
        if not MyRoot then IsApproaching = false return end

        local VertDist = TargetPos.Y - MyRoot.Position.Y
        if math.abs(VertDist) > 0.3 then
            local Duration = math.max(math.abs(VertDist) / TweenSpeed, 0.1)
            CancelCurrentTween()
            CurrentTween = TweenService:Create(MyRoot,
                TweenInfo.new(Duration, Enum.EasingStyle.Linear),
                { CFrame = TargetCF })

            local Done = false
            local Conn = CurrentTween.Completed:Connect(function() Done = true end)
            CurrentTween:Play()

            local Elapsed = 0
            while not Done and Elapsed < Duration + 0.3 do
                task.wait(0.03)
                Elapsed = Elapsed + 0.03
                if not AutoFarmEnabled then
                    CancelCurrentTween()
                    if Conn then Conn:Disconnect() end
                    IsApproaching = false
                    return
                end
            end
            if Conn then Conn:Disconnect() end
        end

        IsLocked = true
        IsApproaching = false
    end)
end

--========================================================--
-- COMBO
--========================================================--
local function RunAttackSequence()
    if AttackSequenceRunning then return end
    AttackSequenceRunning = true

    task.spawn(function()
        for _, Move in ipairs(ComboMoves) do
            if not AutoFarmEnabled then break end
            FireSignal("Combat_Service", "Combat", Move[1], Move[2], Move[3], Move[4])
            local WaitTime = math.abs(Move[3])
            if WaitTime < 0.05 then WaitTime = 0.15 end
            task.wait(WaitTime)
        end
        AttackSequenceRunning = false
    end)
end

--========================================================--
-- MAIN LOOP
--========================================================--
local function StartAutoFarm()
    if AutoFarmConnection then AutoFarmConnection:Disconnect() end
    AutoFarmEnabled = true
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    CurrentQuestType = nil

    RefreshEnemyCache()
    UpdateLevel()

    -- ارسل المهمة أول
    if not HasActiveQuest() then
        TakeQuest()
        task.wait(0.5)
    end

    AutoFarmConnection = RunService.Heartbeat:Connect(function(dt)
        if not AutoFarmEnabled then return end

        local MyRoot = GetRoot()
        if not MyRoot then return end

        -- اقرأ المهمة
        local hasQuest, questType, progress, max = GetQuestInfo()
        if hasQuest then
            CurrentQuestType = questType
        end

        -- لو ما فيه مهمة → ارسل وحدة
        if not hasQuest then
            if tick() - LastQuestTime > 1.5 and not QuestInProgress then
                TakeQuest()
                LastQuestTime = tick()
            end
            return
        end

        -- لو المهمة خلصت → ارسل وحدة
        if IsQuestComplete() then
            if tick() - LastQuestTime > 1.5 and not QuestInProgress then
                print("[Auto Farm] ✅ Quest Complete! (" .. (questType or "?") .. ")")
                CurrentTarget = nil
                IsLocked = false
                IsApproaching = false
                CancelCurrentTween()
                TakeQuest()
                LastQuestTime = tick()
            end
            return
        end

        -- ابحث عن الهدف
        local Target = FindTargetEnemy()
        if not Target then
            CurrentTarget = nil
            IsLocked = false
            IsApproaching = false
            return
        end

        -- هدف جديد → اقترب
        if Target ~= CurrentTarget then
            CurrentTarget = Target
            IsLocked = false
            ApproachEnemy(Target)
        end

        -- قفل + ضرب
        if IsLocked and CurrentTarget and CurrentTarget.Parent then
            local ProneCF = GetProneCFrame(CurrentTarget)
            if ProneCF then
                MyRoot.CFrame = ProneCF
                if not AttackSequenceRunning then
                    if tick() - LastAttackTime > 0.5 then
                        RunAttackSequence()
                        LastAttackTime = tick()
                    end
                end
            end
        end
    end)
end

local function StopAutoFarm()
    AutoFarmEnabled = false
    AttackSequenceRunning = false
    CurrentTarget = nil
    IsApproaching = false
    IsLocked = false
    QuestInProgress = false
    CurrentQuestType = nil
    CancelCurrentTween()
    if AutoFarmConnection then
        AutoFarmConnection:Disconnect()
        AutoFarmConnection = nil
    end
end

