local function GetQuestPanel()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local comp = pg:FindFirstChild("ComponentsHolder")
    if not comp then return nil end
    local lcf = comp:FindFirstChild("LeftCenterFramesHolder")
    if not lcf then return nil end
    local zq = lcf:FindFirstChild("zQuestsFrame")
    if not zq then return nil end
    return zq:FindFirstChild("Panel")
end

local function IsInsideQuestPanel(obj)
    local panel = GetQuestPanel()
    if not panel then return false end
    local p = obj
    while p do
        if p == panel then return true end
        p = p.Parent
    end
    return false
end

local function GetCurrentWeapon()
    if not Config.AutoWeapon then return Config.SelectedWeapon end
    local char = GetChar()
    if not char then return "Combat" end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then return t.Name end
    end
    return "Combat"
end

-- ============================================================
-- Level reader
-- ============================================================
local function FindLevelData()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return 0, 0, 0 end

    local candidates = {}
    for _, obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local lvMatch = obj.Text:match("^%s*Lv%s*(%d+)%s*$")
            if lvMatch then
                local absPos
                pcall(function() absPos = obj.AbsolutePosition end)
                table.insert(candidates, {
                    Level = tonumber(lvMatch),
                    InQuest = IsInsideQuestPanel(obj),
                    Pos = absPos, Obj = obj,
                })
            end
        end
    end

    for _, c in ipairs(candidates) do
        if not c.InQuest and c.Pos and c.Pos.X >= 0 and c.Pos.X < 500
           and c.Pos.Y >= 0 and c.Pos.Y < 250 then
            local exp, maxExp = 0, 0
            local parent = c.Obj.Parent
            if parent then
                for _, sib in ipairs(parent:GetDescendants()) do
                    if sib:IsA("TextLabel") and sib ~= c.Obj then
                        local xp, mxp = sib.Text:match("^%s*(%d+)%s*/%s*(%d+)%s*$")
                        if xp and mxp then
                            exp, maxExp = tonumber(xp), tonumber(mxp)
                            break
                        end
                    end
                end
            end
            return c.Level, exp, maxExp
        end
    end

    for _, c in ipairs(candidates) do
        if not c.InQuest then return c.Level, 0, 0 end
    end
    if #candidates > 0 then return candidates[1].Level, 0, 0 end

    for name, value in pairs(LocalPlayer:GetAttributes()) do
        if typeof(value) == "number" then
            local n = string.lower(name)
            if n:find("level") or n == "lv" then return value, 0, 0 end
        end
    end
    return 0, 0, 0
end

local function UpdateLevel()
    local lv, exp, maxExp = FindLevelData()
    State.PlayerLevel = lv
    State.PlayerExp = exp
    State.PlayerMaxExp = maxExp
end

