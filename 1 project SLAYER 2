        local now = tick()
        local fps = math.floor(frames / (now - lastTime))
        frames = 0
        lastTime = now
        if FpsParagraph then
            pcall(function()
                FpsParagraph:SetDesc("FPS: " .. fps .. " | Anti-Lag: " .. (AntiLagEnabled and "ON" or "OFF") .. " | Weapon: " .. SelectedWeapon)
            end)
        end
    end
end)

