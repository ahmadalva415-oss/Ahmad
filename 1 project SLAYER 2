local function IsQuestAbandoned()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local comp = pg:FindFirstChild("ComponentsHolder")
    if not comp then return false end
    for _, obj in ipairs(comp:GetChildren()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
            if obj.Text:find("Abandoned Quest") then return true end
        end
    end
    return false
end

local function GetQuestInfo()
    local panel = GetQuestPanel()
    if not panel then return false, nil, 0, 0 end
    if IsQuestAbandoned() then return false, nil, 0, 0 end

    local allText = {}
    for _, obj in ipairs(panel:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text ~= "" then
            table.insert(allText, obj.Text)
        end
    end
    local s = table.concat(allText, " | ")

    local function extract()
        local cur, mx = s:match("(%d+)%s*/%s*(%d+)")
        return tonumber(cur) or 0, tonumber(mx) or 0
    end

    -- ⚠ الترتيب حساس: specific أولًا!
    if s:find("Subordinates defeated") then
        local p, m = extract(); return true, "kaiden", p, m
    end
    if s:find("Guards defeated") then
        local p, m = extract(); return true, "hoyuzo", p, m
    end
    if s:find("Bear Cubs hunted") then
        local p, m = extract(); return true, "bearcub", p, m
    end
    if s:find("Bandits remaining") then
        local p, m = extract(); return true, "bandit", p, m
    end
    if s:find("Defeat Hoyuzo") or s:find("take care of Hoyuzo") then
        local p, m = extract(); return true, "hoyuzoboss", p, m
    end
    if s:find("Defeat Kaiden") or s:find("at Kaiden") or s:find("Ill deal with Kaiden") then
        local p, m = extract(); return true, "kaidenboss", p, m
    end
    if s:find("Mother Bear") or s:find("Hunt the Bears") then
        local p, m = extract(); return true, "bearboss", p, m
    end
    if s:find("Defeat The Bandit Boss") or s:find("Defeat Zuko") then
        local p, m = extract(); return true, "banditboss", p, m
    end
    if s:find("Defeat 3 bandits") then
        local p, m = extract(); return true, "bandit", p, m
    end

    return false, nil, 0, 0
end

-- ============================================================
-- Enemy cache
-- ============================================================
local ENEMY_NAMES = {
    ["Bear Cub"] = true, ["Mother Bear"] = true,
    ["Bandit"] = true, ["Zuko"] = true,
    ["Kaiden Subordinate"] = true, ["Kaiden"] = true,
    ["Hoyuzo Subordinate"] = true, ["Hoyuzo"] = true,
}

local function RefreshEnemyCache()
    State.CachedEnemies = {}
    local Regions = Workspace:FindFirstChild("Regions") or Workspace
    for _, obj in ipairs(Regions:GetDescendants()) do
        if ENEMY_NAMES[obj.Name] and obj:FindFirstChildOfClass("Humanoid") then
            table.insert(State.CachedEnemies, obj)
        end
    end
    State.CacheTime = tick()
end

local function GetCachedEnemies()
    if tick() - State.CacheTime > CACHE_INTERVAL then
        RefreshEnemyCache()
    end
    return State.CachedEnemies
end

local function GetEnemyRoot(enemy)
    if not enemy then return nil end
    return enemy:FindFirstChild("HumanoidRootPart")
        or enemy:FindFirstChild("UpperTorso")
        or enemy:FindFirstChild("Torso")
        or enemy:FindFirstChildWhichIsA("BasePart")
end

local function IsEnemyAlive(enemy)
    if not enemy or not enemy.Parent then return false end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health > 0 end
    return GetEnemyRoot(enemy) ~= nil
end

local function BossAlive(name)
    for _, e in ipairs(GetCachedEnemies()) do
        if e.Name == name and IsEnemyAlive(e) then return true end
    end
    return false
end

-- ============================================================
-- Attack CFrame
-- ============================================================
local function GetAttackCFrame(enemy)
    if not enemy then return nil end
    local head = enemy:FindFirstChild("Head")
    if not head then return nil end

    if Config.AttackPosition == "above" then
        local pos = head.Position + Vector3.new(0, Config.AboveHeadHeight, 0)
        return CFrame.new(pos) * CFrame.Angles(math.rad(-Config.ProneAngle), 0, 0)
    end
    if Config.AttackPosition == "behind" then
        local eRoot = GetEnemyRoot(enemy)
        local look = eRoot and eRoot.CFrame.LookVector or head.CFrame.LookVector
        local pos = head.Position - look * Config.AttackDistance + Vector3.new(0, 2, 0)
        return CFrame.lookAt(pos, head.Position)
    end
    if Config.AttackPosition == "below" then
        local pos = head.Position - Vector3.new(0, Config.AttackDistance, 0)
        return CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0)
    end
    return nil
end

-- ============================================================
-- Teleport
-- ============================================================
local function TeleportTo(targetCF)
    local attempts = 0
    while attempts < Config.TeleportMaxAttempts do
        local root = GetRoot()
        if not root then
            task.wait(0.1); attempts = attempts + 1
        else
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            root.CFrame = targetCF
            if (root.Position - targetCF.Position).Magnitude <= Config.TeleportDistance then
                return true
            end
            task.wait(0.08); attempts = attempts + 1
        end
    end
    local root = GetRoot()
    return root and (root.Position - targetCF.Position).Magnitude <= Config.TeleportDistance
end

-- ============================================================
-- Decide region + quest
-- ============================================================
local function DecideRegionAndQuest()
    UpdateLevel()
    RefreshEnemyCache()

    if State.PlayerLevel >= LVL.HOYUZO_MIN then
        State.CurrentRegion = "hoyuzo"
        State.CurrentQuestCoords = COORDS.Hoyuzo
        return "hoyuzo"
    end
    if State.PlayerLevel >= LVL.KAIDEN_MIN then
        State.CurrentRegion = "kaiden"
        State.CurrentQuestCoords = COORDS.Kaiden
        if State.PlayerLevel >= LVL.KAIDEN_BOSS and BossAlive("Kaiden") then
            return "kaidenboss"
        end
        return "kaiden"
    end
    if State.PlayerLevel >= LVL.BEAR_MIN then
        State.CurrentRegion = "bear"
        State.CurrentQuestCoords = COORDS.Bear
        if State.PlayerLevel >= LVL.BEAR_BOSS and BossAlive("Mother Bear") then
            return "bearboss"
        end
        return "bearcub"
    end
    if State.PlayerLevel >= LVL.BANDIT_BOSS_MIN then
        State.CurrentRegion = "bandit"
        State.CurrentQuestCoords = COORDS.Bandit
        if BossAlive("Zuko") then return "banditboss" end
        return "bandit"
    end
    State.CurrentRegion = "bandit"
    State.CurrentQuestCoords = COORDS.Bandit
    return "bandit"
end

-- ============================================================
-- Hoyuzo special check
-- ============================================================
local function CheckHoyuzoBossAlive()
    local root = GetRoot()
    if not root then return false end
    local saved = root.CFrame
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    root.CFrame = CFrame.new(COORDS.HoyuzoBoss)
    task.wait(0.35)
    RefreshEnemyCache()
    local alive = BossAlive("Hoyuzo")
    pcall(function() root.CFrame = saved end)
    task.wait(0.1)
    return alive
end

-- ============================================================
-- Take quest
-- ============================================================
local function TakeQuest(forceType)
    if State.QuestInProgress then return end
    State.QuestInProgress = true

    task.spawn(function()
        UpdateLevel()
        local questType = forceType

        if not questType and State.PlayerLevel >= LVL.HOYUZO_BOSS then
            local alive = CheckHoyuzoBossAlive()
            questType = alive and "hoyuzoboss" or "hoyuzo"
        end
        if not questType then questType = DecideRegionAndQuest() end

        if questType == "hoyuzo" or questType == "hoyuzoboss" then
            State.CurrentRegion = "hoyuzo"
            State.CurrentQuestCoords = COORDS.Hoyuzo
        elseif questType == "kaiden" or questType == "kaidenboss" then
            State.CurrentRegion = "kaiden"
            State.CurrentQuestCoords = COORDS.Kaiden
        elseif questType == "bearcub" or questType == "bearboss" then
            State.CurrentRegion = "bear"
            State.CurrentQuestCoords = COORDS.Bear
        else
            State.CurrentRegion = "bandit"
            State.CurrentQuestCoords = COORDS.Bandit
        end

        TeleportTo(CFrame.new(State.CurrentQuestCoords))
        task.wait(0.3)

        local root = GetRoot()
        if root then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            root.CFrame = CFrame.new(State.CurrentQuestCoords)
        end
        task.wait(0.1)

        local questMsg = ({
            banditboss = "Ill take the bandit boss(Lv 7)",
            bandit     = "Ill take 3 bandits",
            bearboss   = "Ill fell the Mother Bear(Lv 18)",
            bearcub    = "Ill drive the bears back(Lv 10)",
            kaiden     = "Ill clear out his subordinates(Lv 26)",
            kaidenboss = "Ill deal with Kaiden(Lv 34)",
            hoyuzo     = "I will clear out his guards(Lv 40)",
            hoyuzoboss = "I will take care of Hoyuzo(Lv 50)",
        })[questType]

        if questMsg then
            FireSignal("AddQuest", questMsg)
            State.CurrentQuestType = questType
            print("[Auto Quest] -> " .. tostring(questType))
        end

        task.wait(0.3)
        State.QuestInProgress = false
        State.LastQuestTime = tick()
    end)
end

-- ============================================================
-- Target finder
-- ============================================================
local function FindTargetEnemy()
    local root = GetRoot()
    if not root then return nil end
    local enemies = GetCachedEnemies()
    local nearest, shortest = nil, math.huge

    local function scan(name)
        for _, e in ipairs(enemies) do
            if e.Name == name and IsEnemyAlive(e) then
                local er = GetEnemyRoot(e)
                if er then
                    local d = (root.Position - er.Position).Magnitude
                    if d < shortest then
                        shortest = d; nearest = e
                    end
                end
            end
        end
    end

    local qt = State.CurrentQuestType

    if qt == "hoyuzoboss" then
        scan("Hoyuzo")
        if not nearest then
            if (root.Position - COORDS.HoyuzoBoss).Magnitude > 100 then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                root.CFrame = CFrame.new(COORDS.HoyuzoBoss)
                task.wait(0.4)
                RefreshEnemyCache()
                scan("Hoyuzo")
            end
        end
        return nearest
    end
    if qt == "hoyuzo" then scan("Hoyuzo Subordinate"); return nearest end
    if qt == "kaiden" then scan("Kaiden Subordinate"); return nearest end
    if qt == "kaidenboss" then
        scan("Kaiden")
        if not nearest then scan("Kaiden Subordinate") end
        return nearest
    end
    if qt == "bandit" then scan("Bandit"); return nearest end
    if qt == "banditboss" then
        scan("Zuko")
        if not nearest then scan("Bandit") end
        return nearest
    end
    if qt == "bearboss" then
        scan("Mother Bear")
        if not nearest then scan("Bear Cub") end
        return nearest
    end
    if qt == "bearcub" then scan("Bear Cub"); return nearest end
    return nil
end

-- ============================================================
-- Approach
-- ============================================================
local function CancelTween()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
end

local function ApproachEnemy(enemy)
    if not enemy or State.IsApproaching then return end
    State.IsApproaching = true
    State.IsLocked = false

    task.spawn(function()
        local root = GetRoot()
        if not root then State.IsApproaching = false return end
        local targetCF = GetAttackCFrame(enemy)
        if not targetCF then State.IsApproaching = false return end

        local dist = (root.Position - targetCF.Position).Magnitude
        if dist > 0.3 then
            local duration = math.max(dist / Config.TweenSpeed, 0.15)
            CancelTween()
            CurrentTween = TweenService:Create(
                root, TweenInfo.new(duration, Enum.EasingStyle.Linear),
                { CFrame = targetCF }
            )
            local done = false
            local conn = CurrentTween.Completed:Connect(function() done = true end)
            CurrentTween:Play()
            local elapsed = 0
            while not done and elapsed < duration + 0.3 do
                task.wait(0.03); elapsed = elapsed + 0.03
                if not Config.AutoFarm then
                    CancelTween()
                    if conn then conn:Disconnect() end
                    State.IsApproaching = false
                    return
                end
            end
            if conn then conn:Disconnect() end
        end
        State.IsLocked = true
        State.IsApproaching = false
    end)
end

-- ============================================================
-- Attack combo
-- ============================================================
local function RunAttackSequence()
    if State.AttackSequenceRunning then return end
    State.AttackSequenceRunning = true

    task.spawn(function()
        local weapon = GetCurrentWeapon()
        for _, m in ipairs(ComboMoves) do
            if not Config.AutoFarm then break end
            FireSignal("Combat_Service", weapon, m[1], m[2], m[3], m[4])
            local waitT = math.abs(m[3])
            if waitT < 0.05 then waitT = 0.15 end
            task.wait(waitT)
        end
        State.AttackSequenceRunning = false
    end)
end

