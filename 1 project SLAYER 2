-- HOYUZO BOSS CHECK
--========================================================--
local function CheckHoyuzoBossAlive()
    local MyRoot = GetRoot()
    if not MyRoot then return false end
    local savedCF = MyRoot.CFrame

    pcall(function()
        MyRoot.AssemblyLinearVelocity = Vector3.zero
        MyRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    MyRoot.CFrame = CFrame.new(HoyuzoBossCoords)
    task.wait(0.35)

    RefreshEnemyCache()
    local alive = IsHoyuzoAlive()

    pcall(function()
        MyRoot.CFrame = savedCF
    end)
    task.wait(0.1)

    return alive
end

--========================================================--
-- ATTACK CFrame
--========================================================--
local function GetAttackCFrame(Enemy)
    if not Enemy then return nil end
    local Head = Enemy:FindFirstChild("Head")
    if not Head then return nil end

    if AttackPosition == "above" then
        local AbovePos = Head.Position + Vector3.new(0, AboveHeadHeight, 0)
        return CFrame.new(AbovePos) * CFrame.Angles(math.rad(-ProneAngle), 0, 0)
    end

    if AttackPosition == "behind" then
        local EnemyRoot = GetEnemyRoot(Enemy)
        local LookVec = EnemyRoot and EnemyRoot.CFrame.LookVector or Head.CFrame.LookVector
        local BehindPos = Head.Position - LookVec * AttackDistance + Vector3.new(0, 2, 0)
        return CFrame.lookAt(BehindPos, Head.Position)
    end

    if AttackPosition == "below" then
        local BelowPos = Head.Position - Vector3.new(0, AttackDistance, 0)
        return CFrame.new(BelowPos) * CFrame.Angles(math.rad(90), 0, 0)
    end

    return nil
end

--========================================================--
-- TELEPORT
--========================================================--
local function TeleportToQuest(coords)
    local target = CFrame.new(coords)
    local attempts = 0
    while attempts < TeleportMaxAttempts do
        if not AutoFarmEnabled and attempts > 0 then return false end
        local MyRoot = GetRoot()
        local Hum = GetHumanoid()
        if not MyRoot or not Hum then
            task.wait(0.1)
            attempts = attempts + 1
            continue
        end
        pcall(function()
            MyRoot.AssemblyLinearVelocity = Vector3.zero
            MyRoot.AssemblyAngularVelocity = Vector3.zero
        end)
        MyRoot.CFrame = target
        local dist = (MyRoot.Position - coords).Magnitude
        if dist <= TeleportDistance then
            MyRoot.CFrame = target
            return true
        end
        task.wait(0.08)
        attempts = attempts + 1
    end
    local MyRoot = GetRoot()
    if MyRoot then
        return (MyRoot.Position - coords).Magnitude <= TeleportDistance
    end
    return false
end

--========================================================--
-- DECIDE REGION + QUEST
--========================================================--
local function DecideRegionAndQuest()
    UpdateLevel()
    RefreshEnemyCache()

    if PlayerLevel >= HOYUZO_MIN_LEVEL then
        CurrentRegion = "hoyuzo"
        CurrentQuestCoords = HoyuzoCoords
        return "hoyuzo"
    end

    if PlayerLevel >= KAIDEN_MIN_LEVEL then
        CurrentRegion = "kaiden"
        CurrentQuestCoords = KaidenCoords
        if PlayerLevel >= KAIDEN_BOSS_LEVEL then
            if IsKaidenAlive() then
                return "kaidenboss"
            else
                return "kaiden"
            end
        end
        return "kaiden"
    end

    if PlayerLevel <= BANDIT_REGULAR_MAX then
        CurrentRegion = "bandit"
        CurrentQuestCoords = BanditCoords
        return "bandit"
    end

    if PlayerLevel >= BANDIT_BOSS_MIN and PlayerLevel <= BANDIT_BOSS_MAX then
        CurrentRegion = "bandit"
        CurrentQuestCoords = BanditCoords
        return "banditboss"
    end

    if PlayerLevel >= BEAR_MIN_LEVEL and PlayerLevel < BEAR_BOSS_LEVEL then
        CurrentRegion = "bear"
        CurrentQuestCoords = BearCoords
        return "bearcub"
    end

    if PlayerLevel >= BEAR_BOSS_LEVEL and PlayerLevel < KAIDEN_MIN_LEVEL then
        CurrentRegion = "bear"
        CurrentQuestCoords = BearCoords
        if IsMotherBearAlive() then
            return "bearboss"
        else
            return "bearcub"
        end
    end

    CurrentRegion = "bandit"
    CurrentQuestCoords = BanditCoords
    return "bandit"
end

