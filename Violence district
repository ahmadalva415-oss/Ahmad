-- WindUI migration layer: keeps the existing feature callbacks intact while
-- presenting them through WindUI's modern layout and element API.
local function windOptions(options)
options = options or {}
return options
end

local function wrapWindElement(element, parent)
if not element then
return element
end

if element.SetValue == nil and element.Set ~= nil then
element.SetValue = element.Set
end

element._windParent = parent or element

function element:AddKeyPicker(_, options)
options = type(options) == "table" and options or {Default = options}
return self._windParent:Keybind({
Title = options.Text or options.Title or "Keybind",
Value = options.Default or "None",
Flag = options.Flag,
Callback = options.Callback
})
end

function element:AddColorPicker(color, options)
options = options or {}
return self._windParent:Colorpicker({
Title = options.Title or "Color",
Default = color,
Flag = options.Flag,
Callback = options.Callback
})
end

return element
end

local function wrapWindSection(section)
local adapter = {}
adapter._target = section

function adapter:AddToggle(title, default, callback, options)
options = windOptions(options)
return wrapWindElement(self._target:Toggle({
Title = title,
Value = default,
Flag = options.Flag,
Locked = options.Locked,
Callback = callback
}), self._target)
end

function adapter:AddCheckbox(title, default, callback, options)
return self:AddToggle(title, default, callback, options)
end

function adapter:AddSlider(title, min, max, default, callback, options)
options = windOptions(options)
return wrapWindElement(self._target:Slider({
Title = title,
Value = {Min = min, Max = max, Default = default},
Step = options.Increment or 1,
Flag = options.Flag,
Callback = callback
}), self._target)
end

function adapter:AddDropdown(title, values, _, callback, options)
options = windOptions(options)
return wrapWindElement(self._target:Dropdown({
Title = title,
Values = values,
Value = values and values[1],
AllowNone = true,
Flag = options.Flag,
Callback = callback
}), self._target)
end

function adapter:AddButton(title, callback)
return self._target:Button({Title = title, Icon = "", Justify = "Center", Callback = callback})
end

function adapter:AddTextbox(title, placeholder, callback, options)
options = windOptions(options)
return wrapWindElement(self._target:Input({
Title = title,
Placeholder = placeholder,
Flag = options.Flag,
Callback = callback
}), self._target)
end

function adapter:AddKeybind(title, default, callback)
return wrapWindElement(self._target:Keybind({Title = title, Value = default, Callback = callback}), self._target)
end

function adapter:AddColorPicker(title, color, options)
options = options or {}
options.Title = title
return wrapWindElement(self._target:Colorpicker({Title = title, Default = color, Callback = options.Callback, Flag = options.Flag}))
end

function adapter:AddConfigManager()
-- Configuration is managed by WindUI's built-in ConfigManager.
return self
end

return adapter
end

local function wrapWindPage(page)
local adapter = {}
adapter._target = page

function adapter:CreateSection(title)
return wrapWindSection(self._target:Section({
Title = title,
Box = true,
BoxBorder = true,
Opened = true
}))
end

return adapter
end

local function wrapWindTab(tab)
local adapter = {}
adapter._target = tab
function adapter:CreatePage()
return wrapWindPage(self._target)
end
return adapter
end

