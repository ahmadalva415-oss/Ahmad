-- ===== ASH3 neon intro (paste at the very top, before everything else) =====
do
	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")
	local ContentProvider = game:GetService("ContentProvider")

	local TITLE = "ASH3"
	local LOGO_ID = "125282844393157" -- Roblox image ID of the logo ("" = use the drawn logo)
	local LOAD_TIME = 3.5
	local WHITE = Color3.new(1, 1, 1)
	local NEON = Color3.fromRGB(255, 255, 255)

	local rng = Random.new()

	local function new(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = parent
		return o
	end

	local function tween(o, t, props, style, dir)
		local tw = TweenService:Create(
			o,
			TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
			props
		)
		tw:Play()
		return tw
	end

	local function getGuiParent()
		if gethui then
			local ok, h = pcall(gethui)
			if ok and h then
				return h
			end
		end
		local ok, cg = pcall(function()
			return game:GetService("CoreGui")
		end)
		if ok and cg then
			return cg
		end
		return Players.LocalPlayer:WaitForChild("PlayerGui")
	end

	local parent = getGuiParent()
	local old = parent:FindFirstChild("ASH_Loader")
	if old then
		old:Destroy()
	end

	local gui = new("ScreenGui", {
		Name = "ASH_Loader",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent)

	local root = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, gui)

	for _ = 1, 35 do
		local s = rng:NextNumber(1, 3)
		local x, y = rng:NextNumber(), rng:NextNumber()
		local p = new("Frame", {
			Size = UDim2.fromOffset(s, s),
			Position = UDim2.fromScale(x, y),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = rng:NextNumber(0.3, 0.7),
			BorderSizePixel = 0,
		}, root)
		TweenService:Create(
			p,
			TweenInfo.new(rng:NextNumber(2, 5), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ BackgroundTransparency = 1, Position = UDim2.fromScale(x, y - 0.04) }
		):Play()
	end

	local cam = workspace.CurrentCamera
	local uiScale = math.clamp((cam and cam.ViewportSize.Y or 520) / 520, 0.7, 1.4)
	local content = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, root)
	new("UIScale", { Scale = uiScale }, content)

	-- logo space: the logo sits at x 240..1013, y 222..858 inside the 1254x1254 image
	local LW, LH = 773, 636
	local LOGO_W = 210
	local K = LOGO_W / LW
	local W, H = LOGO_W, LH * K
	local PAD = 16
	local WP, HP = W + PAD * 2, H + PAD * 2

	local function px(x, y)
		return (x - 240) * K + PAD, (y - 222) * K + PAD
	end

	local logo = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -55),
		Size = UDim2.fromOffset(W, H),
		BackgroundTransparency = 1,
	}, content)
	local logoScale = new("UIScale", { Scale = 0.6 }, logo)

	-- soft neon halo (sits in front of the logo as a faint glow)
	local HALO = 460
	local glow = new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(HALO, HALO),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		ZIndex = 3,
	}, logo)
	for i = 1, 22 do
		local f = i / 22
		local c = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(f, f),
			BackgroundColor3 = NEON,
			BackgroundTransparency = 0.985,
			BorderSizePixel = 0,
		}, glow)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, c)
	end

	-- top-to-bottom reveal container
	local reveal = new("Frame", {
		Position = UDim2.fromOffset(-PAD, -PAD),
		Size = UDim2.fromOffset(WP, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 2,
	}, logo)
	local stage = new("Frame", {
		Size = UDim2.fromOffset(WP, HP),
		BackgroundTransparency = 1,
	}, reveal)

	-- fallback: the logo drawn from neon rectangles (only used if the image fails to load)
	local prompt, cursorHolder

	local function neonRect(parentFrame, cx, cy, w, h, rot)
		local function mk(z, fillOn, thick, tr, col)
			local f = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(cx, cy),
				Size = UDim2.fromOffset(w, h),
				Rotation = rot,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = fillOn and 0 or 1,
				BorderSizePixel = 0,
				ZIndex = z,
			}, parentFrame)
			new("UIStroke", {
				Thickness = thick,
				Transparency = tr,
				Color = col,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, f)
		end
		mk(1, false, 10, 0.9, NEON)
		mk(2, false, 5, 0.72, NEON)
		mk(3, true, 1.5, 0, WHITE)
	end

	local function drawLogo()
		local midX = PAD + 388 * K
		local clipH = PAD + H
		local leftClip = new("Frame", {
			Size = UDim2.fromOffset(midX, clipH),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 1,
		}, stage)
		local rightClip = new("Frame", {
			Position = UDim2.fromOffset(midX, 0),
			Size = UDim2.fromOffset(WP - midX, clipH),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 1,
		}, stage)

		local legL, legW = 820 * K, 132.3 * K
		local lx, ly = px(481.3, 589.4)
		local rx, ry = px(774.7, 589.4)
		neonRect(leftClip, lx, ly, legL, legW, -58.6)
		neonRect(rightClip, rx - midX, ry, legL, legW, 58.6)

		prompt = new("CanvasGroup", {
			Size = UDim2.fromOffset(WP, HP),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			ZIndex = 2,
		}, stage)

		local _, midY = px(0, 691)
		local upClip = new("Frame", {
			Size = UDim2.fromOffset(WP, midY),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}, prompt)
		local downClip = new("Frame", {
			Position = UDim2.fromOffset(0, midY),
			Size = UDim2.fromOffset(WP, HP - midY),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}, prompt)

		local armL, armT = 126.5 * K, 38 * K
		local ax, ay = px(600.4, 667.4)
		local bx, by = px(600.4, 714.6)
		neonRect(upClip, ax, ay, armL, armT, 42)
		neonRect(downClip, bx, by - midY, armL, armT, -42)

		cursorHolder = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
		}, prompt)
		local cx, cy = px(700.5, 753.5)
		neonRect(cursorHolder, cx, cy, 119 * K, 37 * K, 0)
	end

	-- try the real logo image first
	local imageOk = false
	if LOGO_ID ~= "" then
		local img = new("ImageLabel", {
			Position = UDim2.fromOffset(PAD - 240 * K, PAD - 222 * K),
			Size = UDim2.fromOffset(1254 * K, 1254 * K),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. LOGO_ID,
			ScaleType = Enum.ScaleType.Stretch,
			ZIndex = 1,
		}, stage)
		local done = false
		task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync({ img })
			end)
			done = true
		end)
		local t0 = os.clock()
		while not done and os.clock() - t0 < 4 do
			task.wait()
		end
		imageOk = img.IsLoaded
		if not imageOk then
			img:Destroy()
		end
	end
	if not imageOk then
		drawLogo()
	end

	-- scan line
	local scan = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(W / 2, -PAD),
		Size = UDim2.fromOffset(W * 1.3, 2),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, logo)
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, scan)
	reveal:GetPropertyChangedSignal("Size"):Connect(function()
		scan.Position = UDim2.fromOffset(W / 2, -PAD + reveal.Size.Y.Offset)
	end)

	local bottom = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
	}, content)

	local title = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 62),
		Size = UDim2.fromOffset(300, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = "",
		TextSize = 28,
		TextColor3 = WHITE,
	}, bottom)
	new("UIStroke", { Thickness = 2, Transparency = 0.8, Color = NEON }, title)

	local info = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 100),
		Size = UDim2.fromOffset(240, 18),
		BackgroundTransparency = 1,
	}, bottom)

	local status = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = "",
		TextSize = 13,
		TextColor3 = Color3.fromRGB(150, 150, 150),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, info)

	local percent = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = "0%",
		TextSize = 13,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, info)

	local barBg = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 122),
		Size = UDim2.fromOffset(240, 4),
		BackgroundColor3 = Color3.fromRGB(35, 35, 35),
		BorderSizePixel = 0,
	}, bottom)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, barBg)

	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Visible = false,
	}, barBg)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	new("UIStroke", {
		Thickness = 3,
		Transparency = 0.75,
		Color = NEON,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, fill)

	fill:GetPropertyChangedSignal("Size"):Connect(function()
		percent.Text = math.floor(fill.Size.X.Scale * 100 + 0.5) .. "%"
	end)

	local alive, animateDots, statusText = true, true, ""
	task.spawn(function()
		local d = 0
		while alive do
			status.Text = "> " .. statusText .. (animateDots and string.rep(".", d) or "")
			d = (d + 1) % 4
			task.wait(0.3)
		end
	end)

	local steps = {
		{ 0.18, "initializing" },
		{ 0.42, "fetching modules" },
		{ 0.67, "loading assets" },
		{ 0.90, "almost ready" },
		{ 1.00, "finalizing" },
	}

	-- ===== the sequence (blocks until done, then the script below continues) =====
	tween(root, 0.4, { GroupTransparency = 0 })
	tween(logoScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
	task.wait(0.2)

	tween(reveal, 1, { Size = UDim2.fromOffset(WP, HP) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut).Completed:Wait()
	scan.Visible = false

	tween(glow, 0.6, { GroupTransparency = 0.45 })
	if prompt then
		tween(prompt, 0.3, { GroupTransparency = 0 })
	end
	local pulse = TweenService:Create(
		glow,
		TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ GroupTransparency = 0.75 }
	)
	task.delay(0.6, function()
		pulse:Play()
	end)
	task.wait(0.3)

	if cursorHolder then
		task.spawn(function()
			while alive do
				cursorHolder.Visible = true
				task.wait(0.45)
				cursorHolder.Visible = false
				task.wait(0.35)
			end
		end)
	end

	local breathe = TweenService:Create(
		logoScale,
		TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1.04 }
	)
	breathe:Play()

	tween(bottom, 0.4, { GroupTransparency = 0 })
	for i = 1, #TITLE do
		title.Text = TITLE:sub(1, i) .. "_"
		task.wait(0.1)
	end
	title.Text = TITLE

	fill.Visible = true
	local prev = 0
	for _, s in ipairs(steps) do
		statusText = s[2]
		local dt = LOAD_TIME * (s[1] - prev) * rng:NextNumber(0.8, 1.2)
		tween(fill, dt, { Size = UDim2.fromScale(s[1], 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut).Completed:Wait()
		prev = s[1]
	end

	statusText = "ready"
	animateDots = false
	task.wait(0.5)

	breathe:Cancel()
	pulse:Cancel()
	tween(logoScale, 0.6, { Scale = 1.25 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(root, 0.6, { GroupTransparency = 1 }).Completed:Wait()

	alive = false
	gui:Destroy()
end
-- ===== end intro =====

