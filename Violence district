DBD_isLookTouch = function(p171)
	return p171.X > workspace.CurrentCamera.ViewportSize.X * 0.22
end
DBD_initYaw = function()
	local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not HumanoidRootPart then
		return
	end

	local v1246 = HumanoidRootPart.CFrame.LookVector * Vector3.new(1, 0, 1)

	if v1246.Magnitude > 0.05 then
		_G.Ox.DBD.yaw = math.atan2(-v1246.X, -v1246.Z)
	end
end
DBD_Stop = function()
	local DBD = _G.Ox.DBD

	if DBD.conn then
		DBD.conn:Disconnect()
		DBD.conn = nil
	end

	if DBD.chg then
		DBD.chg:Disconnect()
		DBD.chg = nil
	end

	if DBD.beg then
		DBD.beg:Disconnect()
		DBD.beg = nil
	end

	if DBD.endc then
		DBD.endc:Disconnect()
		DBD.endc = nil
	end

	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

	if DBD.oldFOV then
		workspace.CurrentCamera.FieldOfView = DBD.oldFOV
	end

	DBD.lookInput = nil
	DBD.lastPos = nil
end
DBD_Start = function()
	DBD_Stop()

	local DBD = _G.Ox.DBD

	if not DBD.Enabled then
		return
	end

	DBD_initYaw()
	DBD.oldFOV = workspace.CurrentCamera.FieldOfView
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	workspace.CurrentCamera.FieldOfView = DBD.FOV

	local Humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		Humanoid.AutoRotate = true
	end

	DBD.chg = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if input ~= DBD.lookInput then
			return
		end

		local Position = input.Position

		if DBD.lastPos then
			DBD.yaw -= (Position.X - DBD.lastPos.X) * 0.011 * DBD.Sens
			DBD.pitch = math.clamp(DBD.pitch - (Position.Y - DBD.lastPos.Y) * 0.011 * DBD.Sens, DBD.PitchMin, DBD.PitchMax)
		end

		DBD.lastPos = Position
	end)
	DBD.beg = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and DBD_isLookTouch(input.Position) then
			DBD.lookInput = input
			DBD.lastPos = input.Position
		end
	end)
	DBD.endc = UserInputService.InputEnded:Connect(function(input)
		if input == DBD.lookInput then
			DBD.lookInput = nil
			DBD.lastPos = nil
		end
	end)
	DBD.conn = RunService.RenderStepped:Connect(function(dt)
		if not DBD.Enabled then
			return
		end

		local HumanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		if not HumanoidRootPart then
			return
		end

		local vector3 = Vector3.new(math.sin(DBD.yaw) * math.cos(DBD.pitch), math.sin(DBD.pitch), math.cos(DBD.yaw) * math.cos(DBD.pitch))
		local v1253 = HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)

		workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame:Lerp(CFrame.lookAt(v1253 - vector3 * DBD.Distance + Vector3.new(0, DBD.Height - 1.6, 0), v1253), 1 - math.pow(1 - (DBD.lookInput and DBD.LookSmooth or DBD.RunSmooth), dt * 60))
	end)
end
