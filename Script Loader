--// Stats helpers
local HIST = 24

local function push(t, v)
    t[#t + 1] = v
    if #t > HIST then
        table.remove(t, 1)
    end
end

local function summarize(t)
    local sum, lo, hi = 0, math.huge, 0
    for _, v in ipairs(t) do
        sum = sum + v
        if v < lo then
            lo = v
        end
        if v > hi then
            hi = v
        end
    end
    return sum / #t, lo, hi
end

