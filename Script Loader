-- segmented control with a sliding white indicator
local function makeSegment(parent, labels, size, position, onChoose)
    local n = #labels
    local holder = make("Frame", {
        Position = position,
        Size = size,
        BackgroundColor3 = ROW,
        BorderSizePixel = 0,
    }, parent)
    make("UICorner", { CornerRadius = UDim.new(1, 0) }, holder)
    make("UIStroke", { Color = WHITE, Transparency = 0.88, Thickness = 1 }, holder)

    local indicator = make("Frame", {
        Size = UDim2.new(1 / n, -4, 1, -4),
        Position = UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
    }, holder)
    make("UICorner", { CornerRadius = UDim.new(1, 0) }, indicator)

    local buttons = {}
    local function choose(i, silent)
        tween(indicator, 0.25, { Position = UDim2.new((i - 1) / n, 2, 0, 2) }, Enum.EasingStyle.Quint)
        for j, b in ipairs(buttons) do
            tween(b, 0.2, { TextColor3 = (j == i) and BLACK or GRAY })
        end
        if not silent and onChoose then
            onChoose(i)
        end
    end

    for i, text in ipairs(labels) do
        local b = make("TextButton", {
            Size = UDim2.new(1 / n, 0, 1, 0),
            Position = UDim2.new((i - 1) / n, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = GRAY,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            AutoButtonColor = false,
            ZIndex = 2,
        }, holder)
        b.MouseButton1Click:Connect(function()
            choose(i)
        end)
        buttons[i] = b
    end
    choose(1, true)
    return { frame = holder, choose = choose }
end

