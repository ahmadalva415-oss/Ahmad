--// NAZK HUB - Auto Game Loader

local placeId = tostring(game.PlaceId)
local scriptUrl

if placeId == "142823291" then
    -- MM2
    scriptUrl = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/fee"

elseif placeId == "286090429" then
    -- Arsenal
    scriptUrl = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/NAZK%20hub%20arsenal"

elseif placeId == "99664616626491"
    or placeId == "14979402479"
    or placeId == "6918802270" then
    -- Haze Seas
    scriptUrl = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/Chest%20tween"

elseif placeId == "109509029034984" then
    -- +1 Aura per Click
    scriptUrl = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/+1%20Aura%20per%20click"

else
    warn("❌ Unsupported game | PlaceId: " .. placeId)
    return
end

local success, result = pcall(function()
    loadstring(game:HttpGet(scriptUrl))()
end)

if success then
    print("✅ NAZK HUB loaded successfully!")
else
    warn("❌ Script failed to load: " .. tostring(result))
end
