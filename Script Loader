local function drawCells(cells, hist, peak)
    local offset = HIST - #hist
    for i = 1, HIST do
        local v = hist[i - offset]
        local h = 0.05
        if v then
            h = math.clamp(v / peak, 0.05, 1)
        end
        cells[i].Size = UDim2.new(1 / HIST, -1, h, 0)
    end
end

