--// NAZK HUB - Delta Loader

local placeId = tostring(game.PlaceId)

local scripts = {
    ["142823291"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/fee",
    ["286090429"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/NAZK%20hub%20arsenal",
    ["99664616626491"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/Chest%20tween",
    ["14979402479"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/Chest%20tween",
    ["6918802270"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/Chest%20tween",
    ["109509029034984"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/+1%20Aura%20per%20click",
    ["89625393697373"] = "https://raw.githubusercontent.com/ahmadalva415-oss/Ahmad/main/Arabian%20keyboard"
}

local url = scripts[placeId]

if not url then
    warn("❌ Unsupported PlaceId: " .. placeId)
    return
end

local ok, response = pcall(function()
    return game:HttpGet(url)
end)

if not ok then
    warn("❌ HttpGet failed: " .. tostring(response))
    return
end

if not response or response == "" then
    warn("❌ Script returned empty content")
    return
end

local execute, err = loadstring(response)

if not execute then
    warn("❌ loadstring failed: " .. tostring(err))
    return
end

local run, result = pcall(execute)

if not run then
    warn("❌ Script execution failed: " .. tostring(result))
else
    print("✅ NAZK HUB loaded successfully!")
end
