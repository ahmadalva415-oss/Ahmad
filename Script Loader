--// Find Script
local map = findMap(placeId)

if not map then
    warn("❌ Unsupported PlaceId: " .. placeId)
    showUnsupportedUI()
    return
end

--// Download Script
local ok, response = pcall(function()
    return game:HttpGet(map.Url)
end)

if not ok then
    warn("❌ HttpGet failed: " .. tostring(response))
    return
end

if not response or response == "" then
    warn("❌ Script returned empty content")
    return
end

--// Load Script
local execute, err = loadstring(response)

if not execute then
    warn("❌ loadstring failed: " .. tostring(err))
    return
end

--// Execute Script
local run, result = pcall(execute)

if not run then
    warn("❌ Script execution failed: " .. tostring(result))
else
    print("✅ ASH₃ HUB loaded successfully!")
end
