local WinsTab = CreateTab('Wins', 'W')
local _, winsContainer = CreateSection(WinsTab, 'Auto Wins (Instant Teleport)')

local WinsStatusFrame = Create('Frame', {Parent = winsContainer, BackgroundColor3 = CONFIG.Theme.Secondary, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 80)})
AddCorner(WinsStatusFrame, 10)
AddStroke(WinsStatusFrame, CONFIG.Theme.Accent, 1)
local WinsIcon = Create('TextLabel', {Parent = WinsStatusFrame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 8), Font = Enum.Font.GothamBlack, Text = '🏆', TextColor3 = CONFIG.Theme.Accent, TextSize = 28})
local WinsStatusText = Create('TextLabel', {Parent = WinsStatusFrame, BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 38), Font = Enum.Font.GothamBold, Text = 'Auto Wins: OFF', TextColor3 = CONFIG.Theme.Text, TextSize = 14})
local WinsStatusSub = Create('TextLabel', {Parent = WinsStatusFrame, BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 18), Position = UDim2.new(0, 10, 0, 58), Font = Enum.Font.Gotham, Text = 'Instant teleport to: -3485.54, 69.71, -20.49', TextColor3 = CONFIG.Theme.TextDark, TextSize = 11})

-- Show current position
local PosLabel = Create('TextLabel', {Parent = winsContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.Gotham, Text = 'Current Position: ...', TextColor3 = CONFIG.Theme.TextDark, TextSize = 11})

-- Update position every second
task.spawn(function()
    while task.wait(1) do
        local char = player.Character
        local hrp = char and char:FindFirstChild('HumanoidRootPart')
        if hrp then
            local pos = hrp.Position
            PosLabel.Text = string.format('Current Position: %.2f, %.2f, %.2f', pos.X, pos.Y, pos.Z)
        end
    end
end)

CreateSlider(winsContainer, 'Teleport Interval (sec)', 0.5, 10, 2.0, function(val)
    CONFIG.WinsInterval = val
end, ' sec')

-- Show target coordinates
Create('TextLabel', {Parent = winsContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.Gotham, Text = 'Target: -3485.54, 69.71, -20.49', TextColor3 = CONFIG.Theme.Accent, TextSize = 11})

local WinsToggleBtn = Create('TextButton', {Parent = winsContainer, BackgroundColor3 = Color3.fromRGB(200, 50, 50), Size = UDim2.new(1, 0, 0, 42), Font = Enum.Font.GothamBold, Text = 'START AUTO WINS', TextColor3 = CONFIG.Theme.Text, TextSize = 14, AutoButtonColor = false})
AddCorner(WinsToggleBtn, 8)

local winsLoop = nil
local function StartAutoWins()
    if CONFIG.AutoWinsEnabled then return end
    CONFIG.AutoWinsEnabled = true
    WinsToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    WinsToggleBtn.Text = 'STOP AUTO WINS'
    WinsStatusText.Text = 'Auto Wins: RUNNING'
    WinsStatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
    WinsStatusSub.Text = 'Instant teleport every ' .. CONFIG.WinsInterval .. ' sec'
    -- Teleport immediately
    TeleportToWins()
    winsLoop = task.spawn(function()
        while CONFIG.AutoWinsEnabled do
            task.wait(CONFIG.WinsInterval)
            if CONFIG.AutoWinsEnabled then
                TeleportToWins()
            end
        end
    end)
end

local function StopAutoWins()
    CONFIG.AutoWinsEnabled = false
    if winsLoop then task.cancel(winsLoop); winsLoop = nil end
    WinsToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    WinsToggleBtn.Text = 'START AUTO WINS'
    WinsStatusText.Text = 'Auto Wins: OFF'
    WinsStatusText.TextColor3 = CONFIG.Theme.Text
    WinsStatusSub.Text = 'Instant teleport to: -3485.54, 69.71, -20.49'
end

WinsToggleBtn.MouseButton1Click:Connect(function()
    if CONFIG.AutoWinsEnabled then StopAutoWins() else StartAutoWins() end
end)
CreateButton(winsContainer, 'Teleport Now (Instant)', function() TeleportToWins() end)

