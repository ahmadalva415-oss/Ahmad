                            local n = child.Name:match("Border_(%d+)")
                            if n then found[#found + 1] = tonumber(n) end
                        end
                        if #found > 0 then
                            table.sort(found)
                            if #found < 5 then found[#found + 1] = found[#found] + 25000 end
                            points = found
                        end
                    end
                    for _, v in ipairs(points) do
