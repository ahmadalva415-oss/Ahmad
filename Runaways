-- ========== RUNAWAYS: NoClip + Anti Void ==========
local rw_noclipConn
local rw_lastSafeCFrame
local rw_antiVoidBusy = false
local rw_noclipOn = false

local function rw_enableNoclip()
    if rw_noclipConn then rw_noclipConn:Disconnect() end
    rw_noclipConn = RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        if not character or rw_antiVoidBusy then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        local y = root.Position.Y
        if not rw_lastSafeCFrame or y >= rw_lastSafeCFrame.Position.Y - 5 then
            rw_lastSafeCFrame = root.CFrame
        elseif rw_lastSafeCFrame.Position.Y - y >= 100 then
            rw_antiVoidBusy = true
            root.AssemblyLinearVelocity = Vector3.zero
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { character }
            local found = false
            for _ = 1, 20 do
                root.CFrame = root.CFrame + Vector3.new(0, 150, 0)
                task.wait()
                local hit = workspace:Raycast(root.Position, Vector3.new(0, -2000, 0), params)
                if hit and hit.Instance and hit.Instance:IsA("BasePart") and hit.Instance.CanCollide then
                    root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0), root.Position + root.CFrame.LookVector)
                    found = true
                    break
                end
            end
            if not found then
                root.CFrame = root.CFrame + Vector3.new(0, 150, 0)
            end
            root.AssemblyLinearVelocity = Vector3.zero
            rw_lastSafeCFrame = root.CFrame
            rw_antiVoidBusy = false
        end
    end)
end

local function rw_disableNoclip()
    if rw_noclipConn then
        rw_noclipConn:Disconnect()
        rw_noclipConn = nil
    end
    rw_lastSafeCFrame = nil
    rw_antiVoidBusy = false
    if LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

-- ========== RUNAWAYS: God Mode ==========
local rw_flow = nil
pcall(function()
    rw_flow = require(ReplicatedStorage:WaitForChild("FlowClient", 5))
end)

local rw_blockedRemote = function() end
local rw_originalTakeDamage = rw_flow and rw_flow.PlayerDamage and rw_flow.PlayerDamage.TakeDamage
local rw_originalAbandon = rw_flow and rw_flow.Passout and rw_flow.Passout.Abandon
local rw_humanoidState = {}

local function rw_saveHumanoidState(hum)
    if rw_humanoidState[hum] then return end
    rw_humanoidState[hum] = {
        BreakJointsOnDeath = hum.BreakJointsOnDeath,
        RequiresNeck = hum.RequiresNeck,
        DeadEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Dead),
    }
end

local function rw_applyGodMode()
    if rw_originalTakeDamage and rw_flow and rw_flow.PlayerDamage then
        rw_flow.PlayerDamage.TakeDamage = rw_blockedRemote
    end
    if rw_originalAbandon and rw_flow and rw_flow.Passout then
        rw_flow.Passout.Abandon = rw_blockedRemote
    end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        rw_saveHumanoidState(hum)
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        hum.Health = hum.MaxHealth
    end
end

local function rw_restoreGodMode()
    if rw_flow and rw_flow.PlayerDamage and rw_flow.PlayerDamage.TakeDamage == rw_blockedRemote then
        rw_flow.PlayerDamage.TakeDamage = rw_originalTakeDamage
    end
    if rw_flow and rw_flow.Passout and rw_flow.Passout.Abandon == rw_blockedRemote then
        rw_flow.Passout.Abandon = rw_originalAbandon
    end
    for hum, state in pairs(rw_humanoidState) do
        if hum.Parent then
            hum.BreakJointsOnDeath = state.BreakJointsOnDeath
            hum.RequiresNeck = state.RequiresNeck
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, state.DeadEnabled)
        end
        rw_humanoidState[hum] = nil
    end
end

