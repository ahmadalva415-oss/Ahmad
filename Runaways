                    else
                        character:PivotTo(CFrame.new(savedCFrame.Position.X, 2200, points[#points] + 1500))
                    end
                    task.wait(2)
                    running = false
                    get5StarsRunning = false
                    if character.Parent then character:PivotTo(savedCFrame) end
                end
            })
        end)
