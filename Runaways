RunService.Heartbeat:Connect(function()
    if not rw_autoKillOn then return end
    local now = tick()
    for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
        local hum = npc:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 and now - (rw_lastHit[hum] or 0) >= 0.1 then
            rw_lastHit[hum] = now
            rw_fireDamage(hum, 9999)
        end
    end
    if now - rw_lastScan >= 3 then
        rw_lastScan = now
        pcall(function()
            for _, d in ipairs(workspace.NPCs:GetDescendants()) do
                if d.Name == "Humanoid" and d.Health > 0 then
                    rw_fireDamage(d, 1e999)
