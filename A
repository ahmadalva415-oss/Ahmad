const { Client, GatewayIntentBits, EmbedBuilder } = require('discord.js');
require('dotenv').config();

const GROQ_API_KEY = process.env.GROQ_API_KEY;
const GROQ_MODEL = 'llama-3.3-70b-versatile';

const client = new Client({
    intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildMessages,
        GatewayIntentBits.MessageContent
    ]
});

// Convert GitHub/Pastebin URL to raw
function toRawUrl(url) {
    if (url.includes('raw.githubusercontent.com')) return url;
    if (url.includes('github.com')) {
        return url.replace('github.com', 'raw.githubusercontent.com').replace('/blob/', '/');
    }
    if (url.includes('pastebin.com') && !url.includes('pastebin.com/raw/')) {
        return url.replace('pastebin.com/', 'pastebin.com/raw/');
    }
    return url;
}

// Ask Groq AI to analyze the Lua script
async function analyzeWithAI(code) {
    const prompt = `You are an expert Roblox Lua script analyzer. Analyze the following script and extract its UI structure.

Rules:
1. Find all Tabs (look for ":Tab", ":CreateTab", "Title =", "Name =" patterns).
2. For each tab, list all Buttons, Toggles, Sliders, Dropdowns, and Inputs inside it.
3. Use this EXACT format (tree with emojis):
📁 Tab Name
   🔘 Button Name
   🔀 Toggle Name [ON/OFF]
   🎚️ Slider Name
   📋 Dropdown Name
   📝 Input Name
4. For Toggles, show [ON] if Default=true or CurrentValue=true, else [OFF].
5. Do NOT include code, explanations, or markdown code blocks. Just the tree.
6. If no UI elements found, return: "No UI elements found."
7. Keep it concise. Maximum 40 lines.

SCRIPT:
\`\`\`lua
${code.substring(0, 25000)}
\`\`\``;

    const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
            'Authorization': `Bearer ${GROQ_API_KEY}`,
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            model: GROQ_MODEL,
            messages: [
                { role: 'system', content: 'You are a Lua script analyzer. Output only the tree format, no explanations.' },
                { role: 'user', content: prompt }
            ],
            temperature: 0.2,
            max_tokens: 2000
        })
    });

    if (!response.ok) {
        const errText = await response.text();
        throw new Error(`Groq API Error: ${response.status} - ${errText.substring(0, 200)}`);
    }

    const data = await response.json();
    return data.choices[0].message.content.trim();
}

client.on('messageCreate', async (message) => {
    if (message.author.bot) return;

    let code = '';
    let sourceName = 'Unknown';

    // 1. Attachment
    if (message.attachments.size > 0) {
        const attachment = message.attachments.first();
        try {
            const response = await fetch(attachment.url);
            code = await response.text();
            sourceName = `📎 ${attachment.name}`;
        } catch (err) {
            return message.reply('❌ Failed to download the attached file.');
        }
    }
    // 2. URL
    else if (message.content.includes('http')) {
        const urlMatch = message.content.match(/https?:\/\/[^\s]+/);
        const rawUrl = toRawUrl(urlMatch[0]);
        try {
            const response = await fetch(rawUrl);
            code = await response.text();
            sourceName = '🔗 Link';
        } catch (err) {
            return message.reply('❌ Failed to fetch the script from the provided URL.');
        }
    }
    // 3. Pasted Code
    else if (message.content.length > 50 && (message.content.includes('function') || message.content.includes('local'))) {
        code = message.content;
        sourceName = '📋 Pasted Code';
    }
    // 4. Help
    else {
        if (message.content.startsWith('!features')) {
            message.reply('Send a script file, URL, or paste code to analyze it with AI.');
        }
        return;
    }

    if (!GROQ_API_KEY) {
        return message.reply('⚠️ AI is not configured. Please add GROQ_API_KEY to environment variables.');
    }

    await message.channel.sendTyping();

    try {
        const analysis = await analyzeWithAI(code);

        if (analysis.toLowerCase().includes('no ui elements')) {
            return message.reply('⚠️ AI could not find any UI elements in this script.');
        }

        const header = `**Source:** ${sourceName}\n**AI Model:** Llama 3.3 70B (Groq)\n`;
        const fullText = header + '\n```\n' + analysis + '\n```';

        if (fullText.length > 4000) {
            const embed = new EmbedBuilder()
                .setTitle('🤖 AI Analysis (Part 1)')
                .setColor(0x00FF00)
                .setDescription(header + '\n```\n' + analysis.substring(0, 3500) + '\n```');
            await message.reply({ embeds: [embed] });

            let remaining = analysis.substring(3500);
            let part = 2;
            while (remaining.length > 0) {
                const chunk = remaining.substring(0, 3800);
                await message.channel.send(`**Part ${part}:**\n\`\`\`\n${chunk}\n\`\`\``);
                remaining = remaining.substring(3800);
                part++;
            }
        } else {
            const embed = new EmbedBuilder()
                .setTitle('🤖 AI Script Analysis')
                .setColor(0x00FF00)
                .setDescription(fullText);
            await message.reply({ embeds: [embed] });
        }

        const diffText = analysis.split('\n').map(line => {
            if (line.includes('📁')) return '+ ' + line;
            if (line.trim().length > 0) return '+ ' + line;
            return line;
        }).join('\n');
        await message.channel.send('```diff\n' + diffText.substring(0, 1900) + '\n```');

    } catch (err) {
        console.error(err);
        message.reply('❌ AI Error: ' + err.message.substring(0, 200));
    }
});

client.login(process.env.DISCORD_TOKEN);
