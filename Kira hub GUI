-- 2. Load the UI library (with retries and a readable error)
---------------------------------------------------------------------
local function fetchLibrary()
    local okGet, source = pcall(function()
        return game:HttpGet(CONFIG.LibraryUrl)
    end)
    if not okGet or type(source) ~= "string" or source == "" then
        return nil, "could not download the UI library: " .. tostring(source)
    end
    local chunk, compileError = loadstring(source)
    if not chunk then
        return nil, "could not read the UI library: " .. tostring(compileError)
    end
    local okRun, result = pcall(chunk)
    if not okRun or type(result) ~= "table" then
        return nil, "the UI library failed to start: " .. tostring(result)
    end
    return result
end

local lib, libError
for _ = 1, 3 do
    lib, libError = fetchLibrary()
    if lib then break end
    task.wait(1.5)
end
if not lib then
    warn("[Kira HUB] " .. tostring(libError))
    return
end

