local function getAccent()
    local ok, theme = pcall(function() return lib:GetTheme() end)
    if ok and type(theme) == "table" and typeof(theme.Accent) == "Color3" then
        return theme.Accent
    end
    return Color3.fromRGB(238, 65, 92)
end

local logoImages = {}
local function collectLogoImages()
    if unloaded or not window.Gui then return end
    local found = {}
    local ok = pcall(function()
        for _, object in ipairs(window.Gui:GetDescendants()) do
            if (object:IsA("ImageLabel") or object:IsA("ImageButton")) and object.Image == CONFIG.Icon then
                found[#found + 1] = object
            end
        end
    end)
    if ok then logoImages = found end
end

local function tintLogo()
    local color = State.tintLogo and getAccent() or Color3.new(1, 1, 1)
    for _, image in ipairs(logoImages) do
        if image.Parent then
            image.ImageColor3 = color
        end
    end
end

