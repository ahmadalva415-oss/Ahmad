-- 3. State and small helpers
---------------------------------------------------------------------
local unloaded = false
local loadingConfig = true -- blocks auto-save until the saved settings are restored
local warnedSave = false
local cleanupFns = {}

local State = {
    notifications = true,
    autoSave      = true,
    tintLogo      = true,
    featureA      = false,
    featureB      = false,
    mode          = "Standard",
    customText    = "",
}

local function notify(title, content, kind, duration)
    if unloaded then return end
    pcall(function()
        lib:Notify({
            Title    = title,
            Content  = content,
            Type     = kind,
            Duration = duration or 3,
        })
    end)
end

-- Small toast used as feedback for control changes (can be switched off in Settings).
local function feedback(title, content)
    if State.notifications and not loadingConfig then
        notify(title, content, nil, 2.5)
    end
end

local saveToken = 0
local function saveNow(silent)
    local ok, success, err = pcall(function()
        return window:SaveConfig(CONFIG.ConfigName)
    end)
    if ok and success then
        if not silent then notify("Settings saved", CONFIG.ConfigName, "Success", 2.5) end
        return true
    end
    local reason = ok and tostring(err) or tostring(success)
    if not silent then
        notify("Save failed", reason, "Error", 4)
    elseif not warnedSave then
        warnedSave = true
        warn("[Kira HUB] auto-save failed: " .. reason)
    end
    return false
end

local function scheduleSave()
    if unloaded or loadingConfig or not State.autoSave then return end
    saveToken = saveToken + 1
    local token = saveToken
    task.delay(1.2, function()
        if token ~= saveToken or unloaded or loadingConfig then return end
        -- Never overwrite a named config the user loaded from the Configs box.
        if window.ConfigName ~= CONFIG.ConfigName then return end
        saveNow(true)
    end)
end

-- Wraps a control callback: runs it safely, then schedules an auto-save.
local function onChange(fn)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            warn("[Kira HUB] callback error: " .. tostring(err))
        end
        scheduleSave()
    end
end

-- Controls registered here are restored by "Reset Controls".
local tracked = {}
local function track(control, default)
    tracked[#tracked + 1] = { control = control, default = default }
    return control
end

local function resetList(list)
    for _, entry in ipairs(list) do
        pcall(function() entry.control:Set(entry.default) end)
    end
end

-- Builds one section of the UI; a failure in one section does not stop the rest.
local function build(name, fn)
    local ok, err = pcall(fn)
    if not ok then
        warn("[Kira HUB] could not build '" .. name .. "': " .. tostring(err))
    end
end

