local THEME_ORDER = {
    "Midnight", "Ocean", "Rose", "Emerald", "Amber", "Mono", "Nebula", "Synthwave",
    "Sakura", "Velvet", "Crimson", "Sunset", "Gold", "Cyber", "Toxic", "Matcha",
    "Aurora", "Frost", "Abyss", "Halloween", "Haunted", "Christmas", "Valentine",
    "Lunar", "Tropical", "Dracula", "Coffee",
}
local ALIAS_ORDER = {
    "Royal Purple", "Black & Red", "Cyberpunk", "Neon", "Ice", "Galaxy", "White Minimal", "Dark Glass",
}
local THEME_ALIASES = {
    ["Royal Purple"] = "Nebula", ["Black & Red"] = "Crimson", ["Cyberpunk"] = "Cyber",
    ["Neon"] = "Synthwave", ["Ice"] = "Frost", ["Galaxy"] = "Nebula",
    ["White Minimal"] = "Mono", ["Dark Glass"] = "Midnight",
}

local themeList, themeListed = {}, {}
do
    local presets = type(lib.ThemePresets) == "table" and lib.ThemePresets or nil
    local function add(name)
        if not themeListed[name] then
            themeListed[name] = true
            themeList[#themeList + 1] = name
        end
    end
    for _, name in ipairs(THEME_ORDER) do
        if not presets or presets[name] then add(name) end
    end
    if presets then -- presets added by newer library versions
        local extra, known = {}, {}
        for _, name in ipairs(THEME_ORDER) do known[name] = true end
        for name in pairs(presets) do
            if not known[name] then extra[#extra + 1] = name end
        end
        table.sort(extra)
        for _, name in ipairs(extra) do add(name) end
    end
    for _, alias in ipairs(ALIAS_ORDER) do
        if not presets or presets[THEME_ALIASES[alias]] then add(alias) end
    end
end

local currentTheme = CONFIG.DefaultTheme
local themeDropdown

local function resolveTheme(name)
    return THEME_ALIASES[name] or name
end

local function refreshAccentDependents()
    tintLogo()
    refreshEffectColors()
end

local function applyTheme(name)
    if type(name) ~= "string" then return end
    currentTheme = name
    pcall(function() lib:SetTheme(resolveTheme(name)) end)
    refreshAccentDependents()
end

-- Runs whenever ANY code changes the theme (our dropdown, ThemeManager, config load).
local function onThemeChanged()
    pcall(refreshAccentDependents)
    local name = lib.ThemeName
    if themeDropdown and type(name) == "string" and themeListed[name]
        and resolveTheme(currentTheme) ~= name then
        currentTheme = name
        pcall(function() themeDropdown:Set(name, true) end)
    end
end

if type(lib._themeListeners) == "table" then
    table.insert(lib._themeListeners, onThemeChanged)
    cleanupFns[#cleanupFns + 1] = function()
        local index = table.find(lib._themeListeners, onThemeChanged)
        if index then table.remove(lib._themeListeners, index) end
    end
end

---------------------------------------------------------------------
-- 7. Cleanup / unload
---------------------------------------------------------------------
local unload -- forward declaration

local function cleanup()
    if unloaded then return end
    unloaded = true
    fx.mode = "Off"
    pcall(destroyEffectLayer)
    for _, fn in ipairs(cleanupFns) do pcall(fn) end
    -- only clear the global hook if it still belongs to this copy
    if env.Kira_HUB_UNLOAD == unload then
        env.Kira_HUB_UNLOAD = nil
    end
end

unload = function()
    cleanup()
    pcall(function() window:Destroy() end)
end
env.Kira_HUB_UNLOAD = unload

-- Clean up automatically if the window is destroyed from anywhere else.
if type(window._connections) == "table" then
    table.insert(window._connections, { Disconnect = cleanup })
end
task.spawn(function()
    while not unloaded do
        task.wait(1)
        if window._destroyed then cleanup() end
    end
end)

