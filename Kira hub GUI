-- 9. Start-up
---------------------------------------------------------------------
local function loadSavedSettings()
    local loaded = false

    local okAuto, autoload = pcall(function() return window:GetAutoload() end)
    if okAuto and autoload then
        local ok, result = pcall(function() return window:LoadAutoload() end)
        loaded = ok and result == true
    end

    if not loaded then
        local okExists, exists = pcall(function() return window:ConfigExists(CONFIG.ConfigName) end)
        if okExists and exists then
            local ok, result = pcall(function() return window:LoadConfig(CONFIG.ConfigName) end)
            loaded = ok and result == true
        end
    end
    return loaded
end

