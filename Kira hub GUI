local effectItems = {}
local effectGui, effectLayer, visibilityConnection
local effectGeneration = 0

local function effectColorFor(style)
    if fx.custom then return fx.color end
    return style.Color:Lerp(getAccent(), style.ThemeMix or 0.58)
end

local function refreshEffectColors()
    for _, item in ipairs(effectItems) do
        local visual = item.Visual
        if visual and visual.Parent then
            local color = effectColorFor(item.Style)
            visual[item.ColorProperty] = color
            if item.Stroke and item.Stroke.Parent then
                item.Stroke.Color = color
            end
        end
    end
end

local function menuIsVisible()
    return not window._destroyed and window.Open ~= false and window.Minimized ~= true
end

local function updateEffectVisibility()
    if effectLayer and effectLayer.Parent then
        local visible = (not fx.hiddenOnly) or (not menuIsVisible())
        if effectLayer.Visible ~= visible then
            effectLayer.Visible = visible
        end
    end
end

local function clearEffects()
    effectGeneration = effectGeneration + 1
    local list = effectItems
    effectItems = {}
    for _, item in ipairs(list) do
        item.dead = true
        if item.Tween then pcall(function() item.Tween:Cancel() end) end
        if item.Frame then pcall(function() item.Frame:Destroy() end) end
    end
end

local function destroyEffectLayer()
    clearEffects()
    if visibilityConnection then
        visibilityConnection:Disconnect()
        visibilityConnection = nil
    end
    if effectGui then
        pcall(function() effectGui:Destroy() end)
    end
    effectGui, effectLayer = nil, nil
end

local function getGuiParent()
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then return result end
    end
    if CoreGui then return CoreGui end
    local player = Players.LocalPlayer
    return player and player:FindFirstChildOfClass("PlayerGui")
end

local function createEffectLayer()
    if effectGui and effectGui.Parent and effectLayer and effectLayer.Parent then
        return true
    end
    destroyEffectLayer()

    local parent = getGuiParent()
    if not parent then return false end

    local gui = Instance.new("ScreenGui")
    gui.Name = "Kira_BackgroundEffects"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 0
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local okParent = pcall(function() gui.Parent = parent end)
    if not okParent then
        pcall(function() gui:Destroy() end)
        return false
    end

    local layer = Instance.new("Frame")
    layer.Name = "Particles"
    layer.Size = UDim2.fromScale(1, 1)
    layer.BackgroundTransparency = 1
    layer.BorderSizePixel = 0
    layer.ClipsDescendants = true
    layer.Active = false
    layer.ZIndex = 1
    layer.Parent = gui

    effectGui, effectLayer = gui, layer
    visibilityConnection = RunService.Heartbeat:Connect(updateEffectVisibility)
    return true
end

local function finishParticle(item)
    if item.dead then return end
    item.dead = true
    local index = table.find(effectItems, item)
    if index then table.remove(effectItems, index) end
    if item.Frame then pcall(function() item.Frame:Destroy() end) end
end

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius
    corner.Parent = parent
    return corner
end

-- Creates the visible part of one particle. Returns visual, colorProperty, stroke.
local function buildVisual(style, color)
    local shape = style.Shape
    local transparency = fx.transparency / 100

    if shape == "glyph" then
        local label = Instance.new("TextLabel")
        label.Name = "Glyph"
        label.BackgroundTransparency = 1
        label.BorderSizePixel = 0
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamBold
        label.Text = style.Glyph
        label.TextScaled = true
        label.TextWrapped = false
        label.TextColor3 = color
        label.TextTransparency = math.clamp(transparency, 0.02, 0.85)
        label.TextStrokeColor3 = color
        label.TextStrokeTransparency = 0.72
        label.Rotation = math.random(-25, 25)
        return label, "TextColor3", nil
    end

    local visual = Instance.new("Frame")
    visual.Name = "Shape"
    visual.Size = UDim2.fromScale(1, 1)
    visual.BorderSizePixel = 0
    visual.BackgroundColor3 = color
    visual.BackgroundTransparency = math.clamp(transparency + 0.12, 0.08, 0.92)
    local stroke

    if shape == "ring" or shape == "orb" or shape == "glow" or shape == "dot" or shape == "coin" then
        addCorner(visual, UDim.new(1, 0))
    elseif shape == "cloud" then
        addCorner(visual, UDim.new(1, 0))
        local gradient = Instance.new("UIGradient")
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.92),
            NumberSequenceKeypoint.new(0.5, 0.42),
            NumberSequenceKeypoint.new(1, 0.92),
        })
        gradient.Parent = visual
    elseif shape == "confetti" or shape == "glitch" then
        addCorner(visual, UDim.new(0, 2))
    elseif shape == "meteor" then
        local gradient = Instance.new("UIGradient")
        gradient.Rotation = 90
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.12),
            NumberSequenceKeypoint.new(1, 0.94),
        })
        gradient.Parent = visual
    end

    if shape == "ring" or shape == "orb" then
        visual.BackgroundTransparency = 1
        stroke = Instance.new("UIStroke")
        stroke.Color = color
        stroke.Thickness = (shape == "orb") and 2 or 1
        stroke.Transparency = 0.18
        stroke.Parent = visual
    elseif shape == "glow" then
        stroke = Instance.new("UIStroke")
        stroke.Color = color
        stroke.Thickness = 2
        stroke.Transparency = 0.55
        stroke.Parent = visual
    elseif shape == "coin" then
        local mark = Instance.new("TextLabel")
        mark.Name = "CoinMark"
        mark.BackgroundTransparency = 1
        mark.Size = UDim2.fromScale(1, 1)
        mark.Font = Enum.Font.GothamBold
        mark.Text = "\u{2022}"
        mark.TextScaled = true
        mark.TextColor3 = Color3.fromRGB(120, 75, 12)
        mark.Parent = visual
    end

    return visual, "BackgroundColor3", stroke
end

-- `progress` (0..1) lets the first particles start part-way along their path.
local function spawnEffect(mode, generation, progress)
    if unloaded or generation ~= effectGeneration or mode ~= fx.mode then return end
    if not effectLayer or not effectLayer.Parent then return end
    local style = EFFECT_STYLES[mode]
    if not style then return end
    progress = progress or 0

    local scale = math.clamp(fx.size / 100, 0.45, 2.2)
    local color = effectColorFor(style)
    local visual, colorProperty, stroke = buildVisual(style, color)

    local frame = Instance.new("Frame")
    frame.Name = mode .. "Particle"
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Active = false
    frame.ZIndex = 1
    frame.Size = UDim2.fromOffset(math.max(2, math.floor(style.W * scale)), math.max(2, math.floor(style.H * scale)))
    visual.Parent = frame
    frame.Parent = effectLayer

    local drift = math.floor(fx.drift)
    local x, y, targetX, targetY
    if style.Direction == "up" then
        x, y = math.random(), 1.08
        targetX = math.clamp(x + math.random(-drift, drift) / 100, 0.02, 0.98)
        targetY = -0.08
    elseif style.Direction == "right" then
        x = -0.15
        y = 0.08 + math.random() * 0.84
        targetX = 1.15
        targetY = math.clamp(y + math.random(-12, 12) / 100, 0.04, 0.96)
    else
        x, y = math.random(), -0.08
        targetX = math.clamp(x + math.random(-drift, drift) / 100, 0.02, 0.98)
        targetY = 1.08
    end

    local startX = x + (targetX - x) * progress
    local startY = y + (targetY - y) * progress
    frame.Position = UDim2.new(startX, 0, startY, 0)
    if style.Shape == "confetti" or style.Shape == "meteor" or style.Shape == "glitch" then
        frame.Rotation = math.random(-55, 55)
    end

    local duration = style.Life / math.clamp(fx.speed / 100, 0.25, 3) * (1 - progress)
    duration = math.max(duration, 0.2)

    local tween = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(targetX, 0, targetY, 0),
        Rotation = frame.Rotation + math.random(-220, 220),
    })
    local item = {
        Frame = frame, Visual = visual, Tween = tween, Style = style,
        ColorProperty = colorProperty, Stroke = stroke,
    }
    effectItems[#effectItems + 1] = item
    tween.Completed:Connect(function() finishParticle(item) end)
    tween:Play()
end

local function effectCap()
    return math.clamp(math.floor(fx.density * 0.36), 6, MAX_EFFECTS)
end

local function setEffect(mode)
    if mode ~= "Off" and not EFFECT_STYLES[mode] then mode = "Off" end
    fx.mode = mode
    clearEffects()
    if mode == "Off" then
        destroyEffectLayer()
        return
    end
    if not createEffectLayer() then
        fx.mode = "Off"
        warn("[Kira HUB] could not create the effects layer")
        return
    end

    local generation = effectGeneration
    updateEffectVisibility()

    local burst = math.min(math.floor(effectCap() * 0.6), 18)
    for i = 1, burst do
        spawnEffect(mode, generation, (i - 1) / burst)
    end

    task.spawn(function()
        while not unloaded and fx.mode == mode and generation == effectGeneration do
            if #effectItems < effectCap() then
                spawnEffect(mode, generation, 0)
            end
            task.wait(math.clamp(0.42 - fx.density * 0.0032, 0.08, 0.4))
        end
    end)
end

