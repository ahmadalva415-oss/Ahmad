local function loadCfg(silent)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(CFG_FILE))
	end)
	if ok and type(data) == "table" then
		if data.TopBar ~= nil then
			_G.ASH3_PillVisible = data.TopBar
			pcall(function() TopBarToggle:SetValue(data.TopBar) end)
			applyPill()
		end
		if not silent then lib:Notify({Title = "Config", Description = "Loaded", Duration = 3}) end
	elseif not silent then
		lib:Notify({Title = "Config", Description = "No saved config", Duration = 3})
	end
end

