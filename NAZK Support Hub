getgenv().NAZK_DoDash = function()
    if tick() - (getgenv().NAZK_dashLast or 0) < (getgenv().NAZK_DashCooldown or 0.25) then return end
    getgenv().NAZK_dashLast = tick()

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local dir = cam.CFrame.LookVector
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local power = getgenv().NAZK_DashPower or 45
    local up = getgenv().NAZK_DashVertical or 0

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = dir * power + Vector3.new(0, up, 0)
    bv.P = 20000
    bv.Parent = root
    Debris:AddItem(bv, 0.15)
end

local dashConn = UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not getgenv().NAZK_DashEnabled then return end
    if input.KeyCode == getgenv().NAZK_DashKey then
        getgenv().NAZK_DoDash()
    end
end)

