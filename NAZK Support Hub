-- ========== Boot ==========
task.spawn(function()
    local hubWindow, WindUI
    task.spawn(function()
        local ok, win, ui = pcall(BuildHub)
        if ok and win then
            hubWindow = win
            WindUI = ui
            WindowRef = win
            mainLoaded = true
        end
    end)

    for i = 1, 85 do
        BarFill.Size = UDim2.new(i / 100, 0, 1, 0)
        Percent.Text = i .. "%"
        if i < 30 then Status.Text = "Loading assets..."
        elseif i < 60 then Status.Text = "Loading WindUI..."
        else Status.Text = "Building UI..." end
        task.wait(0.02)
    end

    Status.Text = "Waiting for UI..."
    local waited = 0
    while not mainLoaded and waited < 12 do
        BarFill.Size = UDim2.new(0.85 + math.sin(tick() * 4) * 0.03, 0, 1, 0)
        task.wait(0.1)
        waited = waited + 0.1
    end

    for i = 85, 100 do
        BarFill.Size = UDim2.new(i / 100, 0, 1, 0)
        Percent.Text = i .. "%"
        Status.Text = "Opening..."
        task.wait(0.03)
    end
    task.wait(0.2)

    TweenService:Create(MainFrame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(BlurBg, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
    for _, v in ipairs(MainFrame:GetDescendants()) do
        if v:IsA("TextLabel") then
            TweenService:Create(v, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
        elseif v:IsA("ImageLabel") then
            TweenService:Create(v, TweenInfo.new(0.4), { ImageTransparency = 1 }):Play()
        elseif v:IsA("Frame") then
            TweenService:Create(v, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
        end
    end
    task.wait(0.45)
    pcall(function() LoadingGui:Destroy() end)
    if hubWindow then hubWindow:Open() end

    -- ========== Floating UI ==========
    local ToggleGui = Instance.new("ScreenGui")
    ToggleGui.Name = "NAZK_Floating"
    ToggleGui.ResetOnSpawn = false
    ToggleGui.Parent = GetParent()
    getgenv().NAZK_ToggleGui = ToggleGui

    local NButton = Instance.new("ImageButton")
    NButton.Name = "imageLabel"
    NButton.Size = UDim2.fromOffset(60, 60)
    NButton.Position = UDim2.new(0, 15, 0.5, -30)
    NButton.BackgroundTransparency = 1
    NButton.Image = LOGO_ID
    NButton.ZIndex = 100
    NButton.Parent = ToggleGui

    local function CreateRedBlackButton(name, text, pos)
        local Outer = Instance.new("Frame")
        Outer.Name = name .. "_Outer"
        Outer.Size = UDim2.fromOffset(79, 42)
        Outer.Position = pos
        Outer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Outer.BorderSizePixel = 0
        Outer.ZIndex = 99
        Outer.Parent = ToggleGui
        Instance.new("UICorner", Outer).CornerRadius = UDim.new(0, 14)
        local OuterStroke = Instance.new("UIStroke")
        OuterStroke.Color = Color3.fromRGB(255, 0, 0)
        OuterStroke.Thickness = 2.5
        OuterStroke.Parent = Outer

        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.fromOffset(75, 38)
        btn.Position = UDim2.new(0, 2, 0, 2)
        btn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 0, 0)
        btn.TextSize = 16
        btn.Font = Enum.Font.GothamBold
        btn.ZIndex = 100
        btn.Parent = Outer
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

        return Outer, btn
    end

    local DashOuter, DashBtn = CreateRedBlackButton("Dash", "Dash", UDim2.new(1, -90, 0.5, -20))
    getgenv().NAZK_DashButton = DashOuter

    local function MakeDraggable(Button, Callback)
        local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
        Button.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = i.Position
                startPos = Button.Position
            end
        end)
        Button.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                dragInput = i
            end
        end)
        Button.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if not moved then Callback() end
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if i == dragInput and dragging then
                local d = i.Position - dragStart
                if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then moved = true end
                Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    local function MakeDraggableOuter(Outer, Inner, Callback)
        local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
        Inner.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = i.Position
                startPos = Outer.Position
            end
        end)
        Inner.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                dragInput = i
            end
        end)
        Inner.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                if not moved then Callback() end
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if i == dragInput and dragging then
                local d = i.Position - dragStart
                if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then moved = true end
                Outer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    local isOpen = true
    MakeDraggable(NButton, function()
        isOpen = not isOpen
        if WindowRef then
            if isOpen then WindowRef:Open() else WindowRef:Close() end
        end
    end)

    MakeDraggableOuter(DashOuter, DashBtn, function()
        DashBtn.Text = "..."
        if getgenv().NAZK_DoDash then getgenv().NAZK_DoDash() end
        task.wait(0.25)
        DashBtn.Text = "Dash"
    end)

    _G.NAZK_HUB_CLEANUP = function()
        pcall(function() if ToggleGui then ToggleGui:Destroy() end end)
        pcall(function() if WindowRef then WindowRef:Destroy() end end)
        pcall(function() if dashConn then dashConn:Disconnect() end end)
        pcall(function() if LoadingGui then LoadingGui:Destroy() end end)
        getgenv().NAZK_DashButton = nil
        _G.NAZK_HUB_RUNNING = false
    end
end)