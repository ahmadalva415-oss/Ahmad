    local function NAZK_noop()
        return setmetatable({}, {__index=function(self) return function() return self end end})
    end
    local function NAZK_safe(fn, ...)
        local ok,a,b,c=pcall(fn,...)
        if ok then return a,b,c end
        warn("[NAZK SUPPORT] "..tostring(a))
    end
    local function NAZK_adapter(gameAlias)
        local UI={}
        UI.icon=setmetatable({}, {__index=function(_,k) return tostring(k) end})
        function UI.config(_,defaults) return defaults or {} end
        function UI.Window(opts)
            local w={pages={}}
            function w:Page(name,icon)
                local tab=Window:Tab({Title=gameAlias.." | "..tostring(name),Icon=tostring(icon or "layout-dashboard")})
                local page={}
                function page:Card(title,column)
                    local section=tab:Section({Title=tostring(title)})
                    local card={}
                    function card:Accent() return self end
                    function card:Toggle(label,value,cb,hint,tone)
                        return tab:Toggle({Title=tostring(label),Desc=tostring(hint or ""),Default=value==true,Callback=function(v) NAZK_safe(cb,v) end})
                    end
                    function card:Slider(label,min,max,value,cb,hint)
                        return tab:Slider({Title=tostring(label),Desc=tostring(hint or ""),Value={Min=min or 0,Max=max or 100,Default=value or min or 0},Callback=function(v) NAZK_safe(cb,v) end})
                    end
                    function card:Button(label,cb)
                        return tab:Button({Title=tostring(label),Callback=function() NAZK_safe(cb) end})
                    end
                    function card:Dropdown(label,values,value,cb,hint)
                        return tab:Dropdown({Title=tostring(label),Desc=tostring(hint or ""),Values=values or {},Default=value,Callback=function(v) NAZK_safe(cb,v) end})
                    end
                    function card:Stepper(label,get,change,hint)
                        return tab:Button({Title=tostring(label),Desc=tostring(hint or ""),Callback=function() NAZK_safe(change,1) end})
                    end
                    function card:Label(text)
                        local p=tab:Paragraph({Title=tostring(text),Desc=""}); local o={}
                        function o:set(v) NAZK_safe(function() p:SetDesc(tostring(v or "")) end) end
                        return o
                    end
                    function card:Readout(lines)
                        local p=tab:Paragraph({Title="Status",Desc=""}); local o={}
                        function o:set(v) NAZK_safe(function() p:SetDesc(type(v)=="table" and table.concat(v,"\n") or tostring(v or "")) end) end
                        return o
                    end
                    return setmetatable(card,{__index=function(self) return function() return self end end})
                end
                return page
            end
            function w:SetMaster(v,title,desc) end
            function w:OnMaster(cb) end
            function w:SetStatus(text) end
            function w:SetStat(i,v,label) end
            function w:SetNote(text) end
            function w:Refresh() end
            function w:Home() end
            function w:Settings() end
            function w:Destroy() end
            return w
        end
        return UI
    end
    local function NAZK_load(alias)
        local body=NAZK_SOURCE[alias]
        if not body then Notify("Code unavailable for "..tostring(alias),"alert-triangle"); return end
        local UI=NAZK_adapter(alias)
        _G.__SEL={ui=UI,game=game}
        local fn,err=loadstring(body,"@NAZK/"..alias)
        if not fn then Notify("Syntax error: "..tostring(err),"alert-triangle"); return end
        local ok,runErr=pcall(fn)
        if not ok then Notify("Load failed: "..tostring(runErr),"alert-triangle"); return end
        Notify("Loaded "..tostring(alias),"check")
    end
    _G.NAZK_SUPPORT={load=NAZK_load,registry=NAZK_REGISTRY}
    for _,entry in ipairs(NAZK_REGISTRY) do
        local status=entry.available and "Available" or "Code unavailable in source repo"
        SupportTab:Button({Title=entry.name,Desc=status,Icon=entry.available and "play" or "alert-triangle",Callback=function() NAZK_load(entry.file) end})
    end

    local function NAZK_matchPlace(placeId)
        placeId=tonumber(placeId)
        for _,entry in ipairs(NAZK_REGISTRY) do
            for _,supportedId in ipairs(entry.places or {}) do
                if tonumber(supportedId)==placeId then return entry end
            end
        end
    end
    _G.NAZK_SUPPORT.matchPlace=NAZK_matchPlace
    local currentMatch=NAZK_matchPlace(game.PlaceId)
    if currentMatch then
        if currentMatch.available then
            task.defer(function()
                Notify("Detected "..tostring(currentMatch.name).." (PlaceId "..tostring(game.PlaceId)..")","play")
                NAZK_load(currentMatch.file)
            end)
        else
            Notify("Detected "..tostring(currentMatch.name)..", but its source code is unavailable","alert-triangle")
        end
    else
        Notify("No supported map matched PlaceId "..tostring(game.PlaceId),"info")
    end


    WindUI:Notify({
        Title = "NAZK HUB RED",
        Content = "Loaded - Discord + Dash ready!",
        Duration = 3,
        Icon = LOGO_ID
    })

    return Window, WindUI
end

