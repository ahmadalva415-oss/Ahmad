local function UpdateESPVisibility(data)
    if data.NameLabel then data.NameLabel.Visible = Config.ShowName end
    if data.HP_Bg then data.HP_Bg.Visible = Config.ShowHealth end
    if data.ItemsLabel then data.ItemsLabel.Visible = Config.ShowItems end
    if data.DistLabel then data.DistLabel.Visible = Config.ShowDistance end
end

local function CreateESPForPlayer(targetPlayer)
    if targetPlayer == player or ESP_Data[targetPlayer] then return end
    local data = { Connections = {} }
    ESP_Data[targetPlayer] = data

    local function setupCharacter(char)
        if not char then return end
        -- تنظيف قديم
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end

        CreateESPForStyle(targetPlayer, char, data)
        UpdateESPVisibility(data)

        -- تحديث الصحة والمسافة والإيتام
        local conn = RunService.Heartbeat:Connect(function()
            if not data.Billboard or not data.Billboard.Parent then return end
            if not char or not char.Parent then return end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and data.HP_Fill then
                local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                data.HP_Fill.Size = UDim2.new(healthPercent, 0, 1, 0)
                if Config.ESPStyle == "v1" then
                    if healthPercent > 0.6 then
                        data.HP_Fill.BackgroundColor3 = Color3.fromRGB(0,255,100)
                    elseif healthPercent > 0.3 then
                        data.HP_Fill.BackgroundColor3 = Color3.fromRGB(255,200,0)
                    else
                        data.HP_Fill.BackgroundColor3 = Color3.fromRGB(255,50,50)
                    end
                end
            end

            if data.ItemsLabel then
                local items = {}
                local bp = targetPlayer:FindFirstChild("Backpack")
                if bp then
                    for _, tool in ipairs(bp:GetChildren()) do
                        if tool:IsA("Tool") then table.insert(items, tool.Name) end
                    end
                end
                if char then
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") then table.insert(items, "[H] " .. tool.Name) end
                    end
                end
                data.ItemsLabel.Text = (#items > 0) and table.concat(items, ", ") or "No Items"
            end

            if data.DistLabel then
                local myRoot = HRP()
                local theirRoot = char:FindFirstChild("HumanoidRootPart")
                if myRoot and theirRoot then
                    local dist = (myRoot.Position - theirRoot.Position).Magnitude
                    data.DistLabel.Text = math.floor(dist) .. " studs"
                end
            end
        end)
        table.insert(data.Connections, conn)

        -- تحديث الحجم عند تغيير Config.ESPSize
        local sizeConn = RunService.Heartbeat:Connect(function()
            if data.Billboard and data.BaseSize then
                local newSize = UDim2.new(0, data.BaseSize.X.Offset * Config.ESPSize, 0, data.BaseSize.Y.Offset * Config.ESPSize)
                data.Billboard.Size = newSize
            end
        end)
        table.insert(data.Connections, sizeConn)
    end

    if targetPlayer.Character then setupCharacter(targetPlayer.Character) end
    local charConn = targetPlayer.CharacterAdded:Connect(setupCharacter)
    table.insert(data.Connections, charConn)
end

local function RemoveESPForPlayer(targetPlayer)
    local data = ESP_Data[targetPlayer]
    if not data then return end
    for _, conn in ipairs(data.Connections) do pcall(conn.Disconnect, conn) end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    ESP_Data[targetPlayer] = nil
end

local function UpdateESPSystem()
    if Config.ESPEnabled then
        for _, p in ipairs(Players:GetPlayers()) do CreateESPForPlayer(p) end
        if ESP_PlayerAdded then pcall(ESP_PlayerAdded.Disconnect, ESP_PlayerAdded) end
        if ESP_PlayerRemoving then pcall(ESP_PlayerRemoving.Disconnect, ESP_PlayerRemoving) end
        ESP_PlayerAdded = Players.PlayerAdded:Connect(CreateESPForPlayer)
        ESP_PlayerRemoving = Players.PlayerRemoving:Connect(RemoveESPForPlayer)
    else
        for p, _ in pairs(ESP_Data) do RemoveESPForPlayer(p) end
        if ESP_PlayerAdded then pcall(ESP_PlayerAdded.Disconnect, ESP_PlayerAdded); ESP_PlayerAdded = nil end
        if ESP_PlayerRemoving then pcall(ESP_PlayerRemoving.Disconnect, ESP_PlayerRemoving); ESP_PlayerRemoving = nil end
    end
end

