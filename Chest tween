RunService.Heartbeat:Connect(function()
    local character = player.Character
    local root = character and character:FindFirstChild('HumanoidRootPart')
    local humanoid = character and character:FindFirstChild('Humanoid')
    if not root or not humanoid then return end
    if not HazeConfig.AutoFarm then
        hasArrived = false isTargetingEnemy = false currentTarget = nil
        humanoid.PlatformStand = false humanoid.AutoRotate = true
        TargetStatus.Text = 'Target: OFF'
        TargetStatus.TextColor3 = CONFIG.Theme.TextDark
        TargetDot.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
        return
    end
    local level = GetLevel()
    local targetPos = GetLevelLocation(level)
    if hasArrived and targetPos then
        local distToLoc = (root.Position - targetPos).Magnitude
        if distToLoc > 100 then
            hasArrived = false isTargetingEnemy = false currentTarget = nil
            humanoid.PlatformStand = false humanoid.AutoRotate = true
            return
        end
    end
    if not hasArrived then
        if targetPos then
            local dist = (root.Position - targetPos).Magnitude
            if dist <= HazeConfig.ArrivalDistance then hasArrived = true
            else
                TargetStatus.Text = 'En Route (' .. math.floor(dist) .. ')'
                TargetStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
                TargetDot.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                return
            end
        else return end
    end
    local targetHRP = nil
    if currentTarget and currentTarget.Parent then
        if not Players:GetPlayerFromCharacter(currentTarget.Parent) then
            local targetHumanoid = currentTarget.Parent:FindFirstChild('Humanoid')
            if targetHumanoid and targetHumanoid.Health > 0 then
                local dist = (root.Position - currentTarget.Position).Magnitude
                if dist <= HazeConfig.TargetRange * 2 then targetHRP = currentTarget end
            end
        end
    end
    if not targetHRP then targetHRP = GetNearestTarget() currentTarget = targetHRP end
    if targetHRP then
        isTargetingEnemy = true
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        local aboveHead = targetHRP.Position + Vector3.new(0, HazeConfig.TargetHeight, 0)
        root.CFrame = CFrame.new(aboveHead, targetHRP.Position) * CFrame.Angles(math.rad(90), 0, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        TargetStatus.Text = 'LOCKED (' .. math.floor((root.Position - targetHRP.Position).Magnitude) .. ')'
        TargetStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        TargetDot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    else
        isTargetingEnemy = false
        currentTarget = nil
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        TargetStatus.Text = 'SCANNING...'
        TargetStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
        TargetDot.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    end
end)

