MiscTab:AddToggle("WaterBarrier", {
    Title = "Water Barrier",
    Default = false,
    Callback = function(v)
        Config.WaterBarrier = v
        if not v then
            if _G.NAZKWaterBarrierConn then _G.NAZKWaterBarrierConn:Disconnect(); _G.NAZKWaterBarrierConn = nil end
            if _G.NAZKWaterBarrier then _G.NAZKWaterBarrier:Destroy(); _G.NAZKWaterBarrier = nil end
            return
        end
        if _G.NAZKWaterBarrier then return end
        local part = Instance.new("Part")
        part.Name = "NAZK_WaterBarrier"
        part.Size = Vector3.new(50, 1, 50)
        part.Transparency = 1
        part.CanCollide = true
        part.Anchored = true
        part.Parent = workspace
        _G.NAZKWaterBarrier = part

        _G.NAZKWaterBarrierConn = RunService.Heartbeat:Connect(function()
            local root = HRP()
            if root and part.Parent then
                part.CFrame = CFrame.new(root.Position.X, 0.5, root.Position.Z)
            end
        end)
    end
})

