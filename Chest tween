local function SetMenuVisible(visible)
    MenuVisible = visible

    -- Root هو العنصر الرئيسي في FluentPro؛ نستخدم Minimize كخطة بديلة
    local root = Window.Root or Window.Main or Window.Window
    if root and root:IsA("GuiObject") then
        root.Visible = visible
    elseif Window.Minimize then
        pcall(function() Window:Minimize() end)
    end

    ToggleButton.Text = "N"
end

-- سحب الزر بالماوس أو اللمس
local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil
local movedDuringDrag = false

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        movedDuringDrag = false
        dragStart = input.Position
        startPosition = ToggleButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            movedDuringDrag = true
        end
        ToggleButton.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    if not movedDuringDrag then
        SetMenuVisible(not MenuVisible)
    end
end)

