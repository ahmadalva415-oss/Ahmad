local function IsRealSeaBeast(obj)
    if not obj or not obj:IsA('Model') then return false end
    local name = obj.Name
    local isBeast = false
    for _, pattern in ipairs(SB_Config.BeastNames) do
        if name == pattern or name:find('Sea Beast') or name:find('SeaBeast') or name:find('Sea_Beast') then isBeast = true break end
    end
    if not isBeast then return false end
    if name:find('SpawnPoint') or name:find('Spawn') or name:find('Spawner') or name:find('Indicator') then return false end
    if obj.PrimaryPart then return true end
    for _, p in ipairs(obj:GetDescendants()) do if p:IsA('BasePart') then return true end end
    return false
end

local function SB_Scan()
    local beasts = {}
    local checked = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if IsRealSeaBeast(obj) and not checked[obj] then checked[obj] = true table.insert(beasts, obj) end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if IsRealSeaBeast(obj) and not checked[obj] then checked[obj] = true table.insert(beasts, obj) end
    end
    return beasts
end

local function SB_GetBodyPart(obj)
    if not obj or not obj.Parent then return nil end
    if obj.PrimaryPart then return obj.PrimaryPart end
    local biggest = nil local maxSize = 0
    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA('BasePart') then
            local size = p.Size.X * p.Size.Y * p.Size.Z
            if size > maxSize then maxSize = size biggest = p end
        end
    end
    return biggest
end

local function SB_GetBeastPos(obj)
    local part = SB_GetBodyPart(obj)
    if part then return part.Position end
    return nil
end

local function SB_Attack()
    local char = player.Character
    if not char then return end
    if SB_Config.AutoEquip then
        local tool = char:FindFirstChildOfClass('Tool')
        if not tool then
            local bp = player:FindFirstChild('Backpack')
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA('Tool') then t.Parent = char task.wait(0.05) break end
                end
            end
        end
    end
    local tool = char:FindFirstChildOfClass('Tool')
    if tool then pcall(function() tool:Activate() end) end
    pcall(function() if mouse1click then mouse1click() end end)
end

local function SB_StartChase(beastPart)
    if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end
    SB_ChaseConn = RunService.Heartbeat:Connect(function()
        if not SB_Running or not SB_Config.Enabled then if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end return end
        if not beastPart or not beastPart.Parent then SB_CurrentTarget = nil if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end return end
        local char = player.Character
        local hrp = char and char:FindFirstChild('HumanoidRootPart')
        if not hrp or not hrp.Parent then return end
        local beastPos = beastPart.Position
        local targetPos = beastPos + Vector3.new(0, 8, 0)
        if targetPos.Y < 10 then targetPos = Vector3.new(targetPos.X, 10, targetPos.Z) end
        hrp.CFrame = CFrame.new(targetPos, beastPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
    end)
end

local function SB_StartAttack()
    if SB_AttackConn then SB_AttackConn:Disconnect() SB_AttackConn = nil end
    SB_AttackConn = RunService.Heartbeat:Connect(function()
        if not SB_Running or not SB_Config.Enabled or not SB_CurrentTarget then return end
        if SB_Config.AutoAttack then SB_Attack() end
    end)
end

local function SB_Loop()
    while SB_Running and SB_Config.Enabled do
        if SB_CurrentTarget and SB_CurrentTarget.Parent then
            local beastPos = SB_GetBeastPos(SB_CurrentTarget)
            if beastPos then task.wait(0.5)
            else SB_CurrentTarget = nil if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end task.wait(0.5) end
        else
            if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end
            SB_CurrentTarget = nil
            local beasts = SB_Scan()
            if #beasts == 0 then task.wait(1)
            else
                local hrp = player.Character and player.Character:FindFirstChild('HumanoidRootPart')
                local closest = nil local minD = math.huge
                for _, b in ipairs(beasts) do
                    local part = SB_GetBodyPart(b)
                    if part and hrp then local d = (hrp.Position - part.Position).Magnitude if d < minD then minD = d closest = b end end
                end
                if closest then
                    local bodyPart = SB_GetBodyPart(closest)
                    if bodyPart then SB_CurrentTarget = closest SB_StartChase(bodyPart) SB_StartAttack() end
                end
                task.wait(0.5)
            end
        end
    end
end

function StartSeaBeastFarm()
    if SB_Running then return end
    SB_Running = true
    SB_CurrentTarget = nil
    SB_StartAttack()
    task.spawn(SB_Loop)
end

function StopSeaBeastFarm()
    SB_Running = false
    SB_Config.Enabled = false
    SB_CurrentTarget = nil
    if SB_ChaseConn then SB_ChaseConn:Disconnect() SB_ChaseConn = nil end
    if SB_AttackConn then SB_AttackConn:Disconnect() SB_AttackConn = nil end
end

local placeId = game.PlaceId
local jobId = game.JobId

local function getServers(cursor)
    local url = ('https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100'):format(placeId)
    if cursor then url = url .. '&cursor=' .. cursor end
    local success, result = pcall(function() return game:HttpGet(url) end)
    if success then return HttpService:JSONDecode(result) end
    warn('[NAZK] Failed to fetch servers: ' .. tostring(result))
    return nil
end

local function findLowPlayerServer()
    local allServers = {}
    local cursor = nil
    local pages = 0
    repeat
        local data = getServers(cursor)
        if not data then break end
        for _, server in ipairs(data.data) do
            if server.id ~= jobId and server.playing <= SH_Config.MaxPlayers then
                if not SH_Config.visitedServers[server.id] then table.insert(allServers, server) end
            end
        end
        cursor = data.nextPageCursor
        pages = pages + 1
        task.wait(0.1)
    until not cursor or pages >= 5 or #allServers >= 20
    table.sort(allServers, function(a, b) return a.playing < b.playing end)
    return allServers
end

local function serverHop()
    if SH_Config.isHopping then return end
    SH_Config.isHopping = true
    local tries = 0
    local servers = {}
    repeat
        servers = findLowPlayerServer()
        tries = tries + 1
        if #servers == 0 then task.wait(SH_Config.RetryDelay) end
    until #servers > 0 or tries >= SH_Config.RetryLimit
    if #servers > 0 then
        local target = servers[1]
        SH_Config.visitedServers[target.id] = true
        print('[NAZK] Hopping to server with ' .. target.playing .. ' player(s)')
        TeleportService:TeleportToPlaceInstance(placeId, target.id, player)
    else
        warn('[NAZK] No low-player servers found after ' .. tries .. ' attempts.')
        SH_Config.isHopping = false
    end
end

local function serverHopRandom()
    if SH_Config.isHopping then return end
    SH_Config.isHopping = true
    local allServers = {}
    local cursor = nil
    local pages = 0
    repeat
        local data = getServers(cursor)
        if not data then break end
        for _, server in ipairs(data.data) do
            if server.id ~= jobId and not SH_Config.visitedServers[server.id] then table.insert(allServers, server) end
        end
        cursor = data.nextPageCursor
        pages = pages + 1
        task.wait(0.1)
    until not cursor or pages >= 5
    if #allServers > 0 then
        local target = allServers[math.random(1, #allServers)]
        SH_Config.visitedServers[target.id] = true
        print('[NAZK] Hopping to random server | Players: ' .. target.playing)
