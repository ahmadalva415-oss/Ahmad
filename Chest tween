-- نظام زراعة الصناديق (Chest Farm)
-- ============================================================
local chestFarmRunning = false
local chestConnection = nil
local visitedChests = {}
local farmedCount = 0

local function GetChests()
    local chests = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == "Chest" then
            table.insert(chests, obj)
        end
    end
    return chests
end

local function GetChestPos(chest)
    if not chest then return nil end
    if chest:IsA("Model") then
        if chest.PrimaryPart then return chest.PrimaryPart.Position end
        for _, part in ipairs(chest:GetDescendants()) do
            if part:IsA("BasePart") then return part.Position end
        end
    elseif chest:IsA("BasePart") then
        return chest.Position
    end
    return nil
end

local function IsVisited(pos)
    for _, v in ipairs(visitedChests) do
        if (v - pos).Magnitude < 25 then return true end
    end
    return false
end

local function SmoothFlyTo(targetPos, callback)
    local root = HRP()
    if not root then if callback then callback() end return end
    if chestConnection then chestConnection:Disconnect(); chestConnection = nil end

    local startCF = root.CFrame
    local targetCF = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    local distance = (startCF.Position - targetCF.Position).Magnitude
    if distance < 5 then
        root.CFrame = targetCF
        root.AssemblyLinearVelocity = Vector3.zero
        if callback then callback() end
        return
    end
    local duration = math.max(distance / Config.FarmSpeed, 0.01)
    local startTime = tick()

    chestConnection = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent then
            chestConnection:Disconnect()
            chestConnection = nil
            if callback then callback() end
            return
        end
        local elapsed = tick() - startTime
        local alpha = elapsed / duration
        if alpha >= 1 then
            root.CFrame = targetCF
            root.AssemblyLinearVelocity = Vector3.zero
            chestConnection:Disconnect()
            chestConnection = nil
            if callback then callback() end
            return
        end
        alpha = alpha * alpha * (3 - 2 * alpha)
        root.CFrame = startCF:Lerp(targetCF, alpha)
        root.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function StartChestFarm()
    if chestFarmRunning then return end
    chestFarmRunning = true
    visitedChests = {}
    farmedCount = 0
    Notify("Chest Farm", "Started")

    local function NextChest()
        if not chestFarmRunning then return end
        local chests = GetChests()
        if #chests == 0 then
            task.wait(1)
            task.defer(NextChest)
            return
        end
        local root = HRP()
        if not root then task.wait(1); task.defer(NextChest); return end

        local best = nil
        local bestDist = math.huge
        for _, chest in ipairs(chests) do
            local pos = GetChestPos(chest)
            if pos and not IsVisited(pos) then
                local d = (root.Position - pos).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = chest
                end
            end
        end
        if not best then
            -- إعادة ضبط الزيارة إذا لم يتبق صناديق جديدة
            visitedChests = {}
            for _, chest in ipairs(chests) do
                local pos = GetChestPos(chest)
                if pos then
                    local d = (root.Position - pos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = chest
                    end
                end
            end
        end
        if not best then
            task.wait(1)
            task.defer(NextChest)
            return
        end

        local pos = GetChestPos(best)
        if pos then
            table.insert(visitedChests, pos)
            farmedCount = farmedCount + 1
            Config.FarmedCount = farmedCount
            SmoothFlyTo(pos, function()
                if chestFarmRunning then task.defer(NextChest) end
            end)
        else
            task.wait(1)
            task.defer(NextChest)
        end
    end

    NextChest()
end

local function StopChestFarm()
    chestFarmRunning = false
    if chestConnection then chestConnection:Disconnect(); chestConnection = nil end
    Config.ChestFarm = false
    Notify("Chest Farm", "Stopped")
end

