-- نظام وحش البحر (Sea Beast)
-- ============================================================
local seaBeastRunning = false
local seaChaseConn = nil
local seaAttackConn = nil
local seaCurrentTarget = nil
local seaBeastNames = {
    "Sea Beast1", "Sea Beast", "Sea_Beast", "SeaBeast",
    "SeaBeast1", "Sea_Beast1", "Sea_Beast2", "SeaBeast2", "SeaBeast3"
}

local function IsRealSeaBeast(obj)
    if not obj or not obj:IsA("Model") then return false end
    local name = obj.Name
    for _, pattern in ipairs(seaBeastNames) do
        if name == pattern or name:find("Sea Beast") or name:find("SeaBeast") or name:find("Sea_Beast") then
            if not name:find("SpawnPoint") and not name:find("Spawn") and not name:find("Spawner") and not name:find("Indicator") then
                return true
            end
        end
    end
    return false
end

local function ScanBeasts()
    local beasts = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if IsRealSeaBeast(obj) then table.insert(beasts, obj) end
    end
    return beasts
end

local function GetBeastBodyPart(obj)
    if obj.PrimaryPart then return obj.PrimaryPart end
    local biggest = nil
    local maxSize = 0
    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then
            local size = p.Size.X * p.Size.Y * p.Size.Z
            if size > maxSize then maxSize = size; biggest = p end
        end
    end
    return biggest
end

local function SeaAttack()
    local char = Character()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = player:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then t.Parent = char; task.wait(0.05); break end
            end
        end
    end
    tool = char:FindFirstChildOfClass("Tool")
    if tool then pcall(tool.Activate, tool) end
    pcall(function() if mouse1click then mouse1click() end end)
end

local function StartSeaChase(beastPart)
    if seaChaseConn then seaChaseConn:Disconnect(); seaChaseConn = nil end
    seaChaseConn = RunService.Heartbeat:Connect(function()
        if not seaBeastRunning or not Config.SeaBeastEnabled then
            seaChaseConn:Disconnect(); seaChaseConn = nil; return
        end
        if not beastPart or not beastPart.Parent then
            seaCurrentTarget = nil
            if seaChaseConn then seaChaseConn:Disconnect(); seaChaseConn = nil end
            return
        end
        local root = HRP()
        if not root then return end
        local targetPos = beastPart.Position + Vector3.new(0, 8, 0)
        if targetPos.Y < 10 then targetPos = Vector3.new(targetPos.X, 10, targetPos.Z) end
        root.CFrame = CFrame.new(targetPos, beastPart.Position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.RotVelocity = Vector3.zero
    end)
end

local function StartSeaAttackLoop()
    if seaAttackConn then seaAttackConn:Disconnect(); seaAttackConn = nil end
    seaAttackConn = RunService.Heartbeat:Connect(function()
        if not seaBeastRunning or not Config.SeaBeastEnabled or not seaCurrentTarget then return end
        if Config.AutoAttack then SeaAttack() end
    end)
end

local function SeaBeastLoop()
    while seaBeastRunning and Config.SeaBeastEnabled do
        if seaCurrentTarget and seaCurrentTarget.Parent then
            local part = GetBeastBodyPart(seaCurrentTarget)
            if part then
                if not seaChaseConn then StartSeaChase(part) end
                if not seaAttackConn then StartSeaAttackLoop() end
                task.wait(0.5)
            else
                seaCurrentTarget = nil
                if seaChaseConn then seaChaseConn:Disconnect(); seaChaseConn = nil end
                task.wait(0.5)
            end
        else
            if seaChaseConn then seaChaseConn:Disconnect(); seaChaseConn = nil end
            if seaAttackConn then seaAttackConn:Disconnect(); seaAttackConn = nil end
            local beasts = ScanBeasts()
            if #beasts == 0 then
                task.wait(1)
            else
                local root = HRP()
                local closest = nil
                local minDist = math.huge
                for _, b in ipairs(beasts) do
                    local part = GetBeastBodyPart(b)
                    if part and root then
                        local d = (root.Position - part.Position).Magnitude
                        if d < minDist then minDist = d; closest = b end
                    end
                end
                if closest then
                    local part = GetBeastBodyPart(closest)
                    if part then
                        seaCurrentTarget = closest
                        StartSeaChase(part)
                        StartSeaAttackLoop()
                    end
                end
                task.wait(0.5)
            end
        end
    end
end

local function StartSeaBeastFarm()
    if seaBeastRunning then return end
    seaBeastRunning = true
    Config.SeaBeastEnabled = true
    Notify("Sea Beast", "Started")
    task.spawn(SeaBeastLoop)
end

local function StopSeaBeastFarm()
    seaBeastRunning = false
    Config.SeaBeastEnabled = false
    seaCurrentTarget = nil
    if seaChaseConn then seaChaseConn:Disconnect(); seaChaseConn = nil end
    if seaAttackConn then seaAttackConn:Disconnect(); seaAttackConn = nil end
    Notify("Sea Beast", "Stopped")
end

