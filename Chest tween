local function Create(instanceType, properties)
    local instance = Instance.new(instanceType)
    for property, value in pairs(properties) do
        instance[property] = value
    end
    return instance
end

local function Tween(instance, properties, duration)
    local tween = TweenService:Create(instance, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

local function MakeDraggable(frame, handle)
    local dragging = false
    local dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function()
        dragging = false
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function AddCorner(instance, radius)
    local corner = Instance.new('UICorner')
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = instance
end

local function AddStroke(instance, color, thickness)
    local stroke = Instance.new('UIStroke')
    stroke.Color = color or CONFIG.Theme.Border
    stroke.Thickness = thickness or 1
    stroke.Parent = instance
end

local function AddGradient(instance, color1, color2)
    local gradient = Instance.new('UIGradient')
    gradient.Color = ColorSequence.new(color1 or CONFIG.Theme.Accent, color2 or CONFIG.Theme.Accent2)
    gradient.Parent = instance
end

local function GetLevel()
    local data = player:FindFirstChild('PlayerData')
    if not data then return 1 end
    local exp = data:FindFirstChild('Experience')
    if not exp then return 1 end
    local level = exp:FindFirstChild('Level')
    if not level then return 1 end
    return tonumber(level.Value) or 1
end

local function GetLevelLocation(level)
    for _, data in ipairs(LevelLocations) do
        if level >= data[1] and level < data[2] then return data[3] end
    end
    if level >= 2100 then return Vector3.new(5505.52,119.59,6178.21) end
    return nil
end

local function TweenTo(position)
    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild('HumanoidRootPart')
    if not root then return false end
    local distance = (root.Position - position).Magnitude
    local duration = distance / HazeConfig.TweenSpeed
    if duration < 0.05 then root.CFrame = CFrame.new(position) return true end
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame = CFrame.new(position)})
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function IsValidTarget(model)
    if model == player.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local name = model.Name:lower()
    if name:find('beli') or name:find('level') then return false end
    if model:FindFirstChild('Beli') or model:FindFirstChild('Level') then return false end
    local hrp = model:FindFirstChild('HumanoidRootPart')
    local humanoid = model:FindFirstChild('Humanoid')
    if not hrp or not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    return true, hrp
end

local function GetNearestTarget()
    local character = player.Character
    if not character then return nil end
    local root = character:FindFirstChild('HumanoidRootPart')
    if not root then return nil end
    local nearestHRP = nil
    local nearestDistance = HazeConfig.TargetRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA('Model') then
            local valid, hrp = IsValidTarget(obj)
            if valid and hrp then
                local dist = (root.Position - hrp.Position).Magnitude
                if dist <= nearestDistance then nearestDistance = dist nearestHRP = hrp end
            end
        end
    end
    return nearestHRP
end

local function FindQuestRemote()
    local places = {player, player:FindFirstChild('PlayerGui'), player:FindFirstChild('PlayerScripts'), ReplicatedStorage, workspace}
    for _, parent in ipairs(places) do
        if parent then
            local remote = parent:FindFirstChild('QuestFunction', true)
            if remote and remote:IsA('RemoteFunction') then return remote end
        end
    end
    return nil
end

local QuestRemote = FindQuestRemote()

local function GetBestQuest(level)
    local bestGiver, bestQuest
    for giverID, levels in pairs(QuestData) do
        for _, questLevel in ipairs(levels) do
            if questLevel <= level then
                if not bestQuest or questLevel > bestQuest then bestQuest = questLevel bestGiver = giverID end
            end
        end
    end
    return bestGiver, bestQuest
end

local function TakeBestQuest()
    if not QuestRemote then QuestRemote = FindQuestRemote() end
    if not QuestRemote then return end
    local level = GetLevel()
    local giverID, questLevel = GetBestQuest(level)
    if not giverID or not questLevel then return end
    local questGivers = workspace:FindFirstChild('Npc_Workspace')
    if not questGivers then return end
    questGivers = questGivers:FindFirstChild('QuestGivers')
    if not questGivers then return end
    local npc = questGivers:FindFirstChild(tostring(giverID))
    if not npc then return end
    local questName = 'Level ' .. tostring(questLevel)
    pcall(function() QuestRemote:InvokeServer(npc, questName) end)
end

