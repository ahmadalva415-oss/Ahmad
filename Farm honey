--==================================================
-- MAIN SMART LOOP
--==================================================

task.spawn(function()

    while true do

        if Enabled then

            local Root = GetRoot()

            if Root then

                if CurrentTarget then

                    if not CurrentTarget.Parent then
                        CurrentTarget = nil

                    else

                        local Distance =
                            (Root.Position -
                            CurrentTarget.Position).Magnitude

                        if Distance > SearchDistance then
                            CurrentTarget = nil
                        end
                    end
                end

                if not CurrentTarget then
                    CurrentTarget = FindNearestHoney()
                end

                if CurrentTarget then

                    TargetLabel.Text =
                        "Target: Honey"

                    local Distance =
                        (Root.Position -
                        CurrentTarget.Position).Magnitude

                    DistanceLabel.Text =
                        "Distance: "
                        .. math.floor(Distance)
                        .. " studs"

                    local Success =
                        WalkToHoney(CurrentTarget)

                    if not Success then
                        task.wait(RepathDelay)
                    else
                        task.wait(0.1)
                    end

                    if CurrentTarget
                        and not CurrentTarget.Parent then

                        CurrentTarget = nil
                    end

                else

                    TargetLabel.Text =
                        "Target: No Honey"

                    DistanceLabel.Text =
                        "Distance: --"

                    task.wait(0.5)
                end
            end

        else

            task.wait(0.2)
        end
    end
end)

