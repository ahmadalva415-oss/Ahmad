--==================================================
-- FIND HONEY PART
--==================================================

local function GetHoneyPart(Object)

    if not Object or not Object.Parent then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then
        return Object.PrimaryPart
            or Object:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

--==================================================
-- FIND NEAREST HONEY
--==================================================

local function FindNearestHoney()

    local Root = GetRoot()

    if not Root then
        return nil
    end

    local Nearest = nil
    local NearestDistance = SearchDistance

    for _, Object in ipairs(workspace:GetDescendants()) do

        if Object.Name == "Honey" then

            local Part = GetHoneyPart(Object)

            if Part then

                local Distance =
                    (Root.Position - Part.Position).Magnitude

                if Distance <= SearchDistance
                    and Distance < NearestDistance then

                    Nearest = Part
                    NearestDistance = Distance
                end
            end
        end
    end

    return Nearest
end

--==================================================
-- CREATE PATH
--==================================================

local function CreatePath(StartPosition, EndPosition)

    local Path = PathfindingService:CreatePath({
        AgentRadius = AgentRadius,
        AgentHeight = AgentHeight,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = WaypointSpacing
    })

    local Success = pcall(function()
        Path:ComputeAsync(
            StartPosition,
            EndPosition
        )
    end)

    if Success
        and Path.Status == Enum.PathStatus.Success then

        return Path
    end

    return nil
end

--==================================================
-- MOVE TO WAYPOINT
--==================================================

local function MoveToWaypoint(Humanoid, Position)

    Humanoid:MoveTo(Position)

    local StartTime = tick()

    while Enabled do

        local Root = GetRoot()

        if not Root then
            return false
        end

        local Distance =
            (Root.Position - Position).Magnitude

        if Distance <= 4 then
            return true
        end

        if tick() - StartTime >= MoveTimeout then
            return false
        end

        task.wait(0.05)
    end

    return false
end

--==================================================
-- WALK TO HONEY
--==================================================

local function WalkToHoney(Honey)

    if not Honey
        or not Honey.Parent then

        return false
    end

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if not Humanoid or not Root then
        return false
    end

    local Path = CreatePath(
        Root.Position,
        Honey.Position
    )

    if not Path then
        return false
    end

    local Waypoints = Path:GetWaypoints()

    if #Waypoints == 0 then
        return false
    end

    for Index, Waypoint in ipairs(Waypoints) do

        if not Enabled then
            return false
        end

        if not Honey.Parent then
            return false
        end

        local CurrentRoot = GetRoot()

        if not CurrentRoot then
            return false
        end

        local TargetDistance =
            (CurrentRoot.Position - Honey.Position).Magnitude

        if TargetDistance <= ReachDistance then
            return true
        end

        DistanceLabel.Text =
            "Distance: "
            .. math.floor(TargetDistance)
            .. " studs"

        if Waypoint.Action ==
            Enum.PathWaypointAction.Jump then

            Humanoid.Jump = true
        end

        local Reached =
            MoveToWaypoint(
                Humanoid,
                Waypoint.Position
            )

        if not Reached then
            return false
        end

        if Index % 3 == 0 then

            local NewRoot = GetRoot()

            if NewRoot then

                local NewDistance =
                    (NewRoot.Position - Honey.Position).Magnitude

                if NewDistance <= ReachDistance then
                    return true
                end
            end
        end
    end

    return false
end

