local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- الإعدادات
local SEARCH_RADIUS = 25          -- مدى البحث عن العسل
local RAY_LENGTH = 5              -- طول الشعاع لكشف الجدار
local MOVE_SPEED = 16             -- سرعة الحركة
local STUCK_TIME_LIMIT = 1.5      -- إذا ظل ثابت لأكثر من 1.5 ثانية يعتبر عالق

-- متغيرات التشغيل
local running = false
local target = nil
local lastPos = rootPart.Position
local stuckTimer = 0

-- ========== إنشاء الواجهة (GUI) ==========
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 90)
frame.Position = UDim2.new(0.5, -100, 0.5, -45)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.BackgroundTransparency = 0.2
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
