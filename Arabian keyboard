-- ==================== دوال مساعدة ====================
local function CreateCard(parent, size, pos)
    local card = Instance.new("Frame")
    card.Size = size
    card.Position = pos
    card.BackgroundColor3 = Theme.Card
    card.BorderSizePixel = 0
    card.Parent = parent
    local cor = Instance.new("UICorner", card)
    cor.CornerRadius = UDim.new(0, 10)
    local st = Instance.new("UIStroke", card)
    st.Color = Theme.Border
    st.Thickness = 0.8
    st.Transparency = 0.6
    card.MouseEnter:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Theme.CardHover}):Play()
    end)
    card.MouseLeave:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Card}):Play()
    end)
    return card
end

local function CreateLabel(parent, text, size, pos, color, fontSize, bold, align)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextSize = fontSize or 12
    l.TextColor3 = color or Theme.Text
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function MakeGlowButton(parent, text, size, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Theme.AccentDark
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextColor3 = Theme.Text
    btn.AutoButtonColor = false
    btn.Parent = parent
    local cor = Instance.new("UICorner", btn)
    cor.CornerRadius = UDim.new(0, 8)
    local st = Instance.new("UIStroke", btn)
    st.Color = Theme.AccentGlow
    st.Thickness = 1.2
    st.Transparency = 0.4
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play()
        TweenService:Create(st, TweenInfo.new(0.15), {Transparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.AccentDark}):Play()
        TweenService:Create(st, TweenInfo.new(0.15), {Transparency = 0.4}):Play()
    end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

