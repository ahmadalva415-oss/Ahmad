local TARGET_POS = Vector3.new(-7343.58, 1876.69, 1379.58)

local function bouncePlayer()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local orig = hrp.Position
    local up = orig + Vector3.new(0, 5, 0)
    local t1 = TweenService:Create(hrp, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = up})
    t1:Play()
    t1.Completed:Wait()
    local t2 = TweenService:Create(hrp, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = orig})
    t2:Play()
    t2.Completed:Wait()
end

local function teleportToTarget()
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(TARGET_POS)
            task.spawn(function()
                task.wait(0.1)
                bouncePlayer()
            end)
        end
    end
end

