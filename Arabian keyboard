local autoTeleportRunning = false
local autoTeleportThread = nil

local function startAutoTeleport()
    if autoTeleportThread then task.cancel(autoTeleportThread); autoTeleportThread = nil end
    autoTeleportRunning = true
    ToggleTeleportBtn.BackgroundColor3 = Theme.ToggleOn
    ToggleTeleportBtn.Text = "تشغيل"
    TeleportStatusLabel.Text = "الحالة يعمل + بونس"
    TeleportStatusLabel.TextColor3 = Theme.Success
    autoTeleportThread = task.spawn(function()
        while autoTeleportRunning and TeleportTab.Parent do
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(TARGET_POS)
                    bouncePlayer()
                end
            end
            task.wait(0.6)
        end
    end)
end

local function stopAutoTeleport()
    autoTeleportRunning = false
    if autoTeleportThread then task.cancel(autoTeleportThread); autoTeleportThread = nil end
    ToggleTeleportBtn.BackgroundColor3 = Theme.ToggleOff
    ToggleTeleportBtn.Text = "إيقاف"
    TeleportStatusLabel.Text = "الحالة متوقف"
    TeleportStatusLabel.TextColor3 = Theme.TextDim
end

ToggleTeleportBtn.MouseButton1Click:Connect(function()
    if autoTeleportRunning then stopAutoTeleport() else startAutoTeleport() end
end)

TeleportTab.AncestryChanged:Connect(function()
    if not TeleportTab.Parent and autoTeleportRunning then stopAutoTeleport() end
end)

