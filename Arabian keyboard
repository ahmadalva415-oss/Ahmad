local autoFarmEnabled = false
local autoFarmConnection = nil

local function toggleAutoFarm()
    autoFarmEnabled = not autoFarmEnabled
    if autoFarmEnabled then
        ToggleFarmBtn.BackgroundColor3 = Theme.ToggleOn
        ToggleFarmBtn.Text = "تشغيل"
        FarmStatusLabel.Text = "الحالة يعمل"
        FarmStatusLabel.TextColor3 = Theme.Success
        if autoFarmConnection then autoFarmConnection:Disconnect(); autoFarmConnection = nil end
        autoFarmConnection = RunService.RenderStepped:Connect(function()
            if not autoFarmEnabled or not PlayerTab.Parent then
                autoFarmEnabled = false
                ToggleFarmBtn.BackgroundColor3 = Theme.ToggleOff
                ToggleFarmBtn.Text = "إيقاف"
                FarmStatusLabel.Text = "الحالة متوقف"
                FarmStatusLabel.TextColor3 = Theme.TextDim
                if autoFarmConnection then autoFarmConnection:Disconnect(); autoFarmConnection = nil end
                return
            end
            -- إرسال الريموت بنفس الطريقة التي طلبتها
            pcall(function()
                local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                if remote then
                    local updateSpeed = remote:FindFirstChild("UpdateSpeed")
                    if updateSpeed then
                        -- نرسل القيمة كما في الكود الأصلي
                        updateSpeed:FireServer(REMOTE_VALUE)
                    end
                end
            end)
        end)
    else
        ToggleFarmBtn.BackgroundColor3 = Theme.ToggleOff
        ToggleFarmBtn.Text = "إيقاف"
        FarmStatusLabel.Text = "الحالة متوقف"
        FarmStatusLabel.TextColor3 = Theme.TextDim
        if autoFarmConnection then autoFarmConnection:Disconnect(); autoFarmConnection = nil end
    end
end

ToggleFarmBtn.MouseButton1Click:Connect(toggleAutoFarm)

PlayerTab.AncestryChanged:Connect(function()
    if not PlayerTab.Parent then
        autoFarmEnabled = false
        if autoFarmConnection then autoFarmConnection:Disconnect(); autoFarmConnection = nil end
    end
end)

