local function SwitchTab(name)
    for n, f in pairs(ContentFrames) do
        f.Visible = (n == name)
    end
    for n, d in pairs(TabButtons) do
        if n == name then
            d.Button.BackgroundColor3 = Theme.AccentDark
            d.Label.TextColor3 = Theme.Text
            d.Icon.ImageColor3 = Theme.Accent
            d.Button.UIStroke.Transparency = 0.3
        else
            d.Button.BackgroundColor3 = Color3.fromRGB(22, 14, 48)
            d.Label.TextColor3 = Theme.TextDim
            d.Icon.ImageColor3 = Color3.fromRGB(140, 100, 200)
            d.Button.UIStroke.Transparency = 0.8
        end
    end
end

for name, data in pairs(TabButtons) do
    data.Button.MouseButton1Click:Connect(function()
        SwitchTab(name)
    end)
end

