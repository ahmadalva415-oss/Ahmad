--========================================================--
local function GetPitScrap() return Workspace:FindFirstChild("PitScrap") end
local function GetTargetPart(Object)
    if not Object then return nil end
    if Object:IsA("BasePart") then return Object end
    if Object:IsA("Model") then
        return Object.PrimaryPart or Object:FindFirstChild("HumanoidRootPart") or Object:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end
local function GetTargets()
    local t = {}
    local Pit = GetPitScrap(); if not Pit then return t end
    for _, o in ipairs(Pit:GetDescendants()) do
        if o.Name == "Loose" or o.Name == "Part" then
            local part = GetTargetPart(o)
            if part and part.Parent and part:IsDescendantOf(Pit) then table.insert(t, part) end
        end
    end
    return t
end
local function GetNearestTarget()
    local Root = GetRoot(); local Pit = GetPitScrap()
    if not Root or not Pit then return nil end
    local Nearest, Shortest = nil, math.huge
    for _, T in ipairs(GetTargets()) do
        if T and T.Parent and T:IsDescendantOf(Pit) and not Visited[T] then
            local d = (Root.Position - T.Position).Magnitude
            if d < Shortest then Shortest = d; Nearest = T end
        end
    end
    return Nearest
end
local function ResetVisited() Visited = {} end
local function CancelTween()
    if CurrentTween then pcall(function() CurrentTween:Cancel() end); CurrentTween = nil end
end
local function CalculateSpeed(d) return d > 40 and FarSpeed or MaxSpeed end
local function TweenToTarget(Target)
    local Root = GetRoot(); local Pit = GetPitScrap()
    if not Root or not Target or not Pit then return false end
    if not Target:IsDescendantOf(Pit) then return false end
    if not Target.Parent then return false end
    while TweenEnabled and Target and Target.Parent and Target:IsDescendantOf(Pit) do
        Root = GetRoot()
        if not Root then task.wait(0.1) continue end
        local TargetPos = Target.Position + Vector3.new(0, 3, 0)
        local Distance = (Root.Position - TargetPos).Magnitude
        if Distance <= 2 then CancelTween() return true end
        local Seg = math.min(15, Distance)
        local Dir = (TargetPos - Root.Position).Unit
        local NextPos = Root.Position + Dir * Seg
        local Speed = CalculateSpeed(Distance)
        local Duration = math.max(Seg / Speed, 0.12)
        CancelTween()
        CurrentTween = TweenService:Create(
            Root,
            TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { CFrame = CFrame.new(NextPos) }
        )
        local Finished = false
        local Conn = CurrentTween.Completed:Connect(function() Finished = true end)
        CurrentTween:Play()
        while TweenEnabled and CurrentTween and not Finished do task.wait(0.02) end
        if Conn then Conn:Disconnect() end
        if not TweenEnabled then CancelTween() return false end
        CancelTween()
        task.wait(0.4)
    end
    CancelTween()
    return false
end
local function StartTween()
    if TweenRunning then return end
    TweenRunning = true
    task.spawn(function()
        while TweenEnabled do
            local Root = GetRoot()
            if not Root then task.wait(0.2) continue end
            local Target = GetNearestTarget()
            if not Target then
                ResetVisited()
                task.wait(0.1)
                Target = GetNearestTarget()
                if not Target then task.wait(0.3) continue end
            end
            CurrentTarget = Target
            local Success = TweenToTarget(Target)
            if not TweenEnabled then break end
            if Success and Target and Target.Parent then Visited[Target] = true end
            CurrentTarget = nil
            task.wait(0.05)
        end
        CancelTween()
        CurrentTarget = nil
        TweenRunning = false
    end)
end
local function StopTween()
    TweenEnabled = false
    CancelTween()
    CurrentTarget = nil
end

