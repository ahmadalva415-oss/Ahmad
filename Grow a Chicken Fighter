local function StopAntiAFK()
    AntiAFKEnabled = false
    if AntiAFKConnection then AntiAFKConnection:Disconnect() AntiAFKConnection = nil end
end

local function StartAntiFling()
    if AntiFlingConnection then AntiFlingConnection:Disconnect() end
    AntiFlingEnabled = true
    AntiFlingConnection = RunService.Heartbeat:Connect(function()
        if not AntiFlingEnabled then return end
        local Character = LocalPlayer.Character
        if not Character then return end
        local Root = Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        for _, obj in ipairs(Root:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyAngularVelocity") or obj:IsA("BodyGyro") or obj:IsA("BodyForce") or obj:IsA("BodyThrust") then
                obj:Destroy()
            end
        end
        if Root.AssemblyAngularVelocity.Magnitude > 50 or Root.AssemblyLinearVelocity.Magnitude > 100 then
            Root.AssemblyAngularVelocity = Vector3.zero
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.CFrame = Root.CFrame
        end
    end)
end

local function StopAntiFling()
    AntiFlingEnabled = false
    if AntiFlingConnection then AntiFlingConnection:Disconnect() AntiFlingConnection = nil end
end

local function StartNoClip()
    if NoClipConnection then NoClipConnection:Disconnect() end
    NoClipEnabled = true
    NoClipConnection = RunService.Stepped:Connect(function()
        if not NoClipEnabled then return end
        local Character = LocalPlayer.Character
        if not Character then return end
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
end

local function StopNoClip()
    NoClipEnabled = false
    if NoClipConnection then NoClipConnection:Disconnect() NoClipConnection = nil end
    local Character = LocalPlayer.Character
    if Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

local function StartAntiLag()
    AntiLagEnabled = true
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then obj.Enabled = false end
        if obj:IsA("BasePart") and obj.Material == Enum.Material.Water then obj.Transparency = 1 end
        if obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 1 end
        if obj:IsA("Sound") then obj.Volume = 0 end
    end
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.Brightness = 2
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            effect.Enabled = false
        end
    end
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end

local function StopAntiLag()
    AntiLagEnabled = false
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then obj.Enabled = true end
        if obj:IsA("BasePart") and obj.Material == Enum.Material.Water then obj.Transparency = 0 end
        if obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 0 end
        if obj:IsA("Sound") then obj.Volume = 0.5 end
    end
    Lighting.GlobalShadows = true
    Lighting.FogEnd = 10000
    Lighting.Brightness = 1
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            effect.Enabled = true
        end
    end
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level10
end

local function SetGravity(value)
    CurrentGravity = value
    Workspace.Gravity = value
end

