--========================================================--

local function DoFling(target)
    if not target then return end
    local targetChar = target.Character
    if not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bav.P = 999999
    bav.Parent = targetRoot
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(math.random(-500, 500), math.random(800, 1200), math.random(-500, 500))
    bv.P = 999999
    bv.Parent = targetRoot
    Debris:AddItem(bav, 2)
    Debris:AddItem(bv, 2)
end

local function StartFling()
    if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
    FlingEnabled = true
    FlingConnection = RunService.Heartbeat:Connect(function()
        if not FlingEnabled or not SelectedPlayer then return end
        DoFling(SelectedPlayer)
    end)
end

local function StopFling()
    FlingEnabled = false
    if FlingConnection then FlingConnection:Disconnect() FlingConnection = nil end
end

--========================================================--
-- EGG SYSTEM
--========================================================--

local function GetEggs()
    local Eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "NestEgg" or obj.Name == "Egg" or obj.Name == "nestEgg" or obj.Name == "egg" then
            local eggPart = GetTargetPart(obj)
            if eggPart and eggPart.Parent and not EggCooldown[eggPart] then
                table.insert(Eggs, eggPart)
            end
        end
        if obj:IsA("BasePart") and (obj.Name == "Egg" or obj.Name == "egg") then
            if not EggCooldown[obj] then
                table.insert(Eggs, obj)
            end
        end
    end
    local NestEggsFolder = Workspace:FindFirstChild("NestEggs")
    if NestEggsFolder then
        for _, nest in ipairs(NestEggsFolder:GetDescendants()) do
            if nest:IsA("BasePart") and (nest.Name == "Egg" or nest.Name == "egg" or nest.Name == "NestEgg") then
                if not EggCooldown[nest] then
                    table.insert(Eggs, nest)
                end
            end
        end
    end
    return Eggs
end

local function GetNearestEgg()
    local Root = GetRoot()
    if not Root then return nil end
    local Nearest = nil
    local ShortestDistance = math.huge
    for _, egg in ipairs(GetEggs()) do
        if egg and egg.Parent then
            local Distance = (Root.Position - egg.Position).Magnitude
            if Distance < ShortestDistance then
                ShortestDistance = Distance
                Nearest = egg
            end
        end
    end
    return Nearest
end

local function TweenToEgg(Egg)
    local Root = GetRoot()
    if not Root or not Egg then return false end
    if not Egg.Parent then return false end
    local TargetPosition = Egg.Position + Vector3.new(0, 2, 0)
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 3 then return true end
    local Duration = math.max(Distance / 45, 0.1)
    CancelEggTween()
    EggTween = TweenService:Create(Root, TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = CFrame.new(TargetPosition) })
    EggTween:Play()
    local Finished = false
    local Connection = EggTween.Completed:Connect(function() Finished = true end)
    while EggEnabled and EggTween and not Finished do
        task.wait(0.02)
    end
    if Connection then Connection:Disconnect() end
    if not EggEnabled then CancelEggTween() return false end
    EggTween = nil
    return true
end

local function CollectEgg()
    if EggRunning then return end
    EggRunning = true
    task.spawn(function()
        while EggEnabled do
            local Root = GetRoot()
            if not Root then
                task.wait(0.2)
                continue
            end
            local Egg = GetNearestEgg()
            if not Egg then
                task.wait(0.5)
                continue
            end
            CurrentEgg = Egg
            local WasPitScrapRunning = TweenRunning
            if WasPitScrapRunning then
                CancelTween()
            end
            local Success = TweenToEgg(Egg)
            if Success then
                -- Wait until egg is collected (disappears) or timeout
                local WaitTime = 0
                while Egg and Egg.Parent and WaitTime < 5 do
                    -- Keep touching the egg
                    pcall(function()
                        if Egg and Egg.Parent then
                            firetouchinterest(Root, Egg, 0)
                            task.wait(0.05)
                            firetouchinterest(Root, Egg, 1)
                        end
                    end)
                    task.wait(0.2)
                    WaitTime = WaitTime + 0.2
                end
                -- Add cooldown even if egg still exists
                EggCooldown[Egg] = true
                task.delay(8, function()
                    EggCooldown[Egg] = nil
                end)
                task.wait(0.5)
            end
            CurrentEgg = nil
            if WasPitScrapRunning and TweenEnabled and not TweenRunning then
                StartTween()
            end
            task.wait(0.3)
        end
        CancelEggTween()
        CurrentEgg = nil
        EggRunning = false
    end)
end

local function StopEgg()
    EggEnabled = false
    CancelEggTween()
    CurrentEgg = nil
end

--========================================================--
-- MAIN PITSCRAP LOOP
--========================================================--

local function StartTween()
    if TweenRunning then return end
    TweenRunning = true
    task.spawn(function()
        while TweenEnabled do
            if EggRunning and CurrentEgg then
                task.wait(0.2)
                continue
            end
            local Root = GetRoot()
            if not Root then
                task.wait(0.2)
                continue
            end
            local Target = GetNearestTarget()
            if not Target then
                ResetVisited()
                task.wait(0.1)
                Target = GetNearestTarget()
                if not Target then
                    task.wait(0.3)
                    continue
                end
            end
            CurrentTarget = Target
            local Success = TweenToTarget(Target)
            if not TweenEnabled then break end
            if Success and Target and Target.Parent then
                Visited[Target] = true
            end
            CurrentTarget = nil
            task.wait(0.05)
        end
        CancelTween()
        CurrentTarget = nil
        TweenRunning = false
    end)
end

local function StopTween()
    TweenEnabled = false
    CancelTween()
    CurrentTarget = nil
end

--========================================================--
-- SERVER HOP
--========================================================--

local function HopLowPlayersServer()
    local PlaceId = game.PlaceId
    pcall(function()
        local servers = {}
        local cursor = ""
        repeat
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            local response = game:HttpGet(url)
            local data = game:GetService("HttpService"):JSONDecode(response)
            for _, server in ipairs(data.data) do
                if server.playing <= 1 and server.id ~= game.JobId then
                    table.insert(servers, server)
                end
            end
            cursor = data.nextPageCursor or ""
        until cursor == "" or #servers > 0
        if #servers > 0 then
            table.sort(servers, function(a, b) return a.playing < b.playing end)
            TeleportService:TeleportToPlaceInstance(PlaceId, servers[1].id, LocalPlayer)
        else
            cursor = ""
            local allServers = {}
            repeat
                local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then url = url .. "&cursor=" .. cursor end
                local response = game:HttpGet(url)
                local data = game:GetService("HttpService"):JSONDecode(response)
                for _, server in ipairs(data.data) do
                    if server.id ~= game.JobId then
                        table.insert(allServers, server)
                    end
                end
                cursor = data.nextPageCursor or ""
            until cursor == ""
            if #allServers > 0 then
                table.sort(allServers, function(a, b) return a.playing < b.playing end)
                TeleportService:TeleportToPlaceInstance(PlaceId, allServers[1].id, LocalPlayer)
            end
        end
    end)
end

