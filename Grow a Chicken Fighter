local GravitySliding = false

local function UpdateGravitySlider(X)

    local StartX =
        GravitySliderBack.AbsolutePosition.X

    local Width =
        GravitySliderBack.AbsoluteSize.X

    local Percent =
        math.clamp(
            (X - StartX) / Width,
            0,
            1
        )

    local GravityValue =
        math.floor(400 * Percent)

    SetGravity(GravityValue)

    GravitySliderFill.Size =
        UDim2.new(
            Percent,
            0,
            1,
            0
        )

    GravitySliderButton.Position =
        UDim2.new(
            Percent,
            0,
            0.5,
            0
        )

    GravityLabel.Text =
        "Gravity: "
        .. tostring(GravityValue)
end

local function BeginGravitySlider(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        GravitySliding = true

        UpdateGravitySlider(
            Input.Position.X
        )
    end
end

GravitySliderButton.InputBegan:Connect(
    BeginGravitySlider
)

GravitySliderBack.InputBegan:Connect(
    BeginGravitySlider
)

UserInputService.InputEnded:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        GravitySliding = false
    end
end)

UserInputService.InputChanged:Connect(function(Input)

    if not GravitySliding then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.MouseMovement
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        UpdateGravitySlider(
            Input.Position.X
        )
    end
end)

