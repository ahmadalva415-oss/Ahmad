local function RefreshPlayerList()

    for _, Btn in ipairs(PlayerButtons) do
        Btn:Destroy()
    end

    PlayerButtons = {}

    for _, Player in ipairs(Players:GetPlayers()) do

        if Player ~= LocalPlayer then

            local PlayerBtn =
                Instance.new("TextButton")

            PlayerBtn.Size =
                UDim2.new(1, 0, 0, 30)

            PlayerBtn.BackgroundColor3 =
                Color3.fromRGB(43, 43, 51)

            PlayerBtn.BorderSizePixel = 0

            PlayerBtn.Text =
                Player.DisplayName
                .. " (@"
                .. Player.Name
                .. ")"

            PlayerBtn.TextColor3 =
                Color3.fromRGB(220, 220, 230)

            PlayerBtn.TextSize = 11
            PlayerBtn.Font =
                Enum.Font.GothamBold

            PlayerBtn.Parent =
                PlayerListFrame

            local Corner =
                Instance.new("UICorner")

            Corner.CornerRadius =
                UDim.new(0, 8)

            Corner.Parent = PlayerBtn

            PlayerBtn.MouseButton1Click:Connect(function()

                SelectedPlayer = Player

                for _, B in ipairs(PlayerButtons) do
                    B.BackgroundColor3 =
                        Color3.fromRGB(43, 43, 51)
                end

                PlayerBtn.BackgroundColor3 =
                    Color3.fromRGB(70, 100, 140)

                SelectedLabel.Text =
                    "Selected: "
                    .. Player.DisplayName
            end)

            table.insert(
                PlayerButtons,
                PlayerBtn
            )
        end
    end
end

