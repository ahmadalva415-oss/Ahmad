PlayersTab:AddToggle("TweenToPlayer", {
    Title = "Tween to Selected Player",
    Default = false,
    Callback = function(Value)
        PlayerTweenEnabled = Value
        if not SelectedPlayer then
            PlayerTweenEnabled = false
            Notify("Players", "Select a player first")
            return
        end
        if Value then
            task.spawn(function()
                while PlayerTweenEnabled and SelectedPlayer and SelectedPlayer.Parent do
                    local Success = TweenToPlayer(SelectedPlayer)
                    if not Success then task.wait(0.5) else task.wait(0.1) end
                end
                CancelPlayerTween()
            end)
        else
            CancelPlayerTween()
        end
    end
})
