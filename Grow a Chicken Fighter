--========================================================--
-- CHARACTER
--========================================================--

local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

--========================================================--
-- PITSCRAP
--========================================================--

local function GetPitScrap()
    return workspace:FindFirstChild("PitScrap")
end

local function GetTargetPart(Object)
    if not Object then return nil end
    if Object:IsA("BasePart") then return Object end
    if Object:IsA("Model") then
        return Object.PrimaryPart or Object:FindFirstChild("HumanoidRootPart") or Object:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function GetTargets()
    local Targets = {}
    local PitScrap = GetPitScrap()
    if not PitScrap then return Targets end
    for _, Object in ipairs(PitScrap:GetDescendants()) do
        if Object.Name == "Loose" or Object.Name == "Part" then
            local Target = GetTargetPart(Object)
            if Target and Target.Parent and Target:IsDescendantOf(PitScrap) then
                table.insert(Targets, Target)
            end
        end
    end
    return Targets
end

local function GetNearestTarget()
    local Root = GetRoot()
    local PitScrap = GetPitScrap()
    if not Root or not PitScrap then return nil end
    local Nearest = nil
    local ShortestDistance = math.huge
    for _, Target in ipairs(GetTargets()) do
        if Target and Target.Parent and Target:IsDescendantOf(PitScrap) and not Visited[Target] then
            local Distance = (Root.Position - Target.Position).Magnitude
            if Distance < ShortestDistance then
                ShortestDistance = Distance
                Nearest = Target
            end
        end
    end
    return Nearest
end

local function ResetVisited()
    Visited = {}
end

local function CancelTween()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
end

local function CancelPlayerTween()
    if PlayerCurrentTween then
        pcall(function() PlayerCurrentTween:Cancel() end)
        PlayerCurrentTween = nil
    end
end

local function CancelEggTween()
    if EggTween then
        pcall(function() EggTween:Cancel() end)
        EggTween = nil
    end
end

local function CalculateSpeed(Distance)
    if Distance > 40 then return FarSpeed end
    return MaxSpeed
end

--========================================================--
-- TWEEN TO TARGET
--========================================================--

local function TweenToTarget(Target)
    local Root = GetRoot()
    local PitScrap = GetPitScrap()
    if not Root or not Target or not PitScrap then return false end
    if not Target:IsDescendantOf(PitScrap) then return false end
    if not Target.Parent then return false end
    local TargetPosition = Target.Position + Vector3.new(0, 3, 0)
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 2 then return true end
    local Speed = CalculateSpeed(Distance)
    local Duration = math.max(Distance / Speed, 0.12)
    CancelTween()
    CurrentTween = TweenService:Create(Root, TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = CFrame.new(TargetPosition) })
    CurrentTween:Play()
    local Finished = false
    local Connection = CurrentTween.Completed:Connect(function() Finished = true end)
    while TweenEnabled and CurrentTween and not Finished do
        task.wait(0.02)
    end
    if Connection then Connection:Disconnect() end
    if not TweenEnabled then CancelTween() return false end
    CurrentTween = nil
    return true
end

--========================================================--
-- TWEEN TO PLAYER
--========================================================--

local function TweenToPlayer(TargetPlayer)
    local Root = GetRoot()
    if not Root or not TargetPlayer then return false end
    local TargetCharacter = TargetPlayer.Character
    if not TargetCharacter then return false end
    local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not TargetRoot then return false end
    local TargetPosition = TargetRoot.Position + Vector3.new(0, 3, 0)
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 3 then return true end
    local Duration = math.max(Distance / 35, 0.12)
    CancelPlayerTween()
    PlayerCurrentTween = TweenService:Create(Root, TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = CFrame.new(TargetPosition) })
    PlayerCurrentTween:Play()
    local Finished = false
    local Connection = PlayerCurrentTween.Completed:Connect(function() Finished = true end)
    while PlayerTweenEnabled and PlayerCurrentTween and not Finished do
        task.wait(0.02)
    end
    if Connection then Connection:Disconnect() end
    if not PlayerTweenEnabled then CancelPlayerTween() return false end
    PlayerCurrentTween = nil
    return true
end

--========================================================--
-- FOLLOW PLAYER
--========================================================--

local function StartFollow()
    if FollowConnection then FollowConnection:Disconnect() FollowConnection = nil end
    FollowEnabled = true
    FollowConnection = RunService.Heartbeat:Connect(function()
        if not FollowEnabled or not SelectedPlayer then return end
        local Root = GetRoot()
        local TargetCharacter = SelectedPlayer.Character
        if not Root or not TargetCharacter then return end
        local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")
        if not TargetRoot then return end
        local Distance = (Root.Position - TargetRoot.Position).Magnitude
        if Distance > 5 then
            Root.CFrame = CFrame.new(TargetRoot.Position + Vector3.new(0, 3, 0))
        end
    end)
end

local function StopFollow()
    FollowEnabled = false
    if FollowConnection then FollowConnection:Disconnect() FollowConnection = nil end
end

