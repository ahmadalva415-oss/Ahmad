--========================================================--
-- CHARACTER
--========================================================--

local function GetCharacter()
    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

--========================================================--
-- PITSCRAP
--========================================================--

local function GetPitScrap()
    return workspace:FindFirstChild("PitScrap")
end

--========================================================--
-- TARGET PART
--========================================================--

local function GetTargetPart(Object)
    if not Object then
        return nil
    end
    if Object:IsA("BasePart") then
        return Object
    end
    if Object:IsA("Model") then
        return Object.PrimaryPart
            or Object:FindFirstChild("HumanoidRootPart")
            or Object:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

--========================================================--
-- ONLY LOOSE + PART INSIDE PITSCRAP
--========================================================--

local function GetTargets()
    local Targets = {}
    local PitScrap = GetPitScrap()
    if not PitScrap then
        return Targets
    end
    for _, Object in ipairs(PitScrap:GetDescendants()) do
        if Object.Name == "Loose" or Object.Name == "Part" then
            local Target = GetTargetPart(Object)
            if Target and Target.Parent and Target:IsDescendantOf(PitScrap) then
                table.insert(Targets, Target)
            end
        end
    end
    return Targets
end

--========================================================--
-- NEAREST TARGET
--========================================================--

local function GetNearestTarget()
    local Root = GetRoot()
    local PitScrap = GetPitScrap()
    if not Root or not PitScrap then
        return nil
    end
    local Nearest = nil
    local ShortestDistance = math.huge
    for _, Target in ipairs(GetTargets()) do
        if Target and Target.Parent and Target:IsDescendantOf(PitScrap) and not Visited[Target] then
            local Distance = (Root.Position - Target.Position).Magnitude
            if Distance < ShortestDistance then
                ShortestDistance = Distance
                Nearest = Target
            end
        end
    end
    return Nearest
end

--========================================================--
-- RESET
--========================================================--

local function ResetVisited()
    Visited = {}
end

--========================================================--
-- CANCEL
--========================================================--

local function CancelTween()
    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)
        CurrentTween = nil
    end
end

local function CancelPlayerTween()
    if PlayerCurrentTween then
        pcall(function()
            PlayerCurrentTween:Cancel()
        end)
        PlayerCurrentTween = nil
    end
end

--========================================================--
-- SPEED
--========================================================--

local function CalculateSpeed(Distance)
    if Distance > 40 then
        return FarSpeed
    end
    return MaxSpeed
end

--========================================================--
-- TWEEN TO TARGET
--========================================================--

local function TweenToTarget(Target)
    local Root = GetRoot()
    local PitScrap = GetPitScrap()
    if not Root or not Target or not PitScrap then
        return false
    end
    if not Target:IsDescendantOf(PitScrap) then
        return false
    end
    if not Target.Parent then
        return false
    end
    local TargetPosition = Target.Position + Vector3.new(0, 3, 0)
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 2 then
        return true
    end
    local Speed = CalculateSpeed(Distance)
    local Duration = math.max(Distance / Speed, 0.12)
    CancelTween()
    CurrentTween = TweenService:Create(
        Root,
        TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { CFrame = CFrame.new(TargetPosition) }
    )
    CurrentTween:Play()
    local Finished = false
    local Connection = CurrentTween.Completed:Connect(function()
        Finished = true
    end)
    while TweenEnabled and CurrentTween and not Finished do
        task.wait(0.02)
    end
    if Connection then
        Connection:Disconnect()
    end
    if not TweenEnabled then
        CancelTween()
        return false
    end
    CurrentTween = nil
    return true
end

--========================================================--
-- TWEEN TO PLAYER
--========================================================--

local function TweenToPlayer(TargetPlayer)
    local Root = GetRoot()
    if not Root or not TargetPlayer then
        return false
    end
    local TargetCharacter = TargetPlayer.Character
    if not TargetCharacter then
        return false
    end
    local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not TargetRoot then
        return false
    end
    local TargetPosition = TargetRoot.Position + Vector3.new(0, 3, 0)
    local Distance = (Root.Position - TargetPosition).Magnitude
    if Distance <= 3 then
        return true
    end
    local Duration = math.max(Distance / 35, 0.12)
    CancelPlayerTween()
    PlayerCurrentTween = TweenService:Create(
        Root,
        TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { CFrame = CFrame.new(TargetPosition) }
    )
    PlayerCurrentTween:Play()
    local Finished = false
    local Connection = PlayerCurrentTween.Completed:Connect(function()
        Finished = true
    end)
    while PlayerTweenEnabled and PlayerCurrentTween and not Finished do
        task.wait(0.02)
    end
    if Connection then
        Connection:Disconnect()
    end
    if not PlayerTweenEnabled then
        CancelPlayerTween()
        return false
    end
    PlayerCurrentTween = nil
    return true
end

--========================================================--
-- FOLLOW PLAYER
--========================================================--

local function StartFollow()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end
    FollowEnabled = true
    FollowConnection = RunService.Heartbeat:Connect(function()
        if not FollowEnabled or not SelectedPlayer then
            return
        end
        local Root = GetRoot()
        local TargetCharacter = SelectedPlayer.Character
        if not Root or not TargetCharacter then
            return
        end
        local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")
        if not TargetRoot then
            return
        end
        local Distance = (Root.Position - TargetRoot.Position).Magnitude
        if Distance > 5 then
            Root.CFrame = CFrame.new(TargetRoot.Position + Vector3.new(0, 3, 0))
        end
    end)
end

local function StopFollow()
    FollowEnabled = false
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end
end

--========================================================--
-- FLING PLAYER
--========================================================--

local function DoFling(target)
    if not target then
        return
    end
    local targetChar = target.Character
    if not targetChar then
        return
    end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        return
    end

    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bav.P = 999999
    bav.Parent = targetRoot

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(
        math.random(-500, 500),
        math.random(800, 1200),
        math.random(-500, 500)
    )
    bv.P = 999999
    bv.Parent = targetRoot

    Debris:AddItem(bav, 2)
    Debris:AddItem(bv, 2)
end

local function StartFling()
    if FlingConnection then
        FlingConnection:Disconnect()
        FlingConnection = nil
    end
    FlingEnabled = true
    FlingConnection = RunService.Heartbeat:Connect(function()
        if not FlingEnabled or not SelectedPlayer then
            return
        end
        DoFling(SelectedPlayer)
    end)
end

local function StopFling()
    FlingEnabled = false
    if FlingConnection then
        FlingConnection:Disconnect()
        FlingConnection = nil
    end
end

--========================================================--
-- MAIN PITSCRAP LOOP
--========================================================--

local function StartTween()
    if TweenRunning then
        return
    end
    TweenRunning = true
    task.spawn(function()
        while TweenEnabled do
            local Root = GetRoot()
            if not Root then
                task.wait(0.2)
                continue
            end
            local Target = GetNearestTarget()
            if not Target then
                ResetVisited()
                task.wait(0.1)
                Target = GetNearestTarget()
                if not Target then
                    task.wait(0.3)
                    continue
                end
            end
            CurrentTarget = Target
            local Success = TweenToTarget(Target)
            if not TweenEnabled then
                break
            end
            if Success and Target and Target.Parent then
                Visited[Target] = true
            end
            CurrentTarget = nil
            task.wait(0.05)
        end
        CancelTween()
        CurrentTarget = nil
        TweenRunning = false
    end)
end

local function StopTween()
    TweenEnabled = false
    CancelTween()
    CurrentTarget = nil
end

--========================================================--
-- SERVER HOP
--========================================================--

local function HopLowPlayersServer()
    local PlaceId = game.PlaceId
    local success, result = pcall(function()
        local servers = {}
        local cursor = ""
        repeat
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            local response = game:HttpGet(url)
            local data = game:GetService("HttpService"):JSONDecode(response)
            for _, server in ipairs(data.data) do
                if server.playing <= 1 and server.id ~= game.JobId then
                    table.insert(servers, server)
                end
            end
            cursor = data.nextPageCursor or ""
        until cursor == "" or #servers > 0

        if #servers > 0 then
            table.sort(servers, function(a, b)
                return a.playing < b.playing
            end)
            TeleportService:TeleportToPlaceInstance(PlaceId, servers[1].id, LocalPlayer)
        else
            cursor = ""
            local allServers = {}
            repeat
                local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end
                local response = game:HttpGet(url)
                local data = game:GetService("HttpService"):JSONDecode(response)
                for _, server in ipairs(data.data) do
                    if server.id ~= game.JobId then
                        table.insert(allServers, server)
                    end
                end
                cursor = data.nextPageCursor or ""
            until cursor == ""

            if #allServers > 0 then
                table.sort(allServers, function(a, b)
                    return a.playing < b.playing
                end)
                TeleportService:TeleportToPlaceInstance(PlaceId, allServers[1].id, LocalPlayer)
            end
        end
    end)
end

