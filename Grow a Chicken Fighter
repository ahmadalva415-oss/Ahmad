local SettingsFile = "NAZK_HUB_Settings.json"
local function SaveSettings()
    if type(writefile) ~= "function" then return false end
    local Data = {
        FarSpeed = FarSpeed, MaxSpeed = MaxSpeed,
        DashPower = DashPower, DashVertical = DashVertical,
        DashCooldown = DashCooldown, Gravity = CurrentGravity,
        TowerDelay = TowerDelay,
        AutoExecuteEnabled = AutoExecuteEnabled,
        AutoExecuteScriptURL = AutoExecuteScriptURL,
    }
    return pcall(function() writefile(SettingsFile, HttpService:JSONEncode(Data)) end)
end
local function LoadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    if not isfile(SettingsFile) then return end
    pcall(function()
        local Data = HttpService:JSONDecode(readfile(SettingsFile))
        if type(Data) ~= "table" then return end
        if type(Data.FarSpeed) == "number" then FarSpeed = Data.FarSpeed end
        if type(Data.MaxSpeed) == "number" then MaxSpeed = Data.MaxSpeed end
        if type(Data.DashPower) == "number" then DashPower = Data.DashPower end
        if type(Data.DashVertical) == "number" then DashVertical = Data.DashVertical end
        if type(Data.DashCooldown) == "number" then DashCooldown = Data.DashCooldown end
        if type(Data.Gravity) == "number" then
            CurrentGravity = Data.Gravity; Workspace.Gravity = CurrentGravity
        end
        if type(Data.TowerDelay) == "number" then
            TowerDelay = math.clamp(Data.TowerDelay, 0.1, 30)
        end
        if type(Data.AutoExecuteEnabled) == "boolean" then AutoExecuteEnabled = Data.AutoExecuteEnabled end
        if type(Data.AutoExecuteScriptURL) == "string" then AutoExecuteScriptURL = Data.AutoExecuteScriptURL end
    end)
end
LoadSettings()

