local PlayerButtons = {}

local function RefreshPlayerList()
    for _, btn in ipairs(PlayerButtons) do btn:Destroy() end
    PlayerButtons = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local PlayerBtn = Instance.new("TextButton")
            PlayerBtn.Size = UDim2.new(1, 0, 0, 30)
            PlayerBtn.BackgroundColor3 = Color3.fromRGB(43, 43, 51)
            PlayerBtn.BorderSizePixel = 0
            PlayerBtn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            PlayerBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
            PlayerBtn.TextSize = 11
            PlayerBtn.Font = Enum.Font.GothamBold
            PlayerBtn.Parent = PlayerListFrame
            local PBtnCorner = Instance.new("UICorner")
            PBtnCorner.CornerRadius = UDim.new(0, 8)
            PBtnCorner.Parent = PlayerBtn
            PlayerBtn.MouseButton1Click:Connect(function()
                SelectedPlayer = player
                for _, b in ipairs(PlayerButtons) do b.BackgroundColor3 = Color3.fromRGB(43, 43, 51) end
                PlayerBtn.BackgroundColor3 = Color3.fromRGB(70, 100, 140)
                SelectedLabel.Text = "Selected: " .. player.DisplayName
            end)
            table.insert(PlayerButtons, PlayerBtn)
        end
    end
end

