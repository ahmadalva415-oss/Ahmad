--========================================================--
-- SETTINGS
--========================================================--

local TweenEnabled = false
local TweenRunning = false

local FarSpeed = 20
local MaxSpeed = 67

local CurrentTween = nil
local CurrentTarget = nil

local Visited = {}

--========================================================--
-- CHARACTER
--========================================================--

local function GetCharacter()
    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

--========================================================--
-- PITSCRAP
--========================================================--

local function GetPitScrap()
    return workspace:FindFirstChild("PitScrap")
end

--========================================================--
-- GET TARGET PART
--========================================================--

local function GetTargetPart(Object)

    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object
    end

    if Object:IsA("Model") then
        return Object.PrimaryPart
            or Object:FindFirstChild("HumanoidRootPart")
            or Object:FindFirstChildWhichIsA("BasePart")
    end

    return nil
end

--========================================================--
-- GET ONLY LOOSE + PART INSIDE PITSCRAP
--========================================================--

local function GetTargets()

    local Targets = {}
    local PitScrap = GetPitScrap()

    if not PitScrap then
        return Targets
    end

    for _, Object in ipairs(PitScrap:GetDescendants()) do

        if Object.Name == "Loose"
        or Object.Name == "Part" then

            local Target = GetTargetPart(Object)

            if Target
            and Target.Parent
            and Target:IsDescendantOf(PitScrap) then

                table.insert(Targets, Target)
            end
        end
    end

    return Targets
end

--========================================================--
-- NEAREST TARGET
--========================================================--

local function GetNearestTarget()

    local Root = GetRoot()

    if not Root then
        return nil
    end

    local PitScrap = GetPitScrap()

    if not PitScrap then
        return nil
    end

    local Nearest = nil
    local ShortestDistance = math.huge

    for _, Target in ipairs(GetTargets()) do

        if Target
        and Target.Parent
        and Target:IsDescendantOf(PitScrap)
        and not Visited[Target] then

            local Distance =
                (Root.Position - Target.Position).Magnitude

            if Distance < ShortestDistance then
                ShortestDistance = Distance
                Nearest = Target
            end
        end
    end

    return Nearest
end

--========================================================--
-- RESET
--========================================================--

local function ResetVisited()
    Visited = {}
end

--========================================================--
-- CANCEL TWEEN
--========================================================--

local function CancelTween()

    if CurrentTween then

        pcall(function()
            CurrentTween:Cancel()
        end)

        CurrentTween = nil
    end
end

--========================================================--
-- SPEED
--
-- > 40  = 20
-- <= 40 = 67
--========================================================--

local function CalculateSpeed(Distance)

    if Distance > 40 then
        return FarSpeed
    end

    return MaxSpeed
end

--========================================================--
-- TWEEN TARGET
--========================================================--

local function TweenToTarget(Target)

    local Root = GetRoot()
    local PitScrap = GetPitScrap()

    if not Root
    or not Target
    or not PitScrap then

        return false
    end

    if not Target:IsDescendantOf(PitScrap) then
        return false
    end

    if not Target.Parent then
        return false
    end

    local TargetPosition =
        Target.Position + Vector3.new(0, 3, 0)

    local Distance =
        (Root.Position - TargetPosition).Magnitude

    if Distance <= 2 then
        return true
    end

    local Speed =
        CalculateSpeed(Distance)

    local Duration =
        Distance / Speed

    Duration =
        math.max(Duration, 0.12)

    CancelTween()

    CurrentTween =
        TweenService:Create(

            Root,

            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame = CFrame.new(TargetPosition)
            }
        )

    CurrentTween:Play()

    local Finished = false

    local Connection =
        CurrentTween.Completed:Connect(function()
            Finished = true
        end)

    while TweenEnabled
    and CurrentTween
    and not Finished do

        task.wait(0.02)
    end

    if Connection then
        Connection:Disconnect()
    end

    if not TweenEnabled then
        CancelTween()
        return false
    end

    CurrentTween = nil

    return true
end

--========================================================--
-- MAIN LOOP
--========================================================--

local function StartTween()

    if TweenRunning then
        return
    end

    TweenRunning = true

    task.spawn(function()

        while TweenEnabled do

            local Root = GetRoot()

            if not Root then
                task.wait(0.2)
                continue
            end

            local Target =
                GetNearestTarget()

            if not Target then

                ResetVisited()

                task.wait(0.1)

                Target =
                    GetNearestTarget()

                if not Target then
                    task.wait(0.3)
                    continue
                end
            end

            CurrentTarget = Target

            local Success =
                TweenToTarget(Target)

            if not TweenEnabled then
                break
            end

            if Success
            and Target
            and Target.Parent then

                Visited[Target] = true
            end

            CurrentTarget = nil

            task.wait(0.05)
        end

        CancelTween()

        CurrentTarget = nil
        TweenRunning = false
    end)
end

--========================================================--
-- STOP
--========================================================--

local function StopTween()

    TweenEnabled = false

    CancelTween()

    CurrentTarget = nil
end

