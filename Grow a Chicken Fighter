local function DoFling(Target)

    if not Target then
        return
    end

    local TargetChar = Target.Character

    if not TargetChar then
        return
    end

    local TargetRoot =
        TargetChar:FindFirstChild("HumanoidRootPart")

    if not TargetRoot then
        return
    end

    local BAV = Instance.new("BodyAngularVelocity")

    BAV.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    BAV.AngularVelocity =
        Vector3.new(
            99999,
            99999,
            99999
        )

    BAV.P = 999999
    BAV.Parent = TargetRoot

    local BV = Instance.new("BodyVelocity")

    BV.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    BV.Velocity =
        Vector3.new(
            math.random(-500, 500),
            math.random(800, 1200),
            math.random(-500, 500)
        )

    BV.P = 999999
    BV.Parent = TargetRoot

    Debris:AddItem(BAV, 2)
    Debris:AddItem(BV, 2)
end

local function StartFling()

    if FlingConnection then
        FlingConnection:Disconnect()
        FlingConnection = nil
    end

    FlingEnabled = true

    FlingConnection =
        RunService.Heartbeat:Connect(function()

            if not FlingEnabled or not SelectedPlayer then
                return
            end

            DoFling(SelectedPlayer)
        end)
end

local function StopFling()

    FlingEnabled = false

    if FlingConnection then
        FlingConnection:Disconnect()
        FlingConnection = nil
    end
end

--========================================================--
-- MAIN PITSCRAP LOOP
--========================================================--

local function StartTween()

    if TweenRunning then
        return
    end

    TweenRunning = true

    task.spawn(function()

        while TweenEnabled do

            local Root = GetRoot()

            if not Root then
                task.wait(0.2)
                continue
            end

            local Target = GetNearestTarget()

            if not Target then

                ResetVisited()

                task.wait(0.1)

                Target = GetNearestTarget()

                if not Target then
                    task.wait(0.3)
                    continue
                end
            end

            CurrentTarget = Target

            local Success =
                TweenToTarget(Target)

            if not TweenEnabled then
                break
            end

            if Success
                and Target
                and Target.Parent then

                Visited[Target] = true
            end

            CurrentTarget = nil

            task.wait(0.05)
        end

        CancelTween()

        CurrentTarget = nil
        TweenRunning = false
    end)
end

local function StopTween()

    TweenEnabled = false
    CancelTween()
    CurrentTarget = nil
end

