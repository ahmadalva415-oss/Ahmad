end

getgenv().NAZK_StopRolling = function()
    getgenv().NAZK_RollRunning = false
    if getgenv().NAZK_RollThread then
        pcall(task.cancel, getgenv().NAZK_RollThread)
        getgenv().NAZK_RollThread = nil
    end
end

getgenv().NAZK_StartRolling = function(notifyFn)
    if getgenv().NAZK_RollRunning then return end
    getgenv().NAZK_RollRunning = true

    getgenv().NAZK_RollThread = task.spawn(function()
        while getgenv().NAZK_RollRunning do
            local remote = GetRollRemote()
            if not remote then
                getgenv().NAZK_StopRolling()
                if notifyFn then notifyFn("RollDice remote not found!", "alert-triangle") end
                break
            end
            pcall(function() remote:InvokeServer() end)
            task.wait(getgenv().NAZK_RollSpeed or 0.001)
        end
    end)
end

