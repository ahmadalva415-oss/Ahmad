    local ok, saved = pcall(function()
        Window.CurrentConfig = manager:Config(CONFIG_NAME)
        return Window.CurrentConfig:Save()
    end)
    Notify("Config", ok and saved and "Saved" or ("Save failed: " .. tostring(saved)), ok and saved and "Success" or "Error")
end

