end

local function StartNoClip()
    if NoClipConnection then NoClipConnection:Disconnect() end
    NoClipEnabled = true
    NoClipConnection = RunService.Stepped:Connect(function()
        if not NoClipEnabled then return end
        local Char = LocalPlayer.Character; if not Char then return end
        for _, Part in ipairs(Char:GetDescendants()) do
            if Part:IsA("BasePart") then Part.CanCollide = false end
        end
    end)
end
local function StopNoClip()
    NoClipEnabled = false
    if NoClipConnection then NoClipConnection:Disconnect(); NoClipConnection = nil end
    local Char = LocalPlayer.Character
    if Char then
        for _, Part in ipairs(Char:GetDescendants()) do
            if Part:IsA("BasePart") then Part.CanCollide = true end
        end
    end
end

local function StartAntiFling()
    if AntiFlingConnection then AntiFlingConnection:Disconnect() end
    AntiFlingEnabled = true
    AntiFlingConnection = RunService.Heartbeat:Connect(function()
        if not AntiFlingEnabled then return end
        local Char = LocalPlayer.Character; if not Char then return end
        local HRP = Char:FindFirstChild("HumanoidRootPart"); if not HRP then return end
        if HRP.Position.Y < -50 then
            HRP.CFrame = LastGoodCFrame and (LastGoodCFrame + Vector3.new(0,10,0)) or CFrame.new(0,50,0)
            return
        end
        if HRP.Position.Y > 0 then LastGoodCFrame = HRP.CFrame end
        if HRP.AssemblyLinearVelocity.Magnitude > 200 then
            HRP.AssemblyLinearVelocity = Vector3.new(0,0,0)
            HRP.AssemblyAngularVelocity = Vector3.new(0,0,0)
            if LastGoodCFrame then HRP.CFrame = LastGoodCFrame end
        end
    end)
end
local function StopAntiFling()
    AntiFlingEnabled = false
    if AntiFlingConnection then AntiFlingConnection:Disconnect(); AntiFlingConnection = nil end
end

local function StartAutoRejoin()
    if AutoRejoinConnection then AutoRejoinConnection:Disconnect() end
    AutoRejoinEnabled = true
    AutoRejoinConnection = LocalPlayer.OnTeleport:Connect(function(State)
        if not AutoRejoinEnabled then return end
        if State == Enum.TeleportState.Failed then
            task.wait(3)
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        end
    end)
end
local function StopAutoRejoin()
    AutoRejoinEnabled = false
    if AutoRejoinConnection then AutoRejoinConnection:Disconnect(); AutoRejoinConnection = nil end
end

local function HopToLowestServer(MaxPlayers)
    MaxPlayers = tonumber(MaxPlayers) or 3
    local PlaceId = game.PlaceId
    local Servers = {}
    local Success = pcall(function()
        local Cursor = ""
        repeat
            local URL = "https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
            if Cursor ~= "" then URL = URL.."&cursor="..Cursor end
            local Response = game:HttpGet(URL)
            local Data = HttpService:JSONDecode(Response)
            for _, Server in ipairs(Data.data) do
                if Server.id ~= game.JobId and Server.playing < Server.maxPlayers and Server.playing <= MaxPlayers then
                    table.insert(Servers, Server)
                end
            end
            Cursor = Data.nextPageCursor or ""
        until Cursor == "" or #Servers >= 20
    end)
    if not Success or #Servers == 0 then Fluent:Notify({ Title="NAZK HUB", Content="ما فيه سيرفر مناسب", Duration=4 }); return end
    table.sort(Servers, function(A,B) return A.playing < B.playing end)
    TeleportService:TeleportToPlaceInstance(PlaceId, Servers[1].id, LocalPlayer)
end

