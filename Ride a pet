-- AUTO FARM
local function GetEggPosition(Egg)
    if not Egg then return nil end
    if Egg:IsA("BasePart") then return Egg.Position end
    if Egg:IsA("Model") then
        if Egg.PrimaryPart then return Egg.PrimaryPart.Position end
        local AnyPart = Egg:FindFirstChildWhichIsA("BasePart")
        if AnyPart then return AnyPart.Position end
    end
    for _, Desc in ipairs(Egg:GetDescendants()) do
        if Desc:IsA("BasePart") then return Desc.Position end
    end
    return nil
end

local function GetEggPriority(Name)
    if not Name then return 999 end
    return EggPriority[Name] or 999
end

local function ScanBestEgg()
    local MyPlot = FARM.OnlyMyPlot and GetMyPlot() or nil
    local Containers = {}
    if MyPlot then
        local PE = MyPlot:FindFirstChild("Eggs")
        if PE then table.insert(Containers, PE) end
        table.insert(Containers, MyPlot)
    else
        local RE = Workspace:FindFirstChild("RenderedEggs")
        if RE then table.insert(Containers, RE) end
        local GE = Workspace:FindFirstChild("Eggs")
        if GE then table.insert(Containers, GE) end
    end
    local Best = nil
    for _, Container in ipairs(Containers) do
        for _, Egg in ipairs(Container:GetChildren()) do
            local Priority = GetEggPriority(Egg.Name)
            if Priority <= FarmMinPriority then
                local Pos = GetEggPosition(Egg)
                if Pos then
                    local Valid = true
                    if MyPlot then Valid = IsEggInPlot(Egg, MyPlot) end
                    if Valid and (not Best or Priority < Best.Priority) then
                        Best = {Name=Egg.Name, Priority=Priority, Position=Pos, Instance=Egg,
                                PlotOwner=MyPlot and GetPlotOwnerName(MyPlot) or "Global"}
                    end
                end
            end
        end
    end
    return Best
end

