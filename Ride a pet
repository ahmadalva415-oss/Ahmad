local function TryPickupEgg(Egg)
    if not Egg then return false, "no egg" end
    for _, Desc in ipairs(Egg:GetDescendants()) do
        if Desc:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(Desc) end); return true, "ProximityPrompt"
        end
    end
    for _, Desc in ipairs(Egg:GetDescendants()) do
        if Desc:IsA("ClickDetector") then
            pcall(function() fireclickdetector(Desc) end); return true, "ClickDetector"
        end
    end
    for _, Desc in ipairs(Egg:GetDescendants()) do
        if (Desc:IsA("TextButton") or Desc:IsA("ImageButton")) and Desc.Visible then
            local Txt = (Desc.Text or ""):lower()
            if Txt:find("pick") or Txt:find("collect") or Txt:find("take") then
                pcall(function() Desc:Activate() end); return true, "Button"
            end
        end
    end
    local PG = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if PG then
        for _, Gui in ipairs(PG:GetDescendants()) do
            if (Gui:IsA("TextButton") or Gui:IsA("ImageButton")) and Gui.Visible then
                local Txt = (Gui.Text or ""):lower()
                if Txt:find("pick") or Txt:find("collect") or Txt:find("take") then
                    pcall(function() Gui:Activate() end); return true, "ScreenGui"
                end
            end
        end
    end
    for _, Gui in ipairs(Workspace:GetDescendants()) do
        if (Gui:IsA("TextButton") or Gui:IsA("ImageButton")) and Gui.Visible then
            local Txt = (Gui.Text or ""):lower()
            if Txt:find("pick") or Txt:find("collect") or Txt:find("take") then
                pcall(function() Gui:Activate() end); return true, "Workspace"
            end
        end
    end
    return false, "no prompt"
end

local function RunTourOnce()
    local Total = #RareEggCoords
    local OverallBest = nil
    for i = 1, Total do
        if not FarmEnabled then return nil end
        TeleportToPosition(RareEggCoords[i])
        task.wait(FARM.TeleportDelay)
        if not FarmEnabled then return nil end
        local Best = ScanBestEgg()
        if Best then
            if not OverallBest or Best.Priority < OverallBest.Priority then
                OverallBest = Best
                PlaySound("Egg", 0.3)
                Notify("New Best", Best.Name.." (P"..Best.Priority..")", 2)
            end
        end
        task.wait(FARM.WaitAtCoord)
    end
    return OverallBest
end

local function StartFarm()
    if FarmTask then pcall(function() task.cancel(FarmTask) end) end
    FarmEnabled = true
    FarmTask = task.spawn(function()
        repeat
            if not FarmEnabled then break end
            local Best = RunTourOnce()
            if not FarmEnabled then break end

            if Best and FarmEnabled then
                Notify("Best Egg", Best.Name.." (P"..Best.Priority..")", 4)
                task.wait(0.3)
                if not FarmEnabled then break end

                local Recheck = ScanBestEgg()
                local TargetPos = Best.Position
                if Recheck and Recheck.Name == Best.Name then
                    TargetPos = Recheck.Position
                    Best.Instance = Recheck.Instance
                end

                if not FarmEnabled then break end
                TeleportToPosition(TargetPos)
                PlaySound("Egg", 0.5)

                if FARM.AutoPickup then
                    task.wait(FARM.PickupDelay)
                    if not FarmEnabled then break end

                    local Picked, Method = TryPickupEgg(Best.Instance)
                    if Picked then
                        Notify("Picked Up", Best.Name, 2)
                        PlaySound("Egg", 0.6)
                    else
                        Notify("Failed", "ما قدرت أشيل "..Best.Name, 2)
                    end
                    task.wait(0.4)
                    if not FarmEnabled then break end

                    local ReturnPos = SavedHomePosition
                    if not ReturnPos then
                        local MyPlot = GetMyPlot()
                        if MyPlot then ReturnPos = GetPlotCenter(MyPlot) end
                    end

                    local ReachedPlot = false
                    if ReturnPos then
                        Notify("Returning", "رجوع للبيت...", 2)
                        SmoothMove(ReturnPos, TweenSpeed)
                        if not FarmEnabled then break end
                        task.wait(FARM.PostReturnWait)

                        local Root = GetRoot()
                        if Root then
                            local Dist = (Root.Position - ReturnPos).Magnitude
                            Notify("Position", "المسافة: "..math.floor(Dist), 2)
                            if Dist < 30 then ReachedPlot = true end
                        end
                    else
                        Notify("No Home", "احفظ موقع البيت أول!", 3)
                    end

                    if not FarmEnabled then break end

                    if FARM.AutoReset and ReachedPlot then
                        Notify("Reset", "إعادة اللاعب...", 2)
                        ResetCharacter()
                        task.wait(FARM.PostResetWait)
                    end
                end
            else
                Notify("NAZK HUB", "ما فيه بيضة تناسب الفلتر", 3)
            end

            if not FarmEnabled then break end
            if FARM.Loop and FarmEnabled then task.wait(FARM.LoopDelay) else break end
        until not FarmEnabled

        FarmEnabled = false
        if FloatingEgg then FloatingEgg.Text = "Farm" end
        if Refs.FarmToggle then pcall(function() Refs.FarmToggle:SetValue(false) end) end
    end)
end

local function StopFarm()
    FarmEnabled = false
    if FarmTask then
        pcall(function() task.cancel(FarmTask) end)
        FarmTask = nil
    end
    if FloatingEgg then FloatingEgg.Text = "Farm" end
end

-- AUTO PLACE EGG
local function GetEggRemote()
    local RS = ReplicatedStorage
    local Remotes = RS:FindFirstChild("Remotes"); if not Remotes then return nil end
    local GameR = Remotes:FindFirstChild("Game"); if not GameR then return nil end
    return GameR:FindFirstChild("EggPlaced")
end

local function GetPlacePosition()
    if AutoPlaceEggPosition == "My Plot" then
        local MyPlot = GetMyPlot()
        if MyPlot then return GetPlotCenter(MyPlot) end
        return nil
    else
        local Root = GetRoot()
        return Root and Root.Position
    end
end

local function PlaceEggOnce()
    local Remote = GetEggRemote()
    if not Remote then return false, "no remote" end
    local Pos = GetPlacePosition()
    if not Pos then return false, "no position" end
    if AutoPlaceEggRandomize then
        Pos = Pos + Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
    end
    local Ok1 = pcall(function() Remote:FireServer({ PlantPosition = Pos, EggName = AutoPlaceEggType, EggType = AutoPlaceEggType }) end)
    if not Ok1 then
        local Ok2 = pcall(function() Remote:FireServer({ PlantPosition = Pos, EggName = AutoPlaceEggType }) end)
        if not Ok2 then pcall(function() Remote:FireServer({ PlantPosition = Pos }) end) end
    end
    return true, "sent"
end

local function StartAutoPlaceEgg()
    if AutoPlaceEggTask then pcall(function() task.cancel(AutoPlaceEggTask) end) end
    AutoPlaceEggEnabled = true
    AutoPlaceEggTask = task.spawn(function()
        while AutoPlaceEggEnabled do
            local OK, Err = PlaceEggOnce()
            if not OK then Notify("Auto Place Egg", "فشل: "..tostring(Err), 2) end
            task.wait(AutoPlaceEggDelay)
        end
    end)
end

local function StopAutoPlaceEgg()
    AutoPlaceEggEnabled = false
    if AutoPlaceEggTask then pcall(function() task.cancel(AutoPlaceEggTask) end); AutoPlaceEggTask = nil end
end

