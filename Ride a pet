local function UnlockNests()
    local plot = OwnPlot()
    local nests = PlotNests(plot)
    if not nests then return 0 end
    local cash = PlayerCash()
    local unlocked = 0
    for _, n in ipairs(nests:GetChildren()) do
        if HUB.dead then break end
        if n:GetAttribute("Unlocked") ~= true then
            local idx = tonumber(n.Name) or 1
            local price = NEST_PRICES[idx] or math.huge
            if cash >= price then
                local prompt = n:FindFirstChild("UnlockNest", true)
                if prompt and prompt:IsA("ProximityPrompt") and FirePrompt(prompt) then
                    for _ = 1, 12 do
                        task.wait(0.05)
                        if n:GetAttribute("Unlocked") == true then
                            unlocked = unlocked + 1
                            S.stats.nests = S.stats.nests + 1
                            cash = PlayerCash()
                            break
                        end
                    end
                end
            end
        end
    end
    return unlocked
end

local function RebirthCost()
    local current = tonumber(PlayerStat("Rebirths")) or 0
    if RebirthData and RebirthData.GetCost then
        local ok, res = pcall(RebirthData.GetCost, current)
        if ok and type(res) == "number" then return res end
    end
    return 1000000 * (50 ^ current)
end

local function TryRebirth()
    local current = tonumber(PlayerStat("Rebirths")) or 0
    local cap = (RebirthData and RebirthData.Cap) or 6
    if current >= cap then return false, "cap reached" end
    if HUB.rebirthPending then return false, "waiting for server confirmation" end
    if PlayerCash() < RebirthCost() then return false, "not enough cash" end
    local remote = Remote("Rebirth")
    if not remote then return false, "rebirth remote missing" end
    local sent, sendError = pcall(function() remote:FireServer() end)
    if not sent then return false, "rebirth request failed: " .. tostring(sendError) end
    HUB.rebirthPending = true
    task.spawn(function()
        for _ = 1, 40 do
            if HUB.dead then return end
            task.wait(0.25)
            local now = tonumber(PlayerStat("Rebirths")) or current
            if now > current then
                S.stats.rebirths = S.stats.rebirths + (now - current)
                HUB.rebirthPending = false
                return
            end
        end
        HUB.rebirthPending = false
    end)
    return true, "request sent"
end

