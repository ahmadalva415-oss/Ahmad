-- UNIFIED WINDUI CONTROLS
-- Every original Arc / NAZK command and button is represented below.
-- ============================================================================
local toggleRefs = {}
local function SetState(key, value)
    S[key] = value
    for _, control in ipairs(toggleRefs[key] or {}) do
        pcall(function() control:Set(value, false) end)
    end
end

local function AddToggle(container, options)
    local stateKey = options.StateKey
    options.StateKey = nil
    local userCallback = options.Callback
    if stateKey then
        options.Callback = function(value)
            SetState(stateKey, value)
            if userCallback then userCallback(value) end
        end
    end
    local value = options.Value
    if value == nil then value = options.Default end
    options.Value = value
    options.Default = nil
    local control = container:Toggle(options)
    if stateKey and control then
        toggleRefs[stateKey] = toggleRefs[stateKey] or {}
        table.insert(toggleRefs[stateKey], control)
    end
    return control
end

local function AddSlider(container, options)
    return container:Slider({
        Flag = options.Flag,
        Title = options.Title,
        Desc = options.Desc,
        Step = options.Step or 1,
        Value = { Min = options.Min, Max = options.Max, Default = options.Default },
        Callback = options.Callback,
    })
end

local function AddDropdown(container, options)
    return container:Dropdown({
        Flag = options.Flag,
        Title = options.Title,
        Desc = options.Desc,
        Values = options.Values,
        Value = options.Value,
        AllowNone = options.AllowNone,
        Multi = options.Multi,
        Callback = options.Callback,
    })
end

local function SelectionNames(list)
    local out = {}
    for _, item in ipairs(type(list) == "table" and list or {}) do
        out[#out + 1] = type(item) == "table" and (item.Title or item.Value or item.Name) or item
    end
    return out
end

local function SetParagraphDesc(control, text)
    local paragraph = control and control.ParagraphFrame
    local desc = paragraph and paragraph.UIElements and paragraph.UIElements.Desc
    if not desc then return false end
    desc.Text = tostring(text or "")
    desc.Visible = desc.Text ~= ""
    return true
end

