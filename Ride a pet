local function TeleportToPosition(Pos)
    local Root = GetRoot(); if not Root or not Pos then return end
    Root.CFrame = CFrame.new(Pos + Vector3.new(0, 5, 0))
    if Root.AssemblyLinearVelocity then Root.AssemblyLinearVelocity = Vector3.new(0,0,0) end
    if Root.AssemblyAngularVelocity then Root.AssemblyAngularVelocity = Vector3.new(0,0,0) end
end

local function SmoothMove(TargetPos, Speed)
    Speed = Speed or TweenSpeed
    local Root = GetRoot()
    if not Root or not TargetPos then return false end

    local Char = LocalPlayer.Character
    if not Char then return false end

    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if not Hum or Hum.Health <= 0 then return false end

    local OldAutoRotate = Hum.AutoRotate
    Hum.AutoRotate = false

    local OriginalCollide = {}
    local PartsList = {}
    for _, Part in ipairs(Char:GetDescendants()) do
        if Part:IsA("BasePart") then
            OriginalCollide[Part] = Part.CanCollide
            Part.CanCollide = false
            table.insert(PartsList, Part)
        end
    end

    local TempNoClipConn
    if not NoClipEnabled then
        TempNoClipConn = RunService.Stepped:Connect(function()
            if not Char or not Char.Parent then return end
            for _, Part in ipairs(PartsList) do
                if Part and Part.Parent then Part.CanCollide = false end
            end
        end)
    end

    local StartPos = Root.Position
    local FinalPos = TargetPos + Vector3.new(0, 5, 0)
    local Distance = (FinalPos - StartPos).Magnitude
    local Duration = math.max(Distance / Speed, 0.3)

    local StartTime = tick()
    local Done = false
    local HeartbeatConn

    HeartbeatConn = RunService.Heartbeat:Connect(function()
        if not FarmEnabled then Done = true; return end
        if not Root or not Root.Parent then Done = true; return end
        if not Char.Parent then Done = true; return end
        if not Hum.Parent or Hum.Health <= 0 then Done = true; return end

        local Elapsed = tick() - StartTime
        if Elapsed > 30 then Done = true; return end

        local Alpha = math.min(Elapsed / Duration, 1)
        local SmoothAlpha = Alpha * Alpha * (3 - 2 * Alpha)

        Root.CFrame = CFrame.new(StartPos:Lerp(FinalPos, SmoothAlpha))
        Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        Root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

        if Alpha >= 1 then Done = true end
    end)

    local Timeout = tick() + 32
    while not Done and tick() < Timeout do
        task.wait(0.02)
    end

    if HeartbeatConn then HeartbeatConn:Disconnect() end
    if TempNoClipConn then TempNoClipConn:Disconnect() end

    if Char and Char.Parent then
        if Hum and Hum.Parent then
            Hum.AutoRotate = OldAutoRotate
        end
        if not NoClipEnabled then
            for Part, OldVal in pairs(OriginalCollide) do
                if Part and Part.Parent then Part.CanCollide = OldVal end
            end
        end
    end

    return true
end

-- PLOT
local function GetMyPlot()
    local Plots = Workspace:FindFirstChild("Plots")
    if not Plots then return nil end
    for _, Plot in ipairs(Plots:GetChildren()) do
        local Data = Plot:FindFirstChild("Data")
        if Data then
            local Owner = Data:FindFirstChild("Owner")
            if Owner then
                if Owner:IsA("ObjectValue") and Owner.Value == LocalPlayer then return Plot end
                if Owner:IsA("StringValue") and Owner.Value == LocalPlayer.Name then return Plot end
                if Owner:IsA("NumberValue") and tostring(Owner.Value) == tostring(LocalPlayer.UserId) then return Plot end
                if Owner:IsA("IntValue") and tostring(Owner.Value) == tostring(LocalPlayer.UserId) then return Plot end
            end
        end
    end
    return nil
end

local function GetPlotOwnerName(Plot)
    if not Plot then return "?" end
    local Data = Plot:FindFirstChild("Data")
    if Data then
        local Owner = Data:FindFirstChild("Owner")
        if Owner and Owner.Value ~= nil then return tostring(Owner.Value) end
    end
    return Plot.Name
end

local function IsEggInPlot(Egg, Plot)
    if not Egg or not Plot then return false end
    local Cur = Egg
    while Cur and Cur ~= Workspace do
        if Cur == Plot then return true end
        Cur = Cur.Parent
    end
    return false
end

local function GetPlotCenter(Plot)
    if not Plot then return nil end
    if Plot:IsA("Model") then
        local ok, pivot = pcall(function() return Plot:GetPivot() end)
        if ok and pivot then return pivot.Position end
    end
    local Biggest, BiggestSize = nil, 0
    for _, Desc in ipairs(Plot:GetDescendants()) do
        if Desc:IsA("BasePart") then
            local Size = Desc.Size.X * Desc.Size.Z
            if Size > BiggestSize then
                Biggest = Desc
                BiggestSize = Size
            end
        end
    end
    if Biggest then return Biggest.Position end
    return nil
end

