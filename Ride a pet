    AntiAFKEnabled = true
    AntiAFKConnection = LocalPlayer.Idled:Connect(function()
        if AntiAFKEnabled then VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end
    end)
end
local function StopAntiAFK()
    AntiAFKEnabled = false
