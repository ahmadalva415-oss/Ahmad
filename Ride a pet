-- HATCH-LUCK-UPGRADES (Preis/Multiplier kommen aus GameData.HatchLuck)
-- ==============================================================================
local function HatchUpgradeLevel()
    return tonumber(PlayerStat("HatchUpgrades")) or 0
end

local function HatchLuckMultiplier()
    local level = HatchUpgradeLevel()
    if HatchLuck and type(HatchLuck.GetMultiplier) == "function" then
        local ok, res = pcall(HatchLuck.GetMultiplier, level)
        if ok and type(res) == "number" then return res end
    end
    return 1 + level
end

local function HatchUpgradePrice(level)
    level = tonumber(level) or HatchUpgradeLevel()
    if HatchLuck and type(HatchLuck.GetPrice) == "function" then
        local ok, res = pcall(HatchLuck.GetPrice, level)
        if ok and type(res) == "number" and res >= 0 then return res end
    end
    return 5 + level * 5
end

local function NextHatchUpgradePrice()
    return HatchUpgradePrice(HatchUpgradeLevel())
end

local function MaxAffordableHatchUpgrades(availableCash)
    local level = HatchUpgradeLevel()
    local cash = tonumber(availableCash)
    if cash == nil then cash = PlayerCash() end
    if HatchLuck and type(HatchLuck.GetMaxAffordable) == "function" then
        local ok, count, cost = pcall(HatchLuck.GetMaxAffordable, level, cash)
        if ok and type(count) == "number" then
            return math.max(0, math.floor(count)), (type(cost) == "number" and cost or 0)
        end
    end
    local count, cost = 0, 0
    for offset = 0, 199 do
        local price = HatchUpgradePrice(level + offset)
        if price <= 0 or cost + price > cash then break end
        count, cost = count + 1, cost + price
    end
    return count, cost
end

local function UpgradeRemote()
    local plotRemotes = GameRemotes and GameRemotes:FindFirstChild("Plot")
    return plotRemotes and plotRemotes:FindFirstChild("Upgrades")
end

-- Buys luck upgrades: mode = "Max" or "1 Upgrade", as long as the reserve stays
local function BuyHatchUpgrades(mode, force)
    local remote = UpgradeRemote()
    if not remote then return false, "upgrades remote missing" end
    local reserve = force and 0 or math.max(tonumber(S.upgradeReserve) or 0, 0)
    local selectedMode = mode or S.luckBuyMode
    local count = 1
    if selectedMode == "Max" then
        count = MaxAffordableHatchUpgrades(PlayerCash() - reserve)
        if count <= 0 then return false, "reserve or insufficient cash" end
        count = math.min(count, 200)
    elseif PlayerCash() - NextHatchUpgradePrice() < reserve then
        return false, "reserve or insufficient cash"
    end

    local bought = 0
    for _ = 1, count do
        if HUB.dead then break end
        local levelBefore = HatchUpgradeLevel()
        local price = HatchUpgradePrice(levelBefore)
        if PlayerCash() - price < reserve then break end
        -- Use the already-validated single-upgrade request repeatedly instead of the
        -- server's unbounded "Max" mode, which could spend the cash reserve.
        local sent, sendError = pcall(function() remote:FireServer(1) end)
        if not sent then return bought > 0, "upgrade request failed: " .. tostring(sendError) end
        local confirmed = false
        for _ = 1, 15 do
            task.wait(0.1)
            if HatchUpgradeLevel() > levelBefore then
                confirmed = true
                break
            end
            if HUB.dead then break end
        end
        if not confirmed then break end
        bought = bought + 1
    end
    return bought > 0, bought
end

