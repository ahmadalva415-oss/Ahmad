local function FinishLoading()
    task.spawn(function()
        for i = 1, 85 do
            if HUB.dead then return end
            BarFill.Size = UDim2.new(i / 100, 0, 1, 0)
            Percent.Text = i .. "%"
            if i < 30 then LoadingStatus.Text = "Loading assets..."
            elseif i < 60 then LoadingStatus.Text = "Loading WindUI..."
            else LoadingStatus.Text = "Building unified UI..." end
            task.wait(0.02)
        end
        for i = 85, 100 do
            if HUB.dead then return end
            BarFill.Size = UDim2.new(i / 100, 0, 1, 0)
            Percent.Text = i .. "%"
            LoadingStatus.Text = "Opening..."
            task.wait(0.03)
        end
        task.wait(0.2)
        pcall(function()
            TweenService:Create(LoadingFrame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(BlurBg, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
            for _, v in ipairs(LoadingFrame:GetDescendants()) do
                if v:IsA("TextLabel") then
                    TweenService:Create(v, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
                elseif v:IsA("ImageLabel") then
                    TweenService:Create(v, TweenInfo.new(0.4), { ImageTransparency = 1 }):Play()
                elseif v:IsA("Frame") then
                    TweenService:Create(v, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
                end
            end
        end)
        task.wait(0.45)
        pcall(function() if LoadingGui then LoadingGui:Destroy() end end)
        pcall(function() Window:Open() end)
    end)
end

