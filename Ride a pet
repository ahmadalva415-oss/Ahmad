    local Color = ThemeColors[ThemeName] or ThemeColors["AMOLED"]
    if NButton then NButton.BackgroundColor3 = Color end
    if FloatingDash then FloatingDash.BackgroundColor3 = Color end
    if FloatingEgg then FloatingEgg.BackgroundColor3 = Color end
end
ApplyFloatingTheme(CurrentThemeName)

_G.NAZK_HUB_CLEANUP = function()
    pcall(function() if FloatingGui then FloatingGui:Destroy() end end)
    pcall(function() if Fluent and Fluent.Destroy then Fluent:Destroy() end end)
    if AntiAFKConnection then pcall(function() AntiAFKConnection:Disconnect() end) end
    if NoClipConnection then pcall(function() NoClipConnection:Disconnect() end) end
    if AntiFlingConnection then pcall(function() AntiFlingConnection:Disconnect() end) end
    if AutoRejoinConnection then pcall(function() AutoRejoinConnection:Disconnect() end) end
    if InfiniteJumpConnection then pcall(function() InfiniteJumpConnection:Disconnect() end) end
    if FarmTask then pcall(function() task.cancel(FarmTask) end) end
    if AutoPlaceEggTask then pcall(function() task.cancel(AutoPlaceEggTask) end) end
    if AutoBuyTask then pcall(function() task.cancel(AutoBuyTask) end) end
    pcall(function()
        FullbrightEnabled = false; ApplyFullbright()
        local Cam = Workspace.CurrentCamera
        if Cam then Cam.FieldOfView = 70 end
    end)
end

local function SetMenuVisible(Visible)
    MenuVisible = Visible
    if FluentRoot and FluentRoot:IsA("GuiObject") then
        FluentRoot.Visible = Visible
    elseif Window.Minimize then
        pcall(function() Window:Minimize() end)
    end
end
local function MakeDraggable(Button, ClickCallback)
    local IsDragging = false
    local ThisDragInput, ThisDragStart, ThisStartPos = nil, nil, nil
    local ThisMoved = false
    Button.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = true; ThisMoved = false
            ThisDragStart = Input.Position
            ThisStartPos = Button.Position
        end
    end)
    Button.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            ThisDragInput = Input
        end
    end)
    Button.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = false
            if not ThisMoved then ClickCallback() end
        end
    end)
    UserInputService.InputChanged:Connect(function(Input)
        if Input == ThisDragInput and IsDragging then
            local Delta = Input.Position - ThisDragStart
            if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then ThisMoved = true end
            Button.Position = UDim2.new(
                ThisStartPos.X.Scale, ThisStartPos.X.Offset + Delta.X,
                ThisStartPos.Y.Scale, ThisStartPos.Y.Offset + Delta.Y
            )
        end
    end)
end
MakeDraggable(NButton, function() SetMenuVisible(not MenuVisible) end)
MakeDraggable(FloatingDash, DoDash)
MakeDraggable(FloatingEgg, function()
    if FarmEnabled then
        StopFarm()
        if Refs.FarmToggle then pcall(function() Refs.FarmToggle:SetValue(false) end) end
        PlaySound("Off", 0.3)
    else
        StartFarm()
        if Refs.FarmToggle then pcall(function() Refs.FarmToggle:SetValue(true) end) end
        PlaySound("Toggle", 0.3)
    end
end)

UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end
    if Input.KeyCode == Keybinds.Dash then DoDash()
    elseif Input.KeyCode == Keybinds.HideMenu then SetMenuVisible(not MenuVisible)
    elseif Input.KeyCode == Keybinds.AutoFarm then
        if FarmEnabled then
            StopFarm()
            if Refs.FarmToggle then pcall(function() Refs.FarmToggle:SetValue(false) end) end
        else
            StartFarm()
            if Refs.FarmToggle then pcall(function() Refs.FarmToggle:SetValue(true) end) end
        end
    end
end)

