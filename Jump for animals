local function findMutationPet(targetName)
    local cand, candCps
    forEachContainer(function(cont)
        for _, ch in ipairs(cont:GetChildren()) do
            if isPetTool(ch) then
                local name = ch:GetAttribute("AnimalName") or ch.Name
                local cps = tonumber(ch:GetAttribute("CashPerSecond")) or math.huge
                if name == targetName and (not candCps or cps < candCps) then cand, candCps = ch, cps end
            end
        end
    end)
    return cand
end

local function findDuplicateAnimal()
    local counts, lowest = {}, {}
    forEachContainer(function(cont)
        for _, ch in ipairs(cont:GetChildren()) do
            if isPetTool(ch) then
                local name = ch:GetAttribute("AnimalName") or ch.Name
                local cps = tonumber(ch:GetAttribute("CashPerSecond")) or math.huge
                counts[name] = (counts[name] or 0) + 1
                if not lowest[name] or cps < lowest[name] then lowest[name] = cps end
            end
        end
    end)
    local bestName, bestCps
    for name, count in pairs(counts) do
        if count >= 2 and (not bestCps or lowest[name] < bestCps) then bestName, bestCps = name, lowest[name] end
    end
    return bestName
end

local function mutationPromptByName(name)
    local map = workspace:FindFirstChild("Map")
    local muts = map and map:FindFirstChild("Mutations")
    local det = muts and muts:FindFirstChild("Detector")
    local prompt = det and det:FindFirstChild(name, true)
    return prompt, det
end

local function fireMutation(name, detector)
    local prompt = detector and detector:FindFirstChild(name, true)
    if not prompt or not prompt.Enabled then return false end
    local pos = holderPosition(prompt.Parent)
    if pos then teleportTo(pos); task.wait(0.2) end
    fireproximityprompt(prompt); task.wait(0.35)
    return true
end

local function doAutoMutation()
    local active = LocalPlayer:GetAttribute("MutationCraftActive") == true
    local ready = LocalPlayer:GetAttribute("MutationCraftReady") == true
    local canRemove = LocalPlayer:GetAttribute("MutationCanRemove") == true
    local _, det = mutationPromptByName("MutationPrompt")
    if State.AutoClaimMutation and active and ready then fireMutation("MutationPrompt", det); return end
    if State.AutoReturnMutation and active and canRemove then fireMutation("MutationRemovePrompt", det); return end
    if not State.AutoAddMutation or active then return end
    local target = LocalPlayer:GetAttribute("MutationCraftAnimalName")
    if type(target) ~= "string" or target == "" then
        if State.MutationMode == "Chosen Animal" then target = State.MutationAnimal
        else target = findDuplicateAnimal() end
    end
    if not target or target == "None" then return end
    local tool = findMutationPet(target)
    if not tool then return end
    local hum = getHumanoid()
    if not hum then return end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.2)
    fireMutation("MutationPrompt", det)
end

