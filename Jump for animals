local function getCharacter() return LocalPlayer.Character end
local function getHumanoid()
    local c = getCharacter(); return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
    local c = getCharacter(); return c and c:FindFirstChild("HumanoidRootPart")
end
local function teleportTo(pos)
    local r = getRoot()
    if r and pos then r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)); return true end
    return false
end
local function holderPosition(holder)
    if not holder then return nil end
    if holder:IsA("BasePart") then return holder.Position end
    if holder:IsA("Attachment") then return holder.WorldPosition end
    return nil
end
local function getPlot()
    local p = LocalPlayer:FindFirstChild("Plot"); return p and p.Value or nil
end
local function getSquatDetector()
    local plot = getPlot()
    local zone = plot and plot:FindFirstChild("SquatZone")
    local floor = zone and zone:FindFirstChild("Floor")
    return floor and floor:FindFirstChild("Detector") or nil
end
local function getPlacementDetector()
    local plot = getPlot()
    return plot and plot:FindFirstChild("Detector", true) or nil
end
local function getCash()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local c = ls and ls:FindFirstChild("Cash"); local v = c and c:FindFirstChild("V")
    return v and tonumber(v.Value) or 0
end
local function getLevel()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local l = ls and ls:FindFirstChild("Level"); local v = l and l:FindFirstChild("V")
    return v and tonumber(v.Value) or 0
end
local function isPetTool(t) return t:IsA("Tool") and t:GetAttribute("IsPetInventoryTool") == true end
local function isEggTool(t) return t:IsA("Tool") and t:GetAttribute("IsEggTool") == true end

local function forEachContainer(fn)
    local c = getCharacter()
    if LocalPlayer.Backpack then fn(LocalPlayer.Backpack) end
    if c then fn(c) end
end
local function findTool(pred)
    local found
    forEachContainer(function(cont)
        if found then return end
        for _, ch in ipairs(cont:GetChildren()) do
            if ch:IsA("Tool") and pred(ch) then found = ch; return end
        end
    end)
    return found
end
local function countEggTools()
    local n = 0
    forEachContainer(function(cont)
        for _, ch in ipairs(cont:GetChildren()) do if isEggTool(ch) then n += 1 end end
    end)
    return n
end
local function countPlacedEggs()
    local plot = getPlot(); local placed = plot and plot:FindFirstChild("PlacedEggs")
    return placed and #placed:GetChildren() or 0
end
local function countReadyEggs()
    local plot = getPlot(); local placed = plot and plot:FindFirstChild("PlacedEggs")
    if not placed then return 0 end
    local n = 0
    for _, egg in ipairs(placed:GetChildren()) do
        if egg:GetAttribute("HatchReady") == true then n += 1 end
    end
    return n
end
local function uniqueAnimalNames()
    local names, seen = {}, {}
    forEachContainer(function(cont)
        for _, ch in ipairs(cont:GetChildren()) do
            if isPetTool(ch) then
                local name = ch:GetAttribute("AnimalName") or ch.Name
                if not seen[name] then seen[name] = true; table.insert(names, name) end
            end
        end
    end)
    table.sort(names); return names
end
local function abbreviate(v)
    v = tonumber(v) or 0
    local units = { "", "K", "M", "B", "T", "Qa", "Qi" }
    local i = 1
    while v >= 1000 and i < #units do v /= 1000; i += 1 end
    if i == 1 then return tostring(math.floor(v)) end
    return string.format("%.2f%s", v, units[i])
end
local function formatClock(s)
    s = math.max(math.floor(s), 0)
    local h = math.floor(s / 3600); local m = math.floor((s % 3600) / 60); local sec = s % 60
    return string.format("%02d:%02d:%02d", h, m, sec)
end

