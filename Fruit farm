local function FindAndClickFruitBag()
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    for _, gui in pairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, btn in pairs(gui:GetDescendants()) do
                if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                    local text = btn:IsA("TextButton") and btn.Text or ""
                    if text:lower():match("fruit bag") or text:lower():match("fruitbag") then
                        if btn.Visible then return ClickButton(btn) end
                    end
                    if text:lower():match("^eat$") and btn.Visible then return ClickButton(btn) end
                    if text:lower():match("^equip$") and btn.Visible then return ClickButton(btn) end
                    for _, child in pairs(btn:GetDescendants()) do
                        if child:IsA("TextLabel") then
                            local ct = child.Text:lower()
                            if ct:match("fruit bag") or ct:match("fruitbag") then
                                if btn.Visible then return ClickButton(btn) end
                            end
                            if ct:match("^eat$") and btn.Visible then return ClickButton(btn) end
                            if ct:match("^equip$") and btn.Visible then return ClickButton(btn) end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function OpenFruitMenu(fruitObj)
    if not fruitObj or not fruitObj.Parent then return end
    for _, desc in pairs(fruitObj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(desc) end)
            return true
        end
    end
    for _, desc in pairs(fruitObj:GetDescendants()) do
        if desc:IsA("ClickDetector") then
            pcall(function() fireclickdetector(desc) end)
            return true
        end
    end
    local screenSize = Workspace.CurrentCamera.ViewportSize
    VirtualInputManager:SendTouchEvent(screenSize.X / 2, screenSize.Y / 2, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendTouchEvent(screenSize.X / 2, screenSize.Y / 2, 0, false, game, 1)
    return true
end

local function TakeFruit(fruitObj)
    if not fruitObj or not fruitObj.Parent then return end
    OpenFruitMenu(fruitObj)
    task.wait(0.4)
    FindAndClickFruitBag()
    if CollectFruitEvent then
        pcall(function() CollectFruitEvent:FireServer(fruitObj) end)
    end
    task.wait(0.3)
    for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, btn in pairs(gui:GetDescendants()) do
                if btn:IsA("TextButton") and btn.Text:match("%[CLOSE%]") then
                    if btn.Visible then ClickButton(btn) end
                end
            end
        end
    end
end

local function TweenToFruit(targetPos)
    if targetPos.Y < MIN_Y_LEVEL then return end  -- ⬅️ حماية إضافية
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    IsTweening = true
    local distance = (targetPos - hrp.Position).Magnitude
    local duration = math.max(distance / TWEEN_SPEED, 0.2)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local goal = { CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0)) }
    local tween = TweenService:Create(hrp, tweenInfo, goal)
    tween:Play()
    tween.Completed:Wait()
    IsTweening = false
end

-- ═══════════════════════════════════════
--  MAIN SCANNER
-- ═══════════════════════════════════════
local function ScanDrops()
    if not FRUIT_DROPS_PATH then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local current = {}
    local nearest = nil
    local nearestDist = math.huge
    local fruitFound = false

    for _, obj in pairs(FRUIT_DROPS_PATH:GetDescendants()) do
        if obj:IsA("Folder") then continue end
        local depth = 0
        local p = obj.Parent
        while p and p ~= FRUIT_DROPS_PATH do
            depth = depth + 1
            p = p.Parent
        end
        if depth > 2 then continue end
        if obj:IsA("BasePart") and depth > 1 then continue end

        local pos = GetPosition(obj)
        -- ⬅️ فلتر Y < 2.86
        if not pos or pos.Y < MIN_Y_LEVEL then continue end

        local dist = (pos - hrp.Position).Magnitude
        if dist <= MAX_DISTANCE then
            current[obj] = true
            fruitFound = true
            if dist < nearestDist then
                nearestDist = dist
                nearest = obj
            end
            if State.DropEnabled then
                if not ESPObjects.Drops[obj] then
                    local part = GetTargetPart(obj)
                    if part then
                        local name = GetFruitName(obj)
                        local esp = CreateESP(part, Color3.fromRGB(255, 60, 60), name .. "\n[" .. math.floor(dist) .. "m]")
                        ESPObjects.Drops[obj] = { ESP = esp, Name = name, Obj = obj }
                    end
                else
                    local data = ESPObjects.Drops[obj]
                    if data.ESP and data.ESP.Label then
                        data.ESP.Label.Text = data.Name .. "\n[" .. math.floor(dist) .. "m]"
                    end
                end
            end
        end
    end

    if fruitFound then
        LastFruitSeen = tick()
        TimerLabel.Text = "✅ Fruit found!"
        TimerLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        local timeLeft = math.max(0, HOP_DELAY - (tick() - LastFruitSeen))
        TimerLabel.Text = "⏱ Hop in: " .. math.floor(timeLeft) .. "s"
        TimerLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    end

    if State.AutoServerHop and not fruitFound and not IsHopping then
        if tick() - LastFruitSeen >= HOP_DELAY then
            ServerHop()
            return
        end
    end

    if State.DropEnabled then
        for obj, data in pairs(ESPObjects.Drops) do
            if not current[obj] or not obj.Parent then
                if data.ESP then
                    if data.ESP.Highlight then data.ESP.Highlight:Destroy() end
                    if data.ESP.Billboard then data.ESP.Billboard:Destroy() end
                end
                ESPObjects.Drops[obj] = nil
            end
        end
    end

    if State.AutoTween and nearest and not IsTweening then
        if nearestDist > TAKE_DISTANCE then
            local pos = GetPosition(nearest)
            if pos then TweenToFruit(pos) end
        end
    end

    if State.AutoTake and nearest and nearestDist <= TAKE_DISTANCE then
        local now = tick()
        if now - LastTakeTime > 1.5 then
            LastTakeTime = now
            TakeFruit(nearest)
        end
    end
end

local function ScanSpawns()
    if not State.SpawnEnabled or not FRUIT_SPAWNS_PATH then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local current = {}
    for _, obj in pairs(FRUIT_SPAWNS_PATH:GetDescendants()) do
        if obj:IsA("Folder") then continue end
        local pos = GetPosition(obj)
        -- ⬅️ فلتر Y < 2.86
        if not pos or pos.Y < MIN_Y_LEVEL then continue end

        local dist = (pos - hrp.Position).Magnitude
        if dist <= MAX_DISTANCE then
            current[obj] = true
            if not ESPObjects.Spawns[obj] then
                local part = GetTargetPart(obj)
                if part then
                    local name = GetFruitName(obj)
                    local esp = CreateESP(part, Color3.fromRGB(60, 150, 255), "📍 " .. name .. "\n[" .. math.floor(dist) .. "m]")
                    ESPObjects.Spawns[obj] = { ESP = esp, Name = name }
                end
            else
                local data = ESPObjects.Spawns[obj]
                if data.ESP and data.ESP.Label then
                    data.ESP.Label.Text = "📍 " .. data.Name .. "\n[" .. math.floor(dist) .. "m]"
                end
            end
        end
    end

    for obj, data in pairs(ESPObjects.Spawns) do
        if not current[obj] or not obj.Parent then
            if data.ESP then
                if data.ESP.Highlight then data.ESP.Highlight:Destroy() end
                if data.ESP.Billboard then data.ESP.Billboard:Destroy() end
            end
            ESPObjects.Spawns[obj] = nil
        end
    end
end

