local function CreateESP(parent, color, text)
    for _, c in pairs(parent:GetChildren()) do
        if c.Name == "FruitESP" then c:Destroy() end
    end
    local hl = Instance.new("Highlight")
    hl.Name = "FruitESP"
    hl.FillColor = color
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = parent

    local bb = Instance.new("BillboardGui")
    bb.Name = "FruitESP"
    bb.Size = UDim2.new(0, 220, 0, 50)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0.15
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextSize = 18
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bb

    return { Highlight = hl, Billboard = bb, Label = lbl }
end

function ClearDrops()
    for obj, data in pairs(ESPObjects.Drops) do
        if data.ESP then
            if data.ESP.Highlight then data.ESP.Highlight:Destroy() end
            if data.ESP.Billboard then data.ESP.Billboard:Destroy() end
        end
    end
    table.clear(ESPObjects.Drops)
end

function ClearSpawns()
    for obj, data in pairs(ESPObjects.Spawns) do
        if data.ESP then
            if data.ESP.Highlight then data.ESP.Highlight:Destroy() end
            if data.ESP.Billboard then data.ESP.Billboard:Destroy() end
        end
    end
    table.clear(ESPObjects.Spawns)
end

local function GetPosition(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        for _, c in pairs(obj:GetDescendants()) do
            if c:IsA("BasePart") then return c.Position end
        end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function GetTargetPart(obj)
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

