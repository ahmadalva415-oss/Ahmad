local BAD_NAMES = {
    ["Meshes"] = true, ["Parts"] = true, ["Handle"] = true,
    ["Part"] = true, ["Union"] = true, ["Model"] = true,
    ["Workspace"] = true, ["Logic"] = true, ["FruitDrops"] = true,
    ["FruitSpawns"] = true, ["Clear"] = true, ["Script"] = true,
    ["LocalScript"] = true, ["Folder"] = true,
    ["Accessories"] = true, ["Accessory"] = true,
    ["Animation"] = true, ["Animate"] = true,
    ["Humanoid"] = true, ["Head"] = true, ["Torso"] = true,
}

local KNOWN_FRUITS = {
    ["Bomb"] = true, ["Buddha"] = true, ["Combat"] = true,
    ["Darkness"] = true, ["Flame"] = true, ["Sand"] = true,
    ["Smoke"] = true, ["Spike"] = true, ["String"] = true,
    ["Vanish"] = true, ["Venom"] = true, ["Zenith"] = true,
    ["Gum"] = true, ["Electricity"] = true, ["Dragon"] = true,
    ["Ice"] = true, ["Light"] = true, ["Magma"] = true,
    ["Quake"] = true, ["Rumble"] = true, ["Shadow"] = true,
    ["Gravity"] = true, ["Phoenix"] = true, ["Dough"] = true,
    ["Leopard"] = true, ["Yeti"] = true, ["T-Rex"] = true,
    ["Mammoth"] = true, ["Kitsune"] = true, ["DragonV2"] = true,
}

local function isCleanName(name)
    if not name or name == "" then return false end
    if name:match("^Meshes/") or name:match("^Parts/") or name:match("^Union") then return false end
    if name:match("^Part%d*$") or name:match("^Handle%d*$") or name:match("^Mesh%d*$") then return false end
    if name:match("^%d+$") then return false end
    if BAD_NAMES[name] then return false end
    return true
end

local function GetFruitName(obj)
    if isCleanName(obj.Name) and KNOWN_FRUITS[obj.Name] then return obj.Name end
    if obj.Parent and isCleanName(obj.Parent.Name) and KNOWN_FRUITS[obj.Parent.Name] then return obj.Parent.Name end
    for _, c in pairs(obj:GetChildren()) do
        if c:IsA("BasePart") and isCleanName(c.Name) and KNOWN_FRUITS[c.Name] then return c.Name end
    end
    for _, d in pairs(obj:GetDescendants()) do
        if d:IsA("BasePart") and isCleanName(d.Name) and KNOWN_FRUITS[d.Name] then return d.Name end
    end
    if isCleanName(obj.Name) then return obj.Name end
    if obj.Parent and isCleanName(obj.Parent.Name) then return obj.Parent.Name end
    for _, c in pairs(obj:GetChildren()) do
        if c:IsA("BasePart") and isCleanName(c.Name) then return c.Name end
    end
    return "🍎 Fruit"
end

