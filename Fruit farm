local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local function IsPlayVisible()
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, btn in pairs(gui:GetDescendants()) do
                if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                    local text = ""
                    if btn:IsA("TextButton") then
                        text = btn.Text
                    elseif btn:IsA("ImageButton") then
                        for _, child in pairs(btn:GetDescendants()) do
                            if child:IsA("TextLabel") or child:IsA("TextButton") then
                                text = child.Text
                                if text:lower():match("play") then return true, btn end
                            end
                        end
                    end
                    if text:lower():match("play") then return true, btn end
                end
            end
        end
    end
    return false, nil
end

local function ClickButton(btn)
    if not btn or not btn.Visible then return false end
    pcall(function() btn.MouseButton1Click:Fire() end)
    pcall(function() if btn.Activated then btn.Activated:Fire() end end)
    
    local absPos = btn.AbsolutePosition
    local absSize = btn.AbsoluteSize
    if absSize.X <= 0 or absSize.Y <= 0 then return false end
    
    local cx = absPos.X + absSize.X / 2
    local cy = absPos.Y + absSize.Y / 2
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    return true
end

-- حلقة مستمرة تضغط PLAY لين تختفي
task.spawn(function()
    local attempts = 0
    local maxAttempts = 60
    
    repeat
        local visible, btn = IsPlayVisible()
        if visible and btn then
            ClickButton(btn)
            print("🎮 جاري الضغط على PLAY... (محاولة " .. attempts + 1 .. ")")
            attempts = attempts + 1
            task.wait(0.5)
        else
            print("✅ اختفت كلمة PLAY! تم الدخول للعبة.")
            break
        end
    until attempts >= maxAttempts
end)

