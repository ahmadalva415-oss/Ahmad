local SetRagdoll

local function Dash()
    local Root = GetRoot()
    local Humanoid = GetCharacter() and GetCharacter():FindFirstChildOfClass("Humanoid")
    if not Root or not Humanoid then return end

    local Direction = Humanoid.MoveDirection
    if Direction.Magnitude <= 0 then Direction = Root.CFrame.LookVector end
    local DashVelocity = Config.DashPower * Config.DashSpeed
    local OriginalY = Root.AssemblyLinearVelocity.Y
    if Config.DashRagdoll then SetRagdoll(true) end

    Root.AssemblyLinearVelocity = Vector3.new(
        Direction.Unit.X * DashVelocity,
        OriginalY,
        Direction.Unit.Z * DashVelocity
    )

    task.delay(Config.DashDuration, function()
        if Root and Root.Parent then
            local CurrentVelocity = Root.AssemblyLinearVelocity
            Root.AssemblyLinearVelocity = Vector3.new(CurrentVelocity.X * 0.15, CurrentVelocity.Y, CurrentVelocity.Z * 0.15)
        end
        if Config.DashRagdoll then SetRagdoll(false) end
    end)
end

SetRagdoll = function(State)
    local Humanoid = GetCharacter() and GetCharacter():FindFirstChildOfClass("Humanoid")
    if not Humanoid then return end
    Config.Ragdoll = State
    if State then
        Humanoid.PlatformStand = true
