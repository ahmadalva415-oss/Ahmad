local function UpdateServerListDisplay()
    local Filtered = ServerData.FilteredServers
    local Count = #Filtered

    if Count == 0 then
        ServerListParagraph:SetDesc("No servers match the current filter")
        return
    end

    local DisplayText = ""
    local MaxDisplay = math.min(Count, 10)

    for i = 1, MaxDisplay do
        local Server = Filtered[i]
        if Server then
            local ServerIdShort = string.sub(tostring(Server.id), 1, 8) .. "..."
            local PingText = Server.ping and (" | Ping: " .. math.floor(Server.ping) .. "ms") or ""
            DisplayText = DisplayText .. i .. ". " .. ServerIdShort .. " | Players: " .. Server.playing .. "/" .. Server.maxPlayers .. PingText .. "\n"
        end
    end

    if Count > MaxDisplay then
        DisplayText = DisplayText .. "... and " .. (Count - MaxDisplay) .. " more servers"
    end

    ServerListParagraph:SetDesc(DisplayText)
end

local function GetServers(Cursor)
    local Url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=" .. Config.ServerSortOrder .. "&limit=100"
    if Cursor then
        Url = Url .. "&cursor=" .. Cursor
    end

    local Success, Result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(Url))
    end)

    if Success and Result and Result.data then
        return Result
    end
    return nil
end

local function FetchAllServers()
    if ServerData.IsFetching then return end
    ServerData.IsFetching = true
    SetServerStatus("Fetching servers...")

    task.spawn(function()
        local AllServers = {}
        local Cursor = nil
        local MaxPages = 5 -- Limit to 500 servers to avoid rate limits
        local PageCount = 0

        repeat
            local Result = GetServers(Cursor)
            if not Result or not Result.data then break end

            for _, Server in ipairs(Result.data) do
                if Server.id ~= JobId then
                    table.insert(AllServers, Server)
                end
            end

            Cursor = Result.nextPageCursor
            PageCount = PageCount + 1
            task.wait(0.3) -- Rate limit protection
        until not Cursor or PageCount >= MaxPages

        ServerData.AllServers = AllServers
        ServerData.TotalServers = #AllServers
        ServerData.LastFetchTime = tick()
        ServerData.IsFetching = false

        -- Find one-player servers
        ServerData.OnePlayerServers = {}
        for _, Server in ipairs(AllServers) do
            if Server.playing == 1 then
                table.insert(ServerData.OnePlayerServers, Server)
            end
        end

        SetServerStatus("Loaded " .. #AllServers .. " servers | 1-Player: " .. #ServerData.OnePlayerServers)
        ApplyServerFilter()
    end)
end

local function ApplyServerFilter()
    local Filtered = {}
    local Filter = Config.ServerPlayerFilter

    for _, Server in ipairs(ServerData.AllServers) do
        local Include = false
        local Playing = Server.playing

        if Filter == "Any" then
            Include = true
        elseif Filter == "1 Player" and Playing == 1 then
            Include = true
        elseif Filter == "2 Players" and Playing == 2 then
            Include = true
        elseif Filter == "3 Players" and Playing == 3 then
            Include = true
        elseif Filter == "4 Players" and Playing == 4 then
            Include = true
        elseif Filter == "5 Players" and Playing == 5 then
            Include = true
        elseif Filter == "6+ Players" and Playing >= 6 then
            Include = true
        elseif Filter == "Empty" and Playing == 0 then
            Include = true
        elseif Filter == "Full" and Playing >= Server.maxPlayers then
            Include = true
        end

        if Include then
            table.insert(Filtered, Server)
        end
    end

    -- Sort by player count
    if Config.ServerSortOrder == "Asc" then
        table.sort(Filtered, function(a, b) return a.playing < b.playing end)
    else
        table.sort(Filtered, function(a, b) return a.playing > b.playing end)
    end

    ServerData.FilteredServers = Filtered
    UpdateServerListDisplay()
end

