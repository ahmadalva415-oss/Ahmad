local HideNameConnection = nil
CreateToggle(MiscPage, "Hide Name / Anti Report", false, function(State)
    Config.HideName = State
    
    local function HideCharacterName()
        local Character = GetCharacter()
        if not Character then return end
        
        local Head = Character:FindFirstChild("Head")
        if Head then
            for _, Child in pairs(Head:GetDescendants()) do
                if Child:IsA("BillboardGui") and (Child.Name:lower():find("name") or Child.Name:lower():find("title") or Child.Name:lower():find("tag")) then
                    Child.Enabled = not State
                end
            end
        end
        
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            if State then
                Humanoid.DisplayName = " "
                pcall(function() Humanoid.NameDisplayDistance = 0 end)
            else
                Humanoid.DisplayName = Player.DisplayName
                pcall(function() Humanoid.NameDisplayDistance = 100 end)
            end
        end
        
        for _, Obj in pairs(Character:GetDescendants()) do
            if Obj:IsA("BillboardGui") then
                if State then
                    Obj:SetAttribute("OriginalSize", tostring(Obj.Size))
                    Obj.Size = UDim2.new(0, 0, 0, 0)
                else
                    local Orig = Obj:GetAttribute("OriginalSize")
                    if Orig then
                        local X, Y = Orig:match("(%d+), (%d+)")
                        if X and Y then
                            Obj.Size = UDim2.new(0, tonumber(X), 0, tonumber(Y))
                        end
                    end
                end
            end
        end
    end
    
    if State then
        HideCharacterName()
        HideNameConnection = RunService.Heartbeat:Connect(function()
            if Config.HideName then
                HideCharacterName()
            end
        end)
    else
        if HideNameConnection then
            HideNameConnection:Disconnect()
            HideNameConnection = nil
        end
        HideCharacterName()
    end
end)

