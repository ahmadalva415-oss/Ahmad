local function StopCurrentTween()
    if Config.CurrentTween then
        pcall(function() Config.CurrentTween:Cancel() end)
        Config.CurrentTween = nil
    end
end

local function TweenTo(Position)
    if not Config.Enabled then return false end
    local Root = GetRoot()
    if not Root then return false end
    local Distance = (Root.Position - Position).Magnitude
    if Distance <= 2 then return true end

    local Duration = math.max(Distance / math.max(Config.TweenSpeed, 1), 0.05)
    local Tween = game:GetService("TweenService"):Create(
        Root,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
        { CFrame = CFrame.new(Position) }
    )
    Config.CurrentTween = Tween
    local Finished = false
    local Connection = Tween.Completed:Connect(function()
        Finished = true
    end)
    Tween:Play()

    while Config.Enabled and not Finished do task.wait() end
    Connection:Disconnect()

    if not Config.Enabled then
        pcall(function() Tween:Cancel() end)
        if Config.CurrentTween == Tween then Config.CurrentTween = nil end
        return false
    end
    if Config.CurrentTween == Tween then Config.CurrentTween = nil end
    return true
end

local function FindEggStealPrompt()
    local Root = GetRoot()
    if not Root then return nil end
    local BestPrompt, BestDistance = nil, math.huge

    for _, Object in ipairs(Workspace:GetDescendants()) do
        if not Config.Enabled then return nil end
        if Object:IsA("ProximityPrompt") then
            local Action = string.lower(tostring(Object.ActionText or ""))
            local ObjectText = string.lower(tostring(Object.ObjectText or ""))
            local IsTarget = Action:find("steal", 1, true) or Action:find("egg", 1, true)
                or ObjectText:find("egg", 1, true) or ObjectText:find("steal", 1, true)
            if IsTarget then
                local Parent = Object.Parent
                local Part
                if Parent and Parent:IsA("BasePart") then
                    Part = Parent
                elseif Parent and Parent:IsA("Model") then
                    Part = Parent:FindFirstChildWhichIsA("BasePart", true)
                end
                if Part then
                    local Distance = (Root.Position - Part.Position).Magnitude
                    if Distance <= 30 and Distance < BestDistance then
                        BestDistance, BestPrompt = Distance, Object
                    end
                end
            end
        end
    end
    return BestPrompt
end

local function GetPromptPosition(Prompt)
    if not Prompt or not Prompt.Parent then return nil end
    local Parent = Prompt.Parent
    if Parent:IsA("BasePart") then return Parent.Position end
    if Parent:IsA("Model") then
        local Part = Parent:FindFirstChildWhichIsA("BasePart", true)
        return Part and Part.Position
    end
end

local function StealEgg()
    if not Config.Enabled then return false end
    local Prompt = FindEggStealPrompt()
    if not Prompt then return false end
    local Position = GetPromptPosition(Prompt)
    if Position then
        local Root = GetRoot()
        if not Root then return false end
        if (Root.Position - Position).Magnitude > 8 and not TweenTo(Position) then return false end
    end
    if not Config.Enabled then return false end

    if typeof(fireproximityprompt) ~= "function" then return false end
    pcall(function() fireproximityprompt(Prompt, 0) end)

    local StartTime = tick()
    while Config.Enabled and Prompt and Prompt.Parent and Prompt.Enabled ~= false and tick() - StartTime < 1.2 do
        task.wait(0.05)
    end
    return Config.Enabled
end

