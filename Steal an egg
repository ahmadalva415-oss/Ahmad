--========================================================--
-- TWEEN ENGINE
--========================================================--

local function TweenTo(Position)
    if not Config.Enabled then return false end
    
    local Root = GetRoot()
    if not Root then return false end
    
    local Distance = (Root.Position - Position).Magnitude
    if Distance <= 2 then return true end
    
    local Duration = math.max(Distance / math.max(Config.TweenSpeed, 1), 0.05)
    
    local Tween = TweenService:Create(Root,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
        {CFrame = CFrame.new(Position)}
    )
    
    Config.CurrentTween = Tween
    local Finished = false
    
    local Connection = Tween.Completed:Connect(function()
        Finished = true
        if Connection then Connection:Disconnect() end
    end)
    
    Tween:Play()
    
    while Config.Enabled and not Finished do
        task.wait()
    end
    
    if Connection then Connection:Disconnect() end
    
    if not Config.Enabled then
        pcall(function() Tween:Cancel() end)
        if Config.CurrentTween == Tween then Config.CurrentTween = nil end
        return false
    end
    
    if Config.CurrentTween == Tween then Config.CurrentTween = nil end
    return true
end

--========================================================--
-- EGG STEAL SYSTEM
--========================================================--

local function FindEggStealPrompt()
    local Root = GetRoot()
    if not Root then return nil end
    
    local BestPrompt = nil
    local BestDistance = math.huge
    
    for _, Object in ipairs(workspace:GetDescendants()) do
        if not Config.Enabled then return nil end
        
        if Object:IsA("ProximityPrompt") then
            local Action = string.lower(tostring(Object.ActionText or ""))
            local ObjectText = string.lower(tostring(Object.ObjectText or ""))
            
            local IsSteal = string.find(Action, "steal", 1, true)
            local IsEgg = string.find(Action, "egg", 1, true)
            local IsEggObject = string.find(ObjectText, "egg", 1, true)
            local IsStealObject = string.find(ObjectText, "steal", 1, true)
            
            if IsSteal or IsEgg or IsEggObject or IsStealObject then
                local Parent = Object.Parent
                local Position = nil
                
                if Parent then
                    if Parent:IsA("BasePart") then
                        Position = Parent.Position
                    elseif Parent:IsA("Model") then
                        local Part = Parent:FindFirstChildWhichIsA("BasePart", true)
                        if Part then Position = Part.Position end
                    end
                end
                
                if Position then
                    local Distance = (Root.Position - Position).Magnitude
                    if Distance <= 30 and Distance < BestDistance then
                        BestDistance = Distance
                        BestPrompt = Object
                    end
                end
            end
        end
    end
    
    return BestPrompt
end

local function GetPromptPosition(Prompt)
    if not Prompt then return nil end
    local Parent = Prompt.Parent
    if not Parent then return nil end
    
    if Parent:IsA("BasePart") then
        return Parent.Position
    elseif Parent:IsA("Model") then
        local Part = Parent:FindFirstChildWhichIsA("BasePart", true)
        if Part then return Part.Position end
    end
    return nil
end

local function StealEgg()
    if not Config.Enabled then return false end
    
    local Prompt = FindEggStealPrompt()
    if not Prompt then return false end
    
    local Position = GetPromptPosition(Prompt)
    if Position then
        local Root = GetRoot()
        if not Root then return false end
        
        local Distance = (Root.Position - Position).Magnitude
        if Distance > 8 then
            if not TweenTo(Position) then return false end
        end
    end
    
    if not Config.Enabled then return false end
    
    if typeof(fireproximityprompt) == "function" then
        pcall(function()
            fireproximityprompt(Prompt, 0)
        end)
    else
        warn("[NAZK] fireproximityprompt unavailable")
        return false
    end
    
    local StartTime = tick()
    while Config.Enabled do
        if not Prompt or not Prompt.Parent then break end
        if Prompt.Enabled == false then break end
        if tick() - StartTime >= 1.2 then break end
        task.wait(0.05)
    end
    
    return Config.Enabled
end

