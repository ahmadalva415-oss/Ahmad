-- Original buttons
Tabs.Server:AddButton({
    Title = "Hop Low Players Server",
    Description = "Join the available server with the fewest players",
    Callback = function()
        SetServerStatus("Fetching servers...")
        task.spawn(function()
            local Result = GetServers()
            if not Result or not Result.data then SetServerStatus("Failed to fetch servers"); return end
            local BestServer, LowestPlayers = nil, math.huge
            for _, Server in ipairs(Result.data) do
                if Server.id ~= JobId and Server.playing < Server.maxPlayers and Server.playing < LowestPlayers then
                    LowestPlayers, BestServer = Server.playing, Server
                end
            end
            if BestServer then
                SetServerStatus("Joining server with " .. LowestPlayers .. " players...")
                task.wait(0.5)
                TeleportService:TeleportToPlaceInstance(PlaceId, BestServer.id, Player)
            else SetServerStatus("No low player server found") end
        end)
    end
})

Tabs.Server:AddButton({
    Title = "Hop Random Server",
    Description = "Join a random available server",
    Callback = function()
        SetServerStatus("Finding random server...")
        task.spawn(function()
            local Result = GetServers()
            if not Result or not Result.data then SetServerStatus("Failed to fetch servers"); return end
            local ValidServers = {}
            for _, Server in ipairs(Result.data) do
                if Server.id ~= JobId and Server.playing < Server.maxPlayers then table.insert(ValidServers, Server) end
            end
            if #ValidServers > 0 then
                local Server = ValidServers[math.random(1, #ValidServers)]
                SetServerStatus("Joining random server...")
                task.wait(0.5)
                TeleportService:TeleportToPlaceInstance(PlaceId, Server.id, Player)
            else SetServerStatus("No valid servers found") end
        end)
    end
})

