-- Join specific server by index
Tabs.Server:AddInput("JoinServerIndex", {
    Title = "Join Server by Index",
    Description = "Enter server number from the list",
    Default = "",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local Index = tonumber(Value)
        if Index and ServerData.FilteredServers[Index] then
            local Server = ServerData.FilteredServers[Index]
            Config.SelectedServerToJoin = Server.id
            SetServerStatus("Selected server " .. Index .. " (" .. Server.playing .. " players)")
        else
            SetServerStatus("Invalid server index")
        end
    end
})

