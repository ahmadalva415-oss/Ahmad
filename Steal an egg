local AutoRejoinConnection
local function SetupAutoRejoin()
    if AutoRejoinConnection then AutoRejoinConnection:Disconnect(); AutoRejoinConnection = nil end
    if not Config.AutoRejoin then return end
    local PromptGui = CoreGui:FindFirstChild("RobloxPromptGui")
    local ErrorPrompt = PromptGui and PromptGui:FindFirstChild("promptOverlay")
    if ErrorPrompt then
        AutoRejoinConnection = ErrorPrompt:GetPropertyChangedSignal("Visible"):Connect(function()
            if ErrorPrompt.Visible and Config.AutoRejoin then
                task.wait(2)
                TeleportService:Teleport(PlaceId, Player)
            end
        end)
    end
end

task.spawn(function()
    while task.wait(1) do
        if Config.AutoRejoin and not AutoRejoinConnection then SetupAutoRejoin()
        elseif not Config.AutoRejoin and AutoRejoinConnection then AutoRejoinConnection:Disconnect(); AutoRejoinConnection = nil end
    end
end)

