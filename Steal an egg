--========================================================--
-- STOP / START ROUTE
--========================================================--

local function StopRoute()
    Config.Enabled = false
    StopCurrentTween()
    StartButton.Text = "START AUTO FARM"
    StartButton.BackgroundColor3 = Theme.Success
    StatusLabel.Text = "Status: OFF"
    StatusDot.BackgroundColor3 = Theme.Danger
    TweenService:Create(StatusDot, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Danger}):Play()
end

local function StartRoute()
    if Config.Enabled then return end
    Config.Enabled = true
    
    StartButton.Text = "STOP AUTO FARM"
    StartButton.BackgroundColor3 = Theme.Danger
    StatusLabel.Text = "Status: Initializing..."
    StatusDot.BackgroundColor3 = Theme.Warning
    
    task.spawn(function()
        while Config.Enabled do
            StatusLabel.Text = "Status: Going to Required Position"
            StatusDot.BackgroundColor3 = Theme.Warning
            
            if not TweenTo(FirstPosition) then break end
            
            local RegionPosition = Regions[Config.SelectedRegion]
            if RegionPosition then
                StatusLabel.Text = "Status: Going to " .. Config.SelectedRegion
                if not TweenTo(RegionPosition) then break end
            end
            
            if not Config.Enabled then break end
            
            StatusLabel.Text = "Status: Searching for Egg"
            StatusDot.BackgroundColor3 = Theme.Primary
            
            local Stolen = StealEgg()
            if not Stolen then
                task.wait(0.1)
                if not Config.Enabled then break end
                continue
            end
            
            if not Config.Enabled then break end
            
            StatusLabel.Text = "Status: Returning"
            if not TweenTo(FirstPosition) then break end
            
            task.wait(0.1)
        end
        
        if not Config.Enabled then
            StopRoute()
        end
    end)
end

StartButton.MouseButton1Click:Connect(function()
    if Config.Enabled then
        StopRoute()
    else
        StartRoute()
    end
end)

