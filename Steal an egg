    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "HumanoidRootPart"
    )
end

--========================================================--
-- STOP TWEEN
--========================================================--

local function StopCurrentTween()

    if CurrentTween then

        pcall(function()
            CurrentTween:Cancel()
        end)

        CurrentTween = nil
    end
end

--========================================================--
-- TWEEN
--========================================================--

local function TweenTo(Position)

    if not Enabled then
        return false
    end

    local Root = GetRoot()

    if not Root then
        return false
    end

    local Distance =
        (Root.Position - Position).Magnitude

    if Distance <= 2 then
        return true
    end

    local Duration =
        math.max(
            Distance / math.max(TweenSpeed, 1),
            0.05
        )

    local Tween =
        TweenService:Create(
            Root,

            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.InOut
            ),

            {
                CFrame =
                    CFrame.new(Position)
            }
        )

    CurrentTween = Tween

    local Finished = false

    local Connection

    Connection =
        Tween.Completed:Connect(
            function()

                Finished = true

                if Connection then
                    Connection:Disconnect()
                end
            end
        )

    Tween:Play()

    while Enabled and not Finished do
        task.wait()
    end

    if Connection then
        Connection:Disconnect()
    end

    if not Enabled then

        pcall(function()
            Tween:Cancel()
        end)

        if CurrentTween == Tween then
            CurrentTween = nil
        end

        return false
    end

    if CurrentTween == Tween then
        CurrentTween = nil
    end

    return true
end

--========================================================--
-- FIND STEAL PROMPT
--========================================================--

local function FindEggStealPrompt()

    local Root = GetRoot()

    if not Root then
        return nil
    end

    local BestPrompt = nil
    local BestDistance = math.huge

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if not Enabled then
            return nil
        end

        if Object:IsA("ProximityPrompt") then

            local Action =
                string.lower(
                    tostring(
                        Object.ActionText or ""
                    )
                )

            local ObjectText =
                string.lower(
                    tostring(
                        Object.ObjectText or ""
                    )
                )

            local IsSteal =
                string.find(
                    Action,
                    "steal",
                    1,
                    true
                )

            local IsEgg =
                string.find(
                    Action,
                    "egg",
                    1,
                    true
                )

            local IsEggObject =
                string.find(
                    ObjectText,
                    "egg",
                    1,
                    true
                )

            local IsStealObject =
                string.find(
                    ObjectText,
                    "steal",
                    1,
                    true
                )

            if IsSteal
            or IsEgg
            or IsEggObject
            or IsStealObject then

                local Parent =
                    Object.Parent

                local Position = nil

                if Parent then

                    if Parent:IsA("BasePart") then

                        Position =
                            Parent.Position

                    elseif Parent:IsA("Model") then

                        local Part =
                            Parent:FindFirstChildWhichIsA(
                                "BasePart",
                                true
                            )

                        if Part then
                            Position =
                                Part.Position
                        end
                    end
                end

                if Position then

                    local Distance =
                        (
                            Root.Position -
                            Position
                        ).Magnitude

                    if Distance <= 30
                    and Distance < BestDistance then

                        BestDistance =
                            Distance

                        BestPrompt =
                            Object
                    end
                end
            end
        end
    end

    return BestPrompt
end

--========================================================--
-- GET PROMPT POSITION
--========================================================--

local function GetPromptPosition(Prompt)

    if not Prompt then
        return nil
    end

    local Parent =
        Prompt.Parent

    if not Parent then
        return nil
    end

    if Parent:IsA("BasePart") then

        return Parent.Position
    end

    if Parent:IsA("Model") then

        local Part =
            Parent:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Part then
            return Part.Position
        end
    end

    return nil
end

--========================================================--
-- STEAL EGG
--========================================================--

local function StealEgg()

    if not Enabled then
        return false
    end

    local Prompt =
        FindEggStealPrompt()

    if not Prompt then
        return false
    end

    local Position =
        GetPromptPosition(Prompt)

    if Position then

        local Root =
            GetRoot()

        if not Root then
            return false
        end

        local Distance =
            (
                Root.Position -
                Position
            ).Magnitude

        if Distance > 8 then

            if not TweenTo(Position) then
                return false
            end
        end
    end

    if not Enabled then
        return false
    end

    if typeof(
        fireproximityprompt
    ) == "function" then

        pcall(function()

            fireproximityprompt(
                Prompt,
                0
            )

        end)

    else

        warn(
            "[NAZK] fireproximityprompt is unavailable."
        )

        return false
    end

    local StartTime =
        tick()

    while Enabled do

        if not Prompt
        or not Prompt.Parent then

            break
        end

        if Prompt.Enabled == false then
            break
        end

        if tick() - StartTime >= 1.2 then
            break
        end

        task.wait(0.05)
    end

    return Enabled
end

