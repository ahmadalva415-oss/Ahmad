local function SaveSettings()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        writefile(SettingsFile, HttpService:JSONEncode({
            TweenSpeed = Config.TweenSpeed,
            SelectedRegion = Config.SelectedRegion,
            AntiLag = Config.AntiLag,
            AutoRejoin = Config.AutoRejoin,
            HideName = Config.HideName,
            DashPower = Config.DashPower,
            DashSpeed = Config.DashSpeed,
            DashDuration = Config.DashDuration,
            DashRagdoll = Config.DashRagdoll,
            ServerPlayerFilter = Config.ServerPlayerFilter,
            ServerSortOrder = Config.ServerSortOrder,
            ServerAutoRefresh = Config.ServerAutoRefresh
        }))
    end)
end

local function LoadSettings()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    if not isfile(SettingsFile) then return end
    pcall(function()
        local Saved = HttpService:JSONDecode(readfile(SettingsFile))
        if type(Saved) ~= "table" then return end
        if type(Saved.TweenSpeed) == "number" then Config.TweenSpeed = math.clamp(Saved.TweenSpeed, 50, 500) end
        if type(Saved.SelectedRegion) == "string" and (Regions[Saved.SelectedRegion] ~= nil or Saved.SelectedRegion == "None") then Config.SelectedRegion = Saved.SelectedRegion end
        if type(Saved.AntiLag) == "boolean" then Config.AntiLag = Saved.AntiLag end
        if type(Saved.AutoRejoin) == "boolean" then Config.AutoRejoin = Saved.AutoRejoin end
        if type(Saved.HideName) == "boolean" then Config.HideName = Saved.HideName end
        if type(Saved.DashPower) == "number" then Config.DashPower = math.clamp(Saved.DashPower, 35, 160) end
        if type(Saved.DashSpeed) == "number" then Config.DashSpeed = math.clamp(Saved.DashSpeed, 1, 5) end
        if type(Saved.DashDuration) == "number" then Config.DashDuration = math.clamp(Saved.DashDuration, 0.05, 1) end
        if type(Saved.DashRagdoll) == "boolean" then Config.DashRagdoll = Saved.DashRagdoll end
        -- Server settings
        if type(Saved.ServerPlayerFilter) == "string" then Config.ServerPlayerFilter = Saved.ServerPlayerFilter end
        if type(Saved.ServerSortOrder) == "string" then Config.ServerSortOrder = Saved.ServerSortOrder end
        if type(Saved.ServerAutoRefresh) == "boolean" then Config.ServerAutoRefresh = Saved.ServerAutoRefresh end
    end)
end

