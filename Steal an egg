local NDragging = false
local NDragStart
local NStartPosition

NButton.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
        NDragging = true
        NDragStart = Input.Position
        NStartPosition = NButton.Position
        Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                NDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if not NDragging then return end
    if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
        local Delta = Input.Position - NDragStart
        NButton.Position = UDim2.new(
            NStartPosition.X.Scale,
            NStartPosition.X.Offset + Delta.X,
            NStartPosition.Y.Scale,
            NStartPosition.Y.Offset + Delta.Y
        )
    end
end)

