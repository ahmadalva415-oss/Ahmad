--========================================================--
-- AUTO FARM LOOP
--========================================================--

local function StartRoute()

    if Enabled then
        return
    end

    Enabled =
        true

    StartButton.Text =
        "STOP AUTO FARM"

    StartButton.BackgroundColor3 =
        Color3.fromRGB(
            185,
            65,
            65
        )

    task.spawn(function()

        while Enabled do

            StatusLabel.Text =
                "Status: Going to Required Position"

            if not TweenTo(
                FirstPosition
            ) then

                break
            end

            local RegionPosition =
                Regions[
                    SelectedRegion
                ]

            if RegionPosition then

                StatusLabel.Text =
                    "Status: Going to " ..
                    SelectedRegion

                if not TweenTo(
                    RegionPosition
                ) then

                    break
                end
            end

            if not Enabled then
                break
            end

            StatusLabel.Text =
                "Status: Searching for Egg"

            local Stolen =
                StealEgg()

            if not Stolen then

                task.wait(0.1)

                if not Enabled then
                    break
                end

                continue
            end

            if not Enabled then
                break
            end

            StatusLabel.Text =
                "Status: Returning"

            if not TweenTo(
                FirstPosition
            ) then

                break
            end

            task.wait(0.1)
        end

        if not Enabled then
            StopRoute()
        end
    end)
end

StartButton.MouseButton1Click:Connect(
    function()

        if Enabled then
            StopRoute()
        else
            StartRoute()
        end
    end
)

