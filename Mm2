local function StartAntiFling()
    if AntiFlingConnection then AntiFlingConnection:Disconnect() end
    AntiFlingEnabled = true

    AntiFlingConnection = RunService.Heartbeat:Connect(function()
        if not AntiFlingEnabled then return end
        local Char = LocalPlayer.Character
        if not Char then return end
        local HRP = Char:FindFirstChild("HumanoidRootPart")
        if not HRP then return end

        if HRP.Position.Y < -50 then
            if LastGoodCFrame then
                HRP.CFrame = LastGoodCFrame + Vector3.new(0, 10, 0)
            else
                HRP.CFrame = CFrame.new(0, 50, 0)
            end
            return
        end

        if HRP.Position.Y > 0 then
            LastGoodCFrame = HRP.CFrame
        end

        local Velocity = HRP.AssemblyLinearVelocity
        if Velocity.Magnitude > 200 then
            HRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            if LastGoodCFrame then
                HRP.CFrame = LastGoodCFrame
            end
        end

        if HRP.AssemblyAngularVelocity.Magnitude > 100 then
            HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function(Char)
        task.wait(1)
        local HRP = Char:FindFirstChild("HumanoidRootPart")
        if HRP then
            LastGoodCFrame = HRP.CFrame
        end
    end)
end

