        if not AntiFlingEnabled then return end
        local c = LocalPlayer.Character; if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        if hrp.Position.Y < -50 then
            if LastGoodCFrame then hrp.CFrame = LastGoodCFrame + Vector3.new(0, 10, 0)
            else hrp.CFrame = CFrame.new(0, 50, 0) end
            return
        end
        if hrp.Position.Y > 0 then LastGoodCFrame = hrp.CFrame end
        if hrp.AssemblyLinearVelocity.Magnitude > 200 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if LastGoodCFrame then hrp.CFrame = LastGoodCFrame end
        end
        if hrp.AssemblyAngularVelocity.Magnitude > 100 then
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    LocalPlayer.CharacterAdded:Connect(function(c)
        task.wait(1)
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then LastGoodCFrame = hrp.CFrame end
    end)
