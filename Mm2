local function MakeDraggable(Button, ClickCallback)
    local IsDragging = false
    local ThisDragInput = nil
    local ThisDragStart = nil
    local ThisStartPos = nil
    local ThisMoved = false

    Button.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = true
            ThisMoved = false
            ThisDragStart = Input.Position
            ThisStartPos = Button.Position
        end
    end)

    Button.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement
            or Input.UserInputType == Enum.UserInputType.Touch then
            ThisDragInput = Input
        end
    end)

    Button.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = false
            if not ThisMoved then ClickCallback() end
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if Input == ThisDragInput and IsDragging then
            local Delta = Input.Position - ThisDragStart
            if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then
                ThisMoved = true
            end
            Button.Position = UDim2.new(
                ThisStartPos.X.Scale,
                ThisStartPos.X.Offset + Delta.X,
                ThisStartPos.Y.Scale,
                ThisStartPos.Y.Offset + Delta.Y
            )
        end
    end)
end

local function OnShotPress()
    PlaySound("Shot", 0.4)
    ShotButton.Text = "..."
    local Target = FindKnifeHolder()
    if not Target then
        ShotButton.Text = "Shot"
        return
    end
    local Success = ShootAt(Target)
    if Success then
        ShotButton.Text = "OK"
    else
        ShotButton.Text = "Shot"
    end
    task.wait(0.5)
    ShotButton.Text = "Shot"
end

MakeDraggable(NButton, function() SetMenuVisible(not MenuVisible) end)
MakeDraggable(FloatingDash, DoDash)
MakeDraggable(ShotButton, OnShotPress)

--========================================================--
-- KEYBIND LISTENER
--========================================================--
UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end
    if Input.KeyCode == Keybinds.Shot then
        OnShotPress()
    elseif Input.KeyCode == Keybinds.Dash then
        DoDash()
    elseif Input.KeyCode == Keybinds.ToggleESP then
        ToggleESP()
    elseif Input.KeyCode == Keybinds.ToggleAutoShoot then
        if AutoShootEnabled then
            StopAutoShoot()
        else
            StartAutoShoot()
        end
    elseif Input.KeyCode == Keybinds.HideMenu then
        SetMenuVisible(not MenuVisible)
    end
end)

