-- MARDER: HITBOX EXPANDER
--========================================================--
local function IsPlayerAllowed(Player)
    if not Player or Player == LocalPlayer then return false end
    if next(Whitelist) ~= nil then
        return Whitelist[Player.Name] == true
    end
    if Blacklist[Player.Name] then return false end
    return true
end

local function ApplyHitbox(Player)
    if not Player.Character then return end
    local HRP = Player.Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    if not HitboxOriginals[Player] then
        HitboxOriginals[Player] = {
            Size = HRP.Size,
            Transparency = HRP.Transparency,
            CanCollide = HRP.CanCollide,
            Massless = HRP.Massless,
        }
    end

    HRP.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    HRP.Transparency = 0.6
    HRP.CanCollide = false
    HRP.Massless = true
end

local function RestoreHitbox(Player)
    if HitboxOriginals[Player] then
        local Original = HitboxOriginals[Player]
        if Player.Character then
            local HRP = Player.Character:FindFirstChild("HumanoidRootPart")
            if HRP then
                HRP.Size = Original.Size
                HRP.Transparency = Original.Transparency
                HRP.CanCollide = Original.CanCollide
                HRP.Massless = Original.Massless
            end
        end
        HitboxOriginals[Player] = nil
    end
end

local function StartHitbox()
    if HitboxTask then
        pcall(function() task.cancel(HitboxTask) end)
    end
    HitboxEnabled = true
    HitboxTask = task.spawn(function()
        while HitboxEnabled do
            for _, Player in ipairs(Players:GetPlayers()) do
                if IsPlayerAllowed(Player) and Player.Character then
                    ApplyHitbox(Player)
                end
            end
            task.wait(0.2)
        end
        for Player, _ in pairs(HitboxOriginals) do
            RestoreHitbox(Player)
        end
    end)
