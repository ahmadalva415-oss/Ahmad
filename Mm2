local function PlayerHasKnife(Player)
    if not Player then return false end
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack and Backpack:FindFirstChild("Knife") then return true end
    if Player.Character and Player.Character:FindFirstChild("Knife") then return true end
    return false
end

local function PlayerHasGun(Player)
    if not Player then return false end
    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack and Backpack:FindFirstChild("Gun") then return true end
    if Player.Character and Player.Character:FindFirstChild("Gun") then return true end
    return false
end

local function GetESPColor(Player)
    if PlayerHasKnife(Player) then
        return Color3.fromRGB(255, 0, 0)
    elseif PlayerHasGun(Player) then
        return Color3.fromRGB(0, 100, 255)
    else
        return Color3.fromRGB(0, 255, 0)
    end
end

local function UpdateFill(Player, Color)
    if not Player or Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character then return end

    if ESPHighlights[Player] then
        pcall(function() ESPHighlights[Player]:Destroy() end)
        ESPHighlights[Player] = nil
    end

    local H = Instance.new("Highlight")
    H.Name = "NAZK_ESP_Fill"
    H.Adornee = Character
    H.FillColor = Color
    H.FillTransparency = 0.55
    H.OutlineColor = Color
    H.OutlineTransparency = 0
    H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    H.Parent = Character
    ESPHighlights[Player] = H
end

local function UpdateBox(Player, Color, Camera)
    if not DrawingSupported then return end
    if not Player or Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    local Box = ESPBoxes[Player]
    if not Box then
        Box = Drawing.new("Square")
        Box.Thickness = 1
        Box.Filled = false
        Box.Transparency = 1
        Box.Visible = false
        ESPBoxes[Player] = Box
    end

    local NameText = ESPNameTexts[Player]
    if not NameText then
        NameText = Drawing.new("Text")
        NameText.Size = 16
        NameText.Center = true
        NameText.Outline = true
        NameText.OutlineColor = Color3.fromRGB(0, 0, 0)
        NameText.Visible = false
        ESPNameTexts[Player] = NameText
    end

    local DistText = ESPDistanceTexts[Player]
    if not DistText then
        DistText = Drawing.new("Text")
        DistText.Size = 14
        DistText.Center = true
        DistText.Outline = true
        DistText.OutlineColor = Color3.fromRGB(0, 0, 0)
        DistText.Visible = false
        ESPDistanceTexts[Player] = DistText
    end

    local Vector, OnScreen = Camera:WorldToViewportPoint(HRP.Position)
    if OnScreen then
        local Distance = (Camera.CFrame.Position - HRP.Position).Magnitude
        local Size = 500 / Vector.Z
        local Width = Size * 0.6
        local Height = Size * 0.9

        Box.Size = Vector2.new(Width, Height)
        Box.Position = Vector2.new(Vector.X - Width / 2, Vector.Y - Height / 2)
        Box.Color = Color
        Box.Visible = true

        NameText.Text = Player.Name
        NameText.Position = Vector2.new(Vector.X, Vector.Y - Height / 2 - 20)
        NameText.Color = Color
        NameText.Visible = true

        DistText.Text = "[" .. math.floor(Distance) .. "m]"
        DistText.Position = Vector2.new(Vector.X, Vector.Y + Height / 2 + 2)
        DistText.Color = Color
        DistText.Visible = true
    else
        Box.Visible = false
        NameText.Visible = false
        DistText.Visible = false
    end
end

local function UpdateLine(Player, Color, Camera)
    if not DrawingSupported then return end
    if not Player or Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    local Line = ESPLines[Player]
    if not Line then
        Line = Drawing.new("Line")
        Line.Thickness = 2
        Line.Transparency = 1
        Line.Visible = false
        ESPLines[Player] = Line
    end

    local Vector, OnScreen = Camera:WorldToViewportPoint(HRP.Position)
    if OnScreen then
        local Viewport = Camera.ViewportSize
        Line.From = Vector2.new(Viewport.X / 2, Viewport.Y)
        Line.To = Vector2.new(Vector.X, Vector.Y)
        Line.Color = Color
        Line.Visible = true
    else
        Line.Visible = false
    end
end

local function ClearESPForPlayer(Player)
    if ESPHighlights[Player] then
        pcall(function() ESPHighlights[Player]:Destroy() end)
        ESPHighlights[Player] = nil
    end
    if ESPBoxes[Player] then
        pcall(function() ESPBoxes[Player]:Remove() end)
        ESPBoxes[Player] = nil
    end
    if ESPLines[Player] then
        pcall(function() ESPLines[Player]:Remove() end)
        ESPLines[Player] = nil
    end
    if ESPNameTexts[Player] then
        pcall(function() ESPNameTexts[Player]:Remove() end)
        ESPNameTexts[Player] = nil
    end
    if ESPDistanceTexts[Player] then
        pcall(function() ESPDistanceTexts[Player]:Remove() end)
        ESPDistanceTexts[Player] = nil
    end
end

local function StartESP()
    if not ESPRenderConnection then
        ESPRenderConnection = RunService.RenderStepped:Connect(function()
            local Camera = Workspace.CurrentCamera
            if not Camera then return end
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player ~= LocalPlayer then
                    local Color = GetESPColor(Player)
                    if ESPBoxEnabled then
                        UpdateBox(Player, Color, Camera)
                    else
                        if ESPBoxes[Player] then ESPBoxes[Player].Visible = false end
                        if ESPNameTexts[Player] then ESPNameTexts[Player].Visible = false end
                        if ESPDistanceTexts[Player] then ESPDistanceTexts[Player].Visible = false end
                    end
                    if ESPLineEnabled then
                        UpdateLine(Player, Color, Camera)
                    elseif ESPLines[Player] then
                        ESPLines[Player].Visible = false
                    end
                end
            end
        end)
    end

    if not ESPFillTask and ESPFillEnabled then
        ESPFillTask = task.spawn(function()
            while ESPFillEnabled do
                for _, Player in ipairs(Players:GetPlayers()) do
                    if Player ~= LocalPlayer then
                        UpdateFill(Player, GetESPColor(Player))
                    end
                end
                task.wait(1)
            end
            for Player, _ in pairs(ESPHighlights) do
                pcall(function() ESPHighlights[Player]:Destroy() end)
                ESPHighlights[Player] = nil
            end
            ESPFillTask = nil
        end)
    end
end

local function StopESP()
    if ESPRenderConnection then
        ESPRenderConnection:Disconnect()
        ESPRenderConnection = nil
    end
    if ESPFillTask then
        pcall(function() task.cancel(ESPFillTask) end)
        ESPFillTask = nil
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        ClearESPForPlayer(Player)
    end
    ESPHighlights = {}
    ESPBoxes = {}
    ESPLines = {}
    ESPNameTexts = {}
    ESPDistanceTexts = {}
end

local function ToggleESP()
    PlaySound("Toggle", 0.3)
    if ESPFillEnabled or ESPBoxEnabled or ESPLineEnabled then
        ESPFillEnabled = false
        ESPBoxEnabled = false
        ESPLineEnabled = false
        StopESP()
    else
        ESPFillEnabled = true
        ESPBoxEnabled = true
        ESPLineEnabled = true
        StartESP()
    end
end

Players.PlayerRemoving:Connect(function(Player)
    ClearESPForPlayer(Player)
end)

