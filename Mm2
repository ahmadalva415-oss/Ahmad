--========================================================--
-- DASH
--========================================================--
local function DoDash()
    if DashOnCooldown then return end
    local Root = GetRoot()
    if not Root then return end
    DashOnCooldown = true
    PlaySound("Toggle", 0.3)

    local Camera = Workspace.CurrentCamera
    local Direction = Camera and Camera.CFrame.LookVector or Root.CFrame.LookVector
    Direction = Vector3.new(Direction.X, 0, Direction.Z)
    if Direction.Magnitude < 0.01 then
        Direction = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    end
    Direction = Direction.Unit

    local Velocity = Instance.new("BodyVelocity")
    Velocity.Name = "NAZK_DashVelocity"
    Velocity.MaxForce = Vector3.new(1000000, 0, 1000000)
    Velocity.P = 50000
    Velocity.Velocity = Direction * DashPower
    Velocity.Parent = Root

    task.delay(DashDuration, function()
        if Velocity and Velocity.Parent then Velocity:Destroy() end
    end)
    task.delay(DashCooldown, function()
        DashOnCooldown = false
    end)
end

