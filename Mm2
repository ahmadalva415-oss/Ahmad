local function SaveConfig()
    if not AutoSaveEnabled then return end
    if type(writefile) ~= "function" then return end

    local Data = {
        ESPFill = ESPFillEnabled,
        ESPBox = ESPBoxEnabled,
        ESPLine = ESPLineEnabled,
        AutoShoot = AutoShootEnabled,
        AutoShootDelay = AutoShootDelay * 1000,
        Hitbox = HitboxEnabled,
