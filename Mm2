--========================================================--
local function HopToLowestServer(MaxPlayers)
    MaxPlayers = tonumber(MaxPlayers) or 3
    local PlaceId = game.PlaceId
    local Servers = {}

    local Success = pcall(function()
        local Cursor = ""
        repeat
            local URL = "https://games.roblox.com/v1/games/" .. PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            if Cursor ~= "" then
                URL = URL .. "&cursor=" .. Cursor
            end

            local Response = game:HttpGet(URL)
            local Data = HttpService:JSONDecode(Response)

            for _, Server in ipairs(Data.data) do
                if Server.id ~= game.JobId
                    and Server.playing < Server.maxPlayers
                    and Server.playing <= MaxPlayers then
                    table.insert(Servers, Server)
                end
            end

            Cursor = Data.nextPageCursor or ""
        until Cursor == "" or #Servers >= 20
    end)

    if not Success or #Servers == 0 then
        Fluent:Notify({
            Title = "NAZK HUB",
            Content = "ما فيه سيرفر فيه " .. MaxPlayers .. " لاعب أو أقل",
            Duration = 4,
        })
        return
    end

    table.sort(Servers, function(A, B)
        return A.playing < B.playing
    end)

    local Target = Servers[1]

    Fluent:Notify({
        Title = "NAZK HUB - Hop",
        Content = "جاري الانتقال لسيرفر فيه " .. Target.playing .. " لاعب",
        Duration = 3,
    })

    PlaySound("Hop", 0.5)
    TeleportService:TeleportToPlaceInstance(PlaceId, Target.id, LocalPlayer)
end

