--========================================================--
UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end

    if Input.KeyCode == Keybinds.Shot then
        OnShotPress()
    elseif Input.KeyCode == Keybinds.Dash then
        DoDash()
    elseif Input.KeyCode == Keybinds.ToggleESP then
        ToggleESP()
    elseif Input.KeyCode == Keybinds.ToggleAutoShoot then
        if AutoShootEnabled then StopAutoShoot()
        else StartAutoShoot() end
    elseif Input.KeyCode == Keybinds.HideMenu then
        SetMenuVisible(not MenuVisible)
    end
end)

