--========================================================--
-- KEYBIND HANDLERS
--========================================================--
local ShotKeybind = Enum.KeyCode.F
local ESPKeybind = Enum.KeyCode.E
local AutoShootKeybind = Enum.KeyCode.R
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == ShotKeybind then OnShotPress()
    elseif input.KeyCode == DashKey then DoDash()
    elseif input.KeyCode == ESPKeybind then
        if ESPFillEnabled or ESPBoxEnabled or ESPLineEnabled then
            ESPFillEnabled, ESPBoxEnabled, ESPLineEnabled = false, false, false
            StopESP()
        else
            ESPFillEnabled, ESPBoxEnabled, ESPLineEnabled = true, true, true
            StartESP()
        end
    elseif input.KeyCode == AutoShootKeybind then
        if AutoShootEnabled then StopAutoShoot() else StartAutoShoot() end
    elseif input.KeyCode == Enum.KeyCode.H then
        if WindowRef then
            if WindowRef._Opened ~= false then pcall(function() WindowRef:Close() end) WindowRef._Opened = false
            else pcall(function() WindowRef:Open() end) WindowRef._Opened = true end
        end
    end
end)

