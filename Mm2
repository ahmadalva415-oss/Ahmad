local function HasKnife(p)
    if not p then return false end
    local bp = p:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Knife") then return true end
    if p.Character and p.Character:FindFirstChild("Knife") then return true end
    return false
end
local function HasGun(p)
    if not p then return false end
    local bp = p:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Gun") then return true end
    if p.Character and p.Character:FindFirstChild("Gun") then return true end
    return false
end
local function GetESPColor(p)
    if HasKnife(p) then return Color3.fromRGB(255,0,0)
    elseif HasGun(p) then return Color3.fromRGB(0,100,255)
    else return Color3.fromRGB(0,255,0) end
end
local function ClearESPForPlayer(p)
    if ESPHighlights[p] then pcall(function() ESPHighlights[p]:Destroy() end); ESPHighlights[p] = nil end
    if ESPBoxes[p] then pcall(function() ESPBoxes[p]:Remove() end); ESPBoxes[p] = nil end
    if ESPLines[p] then pcall(function() ESPLines[p]:Remove() end); ESPLines[p] = nil end
    if ESPNameTexts[p] then pcall(function() ESPNameTexts[p]:Remove() end); ESPNameTexts[p] = nil end
    if ESPDistanceTexts[p] then pcall(function() ESPDistanceTexts[p]:Remove() end); ESPDistanceTexts[p] = nil end
end
local function UpdateFill(p, col)
    if not p or p == LocalPlayer then return end
    local c = p.Character; if not c then return end
    if ESPHighlights[p] then pcall(function() ESPHighlights[p]:Destroy() end); ESPHighlights[p] = nil end
    local h = Instance.new("Highlight")
    h.Name = "NAZK_ESP_Fill"; h.Adornee = c
    h.FillColor = col; h.FillTransparency = 0.55
    h.OutlineColor = col; h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = c
    ESPHighlights[p] = h
end
local function UpdateBox(p, col, cam)
    if not DrawingSupported then return end
    if not p or p == LocalPlayer then return end
    local c = p.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local box = ESPBoxes[p]
    if not box then
        box = Drawing.new("Square"); box.Thickness = 1; box.Filled = false; box.Transparency = 1; box.Visible = false
        ESPBoxes[p] = box
    end
    local nameT = ESPNameTexts[p]
    if not nameT then
        nameT = Drawing.new("Text"); nameT.Size = 16; nameT.Center = true; nameT.Outline = true
        nameT.OutlineColor = Color3.fromRGB(0,0,0); nameT.Visible = false
        ESPNameTexts[p] = nameT
    end
    local distT = ESPDistanceTexts[p]
    if not distT then
        distT = Drawing.new("Text"); distT.Size = 14; distT.Center = true; distT.Outline = true
        distT.OutlineColor = Color3.fromRGB(0,0,0); distT.Visible = false
        ESPDistanceTexts[p] = distT
    end
    local vec, on = cam:WorldToViewportPoint(hrp.Position)
    if on then
        local dist = (cam.CFrame.Position - hrp.Position).Magnitude
        local size = 500 / vec.Z
        local w = size * 0.6; local h = size * 0.9
        box.Size = Vector2.new(w, h)
        box.Position = Vector2.new(vec.X - w/2, vec.Y - h/2)
        box.Color = col; box.Visible = true
        nameT.Text = p.Name; nameT.Position = Vector2.new(vec.X, vec.Y - h/2 - 20); nameT.Color = col; nameT.Visible = true
        distT.Text = "["..math.floor(dist).."m]"; distT.Position = Vector2.new(vec.X, vec.Y + h/2 + 2); distT.Color = col; distT.Visible = true
    else
        box.Visible = false; nameT.Visible = false; distT.Visible = false
    end
end
local function UpdateLine(p, col, cam)
    if not DrawingSupported then return end
    if not p or p == LocalPlayer then return end
    local c = p.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local line = ESPLines[p]
    if not line then
        line = Drawing.new("Line"); line.Thickness = 2; line.Transparency = 1; line.Visible = false
        ESPLines[p] = line
    end
    local vec, on = cam:WorldToViewportPoint(hrp.Position)
    if on then
        local vp = cam.ViewportSize
        line.From = Vector2.new(vp.X/2, vp.Y)
        line.To = Vector2.new(vec.X, vec.Y)
        line.Color = col; line.Visible = true
    else line.Visible = false end
end
local function StartESP()
    if not ESPRenderConnection then
        ESPRenderConnection = RunService.RenderStepped:Connect(function()
            local cam = Workspace.CurrentCamera; if not cam then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local col = GetESPColor(p)
                    if ESPBoxEnabled then UpdateBox(p, col, cam)
                    else
                        if ESPBoxes[p] then ESPBoxes[p].Visible = false end
                        if ESPNameTexts[p] then ESPNameTexts[p].Visible = false end
                        if ESPDistanceTexts[p] then ESPDistanceTexts[p].Visible = false end
                    end
                    if ESPLineEnabled then UpdateLine(p, col, cam)
                    elseif ESPLines[p] then ESPLines[p].Visible = false end
                end
            end
        end)
    end
    if not ESPFillTask and ESPFillEnabled then
        ESPFillTask = task.spawn(function()
            while ESPFillEnabled do
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then UpdateFill(p, GetESPColor(p)) end
                end
                task.wait(1)
            end
            for p in pairs(ESPHighlights) do pcall(function() ESPHighlights[p]:Destroy() end) end
            ESPHighlights = {}
            ESPFillTask = nil
        end)
    end
end
local function StopESP()
    if ESPRenderConnection then ESPRenderConnection:Disconnect(); ESPRenderConnection = nil end
    if ESPFillTask then pcall(function() task.cancel(ESPFillTask) end); ESPFillTask = nil end
    for _, p in ipairs(Players:GetPlayers()) do ClearESPForPlayer(p) end
    ESPHighlights, ESPBoxes, ESPLines, ESPNameTexts, ESPDistanceTexts = {}, {}, {}, {}, {}
end
Players.PlayerRemoving:Connect(ClearESPForPlayer)

