local function MakeDraggable(Button, ClickCallback)
    local IsDragging = false
    local ThisDragInput = nil
    local ThisDragStart = nil
    local ThisStartPos = nil
    local ThisMoved = false

    Button.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = true
            ThisMoved = false
            ThisDragStart = Input.Position
            ThisStartPos = Button.Position
        end
    end)

    Button.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement
            or Input.UserInputType == Enum.UserInputType.Touch then
            ThisDragInput = Input
        end
    end)

    Button.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = false
            if not ThisMoved then ClickCallback() end
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if Input == ThisDragInput and IsDragging then
            local Delta = Input.Position - ThisDragStart
            if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then
                ThisMoved = true
            end
            Button.Position = UDim2.new(
                ThisStartPos.X.Scale,
                ThisStartPos.X.Offset + Delta.X,
                ThisStartPos.Y.Scale,
                ThisStartPos.Y.Offset + Delta.Y
            )
        end
    end)
end

local function OnShotPress()
    ShotButton.Text = "..."
    local Target = FindKnifeHolder()
    if not Target then
        ShotButton.Text = "Shot"
        return
    end
    local Success, Msg = ShootAt(Target)
    if Success then
        ShotButton.Text = "OK"
    else
        ShotButton.Text = "Shot"
    end
    task.wait(0.5)
    ShotButton.Text = "Shot"
end

