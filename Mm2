local function HideAllSkies()
    for _, Child in ipairs(Lighting:GetChildren()) do
        if Child:IsA("Sky") and Child.Name ~= "NAZK_Skybox" then
            OriginalSkies[Child] = true
            Child.Parent = nil
        end
    end
end

local function RestoreOriginalSkies()
    for _, Child in ipairs(Lighting:GetChildren()) do
        if Child:IsA("Sky") and Child.Name == "NAZK_Skybox" then
            Child:Destroy()
        end
    end

    for Desc, _ in pairs(OriginalSkies) do
        pcall(function()
            if Desc and Desc.Parent == nil then
                Desc.Parent = Lighting
            end
        end)
    end
    OriginalSkies = {}
end

local function ApplySkybox(PresetName)
    if CurrentSky then
        pcall(function() CurrentSky:Destroy() end)
        CurrentSky = nil
    end

    if PresetName == "Default" then
        RestoreOriginalSkies()
        return
    end

    HideAllSkies()

    local Preset = SkyboxPresets[PresetName]
    if not Preset then return end

    local Sky = Instance.new("Sky")
    Sky.Name = "NAZK_Skybox"

    for Key, Value in pairs(Preset) do
        pcall(function()
            Sky[Key] = Value
        end)
    end

    Sky.Parent = Lighting
    CurrentSky = Sky

    -- تحديث إجباري
    local OldClock = Lighting.ClockTime
    Lighting.ClockTime = (OldClock == 14) and 14.1 or 14
    task.wait(0.05)
    Lighting.ClockTime = OldClock
end

