local function IsPlayerAllowed(p)
    if not p or p == LocalPlayer then return false end
    if next(Whitelist) ~= nil then return Whitelist[p.Name] == true end
    if Blacklist[p.Name] then return false end
    return true
end
local function ApplyHitbox(p)
    if not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    if not HitboxOriginals[p] then
        HitboxOriginals[p] = { Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide, Massless = hrp.Massless }
    end
    hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    hrp.Transparency = 0.6; hrp.CanCollide = false; hrp.Massless = true
end
local function RestoreHitbox(p)
    if HitboxOriginals[p] then
        local o = HitboxOriginals[p]
        if p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = o.Size; hrp.Transparency = o.Transparency
                hrp.CanCollide = o.CanCollide; hrp.Massless = o.Massless
            end
        end
        HitboxOriginals[p] = nil
    end
end
local function StartHitbox()
    if HitboxTask then pcall(function() task.cancel(HitboxTask) end) end
    HitboxEnabled = true
    HitboxTask = task.spawn(function()
        while HitboxEnabled do
            for _, p in ipairs(Players:GetPlayers()) do
                if IsPlayerAllowed(p) and p.Character then ApplyHitbox(p) end
            end
            task.wait(0.2)
        end
        for p in pairs(HitboxOriginals) do RestoreHitbox(p) end
    end)
end
local function StopHitbox()
    HitboxEnabled = false
    if HitboxTask then pcall(function() task.cancel(HitboxTask) end); HitboxTask = nil end
    for p in pairs(HitboxOriginals) do RestoreHitbox(p) end
    HitboxOriginals = {}
end

