-- SHERIFF (SHOT)
--========================================================--
local function FindKnifeHolder()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and HasKnife(p) and IsPlayerAllowed(p) then return p end
    end
    return nil
end
local function HasLineOfSight(t)
    if not t or not t.Character then return false end
    local myC = LocalPlayer.Character; if not myC then return false end
    local myHrp = myC:FindFirstChild("HumanoidRootPart")
    local tHrp = t.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp or not tHrp then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myC, t.Character }
    params.IgnoreWater = true
    local r = Workspace:Raycast(myHrp.Position, tHrp.Position - myHrp.Position, params)
    return r == nil
end
local function EquipGun()
    if not LocalPlayer.Character then return nil end
    local gun = LocalPlayer.Character:FindFirstChild("Gun")
    if gun then return gun end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        gun = bp:FindFirstChild("Gun")
        if gun then
            local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if h then pcall(function() h:EquipTool(gun) end) return gun end
        end
    end
    return nil
end
local function ShootAt(t)
    if not t or not t.Character then return false end
    local tHrp = t.Character:FindFirstChild("HumanoidRootPart"); if not tHrp then return false end
    local gun = EquipGun(); if not gun then return false end
    task.wait(0.1)
    local myC = Workspace:FindFirstChild(LocalPlayer.Name); if not myC then return false end
    gun = myC:FindFirstChild("Gun"); if not gun then return false end
    local rem = gun:FindFirstChild("Shoot"); if not rem then return false end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    pcall(function() rem:FireServer(myHrp.CFrame, CFrame.new(tHrp.Position)) end)
    return true
end
local function StartAutoShoot()
    if AutoShootTask then pcall(function() task.cancel(AutoShootTask) end) end
    AutoShootEnabled = true; PlaySound("Toggle", 0.3)
    AutoShootTask = task.spawn(function()
        while AutoShootEnabled do
            local t = FindKnifeHolder()
            if t and (not HasLineOfSightCheck or HasLineOfSight(t)) then ShootAt(t) end
            task.wait(AutoShootDelay)
        end
    end)
end
local function StopAutoShoot()
    AutoShootEnabled = false; PlaySound("Off", 0.3)
    if AutoShootTask then pcall(function() task.cancel(AutoShootTask) end); AutoShootTask = nil end
end
local function OnShotPress()
    PlaySound("Shot", 0.4)
    if ShotOuter then
        local inner = ShotOuter:FindFirstChildOfClass("TextButton")
        if inner then
            inner.Text = "..."
            local t = FindKnifeHolder()
            local ok = t and ShootAt(t)
            inner.Text = ok and "OK" or "Shot"
            task.wait(0.5)
            inner.Text = "Shot"
        end
    end
end

--========================================================--
-- TWEEN / FOLLOW / FLING
--========================================================--
local function CancelPlayerTween()
    if PlayerCurrentTween then pcall(function() PlayerCurrentTween:Cancel() end); PlayerCurrentTween = nil end
end
local function TweenToPlayer(t)
    local root = GetRoot(); if not root or not t then return false end
    local tC = t.Character; if not tC then return false end
    local tRoot = tC:FindFirstChild("HumanoidRootPart"); if not tRoot then return false end
    local pos = tRoot.Position + Vector3.new(0, 3, 0)
    local dist = (root.Position - pos).Magnitude
    if dist <= 3 then return true end
    local dur = math.max(dist / 35, 0.12)
    CancelPlayerTween()
    PlayerCurrentTween = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = CFrame.new(pos) })
    PlayerCurrentTween:Play()
    local fin = false
    local c = PlayerCurrentTween.Completed:Connect(function() fin = true end)
    while PlayerTweenEnabled and PlayerCurrentTween and not fin do task.wait(0.02) end
    if c then c:Disconnect() end
    if not PlayerTweenEnabled then CancelPlayerTween(); return false end
    PlayerCurrentTween = nil
    return true
end
local function StartFollow()
    if FollowConnection then FollowConnection:Disconnect() end
    FollowEnabled = true
    FollowConnection = RunService.Heartbeat:Connect(function()
        if not FollowEnabled or not SelectedPlayer then return end
        local root = GetRoot()
        local tC = SelectedPlayer.Character
        if not root or not tC then return end
        local tRoot = tC:FindFirstChild("HumanoidRootPart"); if not tRoot then return end
        if (root.Position - tRoot.Position).Magnitude > 5 then
            root.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 3, 0))
        end
    end)
end
local function StopFollow()
    FollowEnabled = false
    if FollowConnection then FollowConnection:Disconnect(); FollowConnection = nil end
end
local function DoFling(t)
    if not t or not t.Character then return end
    local root = t.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bav.P = 999999; bav.Parent = root
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(math.random(-500,500), math.random(800,1200), math.random(-500,500))
    bv.P = 999999; bv.Parent = root
    Debris:AddItem(bav, 2); Debris:AddItem(bv, 2)
end
local function StartFling()
    if FlingConnection then FlingConnection:Disconnect() end
    FlingEnabled = true
    FlingConnection = RunService.Heartbeat:Connect(function()
        if FlingEnabled and SelectedPlayer then DoFling(SelectedPlayer) end
    end)
end
local function StopFling()
    FlingEnabled = false
    if FlingConnection then FlingConnection:Disconnect(); FlingConnection = nil end
end

